            </div>

            <div class="menu-category">EXECU&Ccedil;&Atilde;O &Aacute;GIL &amp; RITUAIS</div>
            <div class="nav-item" data-tab="mesa_trabalho" onclick="switchTab('mesa_trabalho')">
                <div class="nav-item-left">&#128421;&#65039; <span>Mesa de Trabalho</span></div>
                <span class="nav-badge" style="background:#00a859; color:white;">Demandas</span>
            </div>
            <div class="nav-item" data-tab="gestao_agil" onclick="switchTab('gestao_agil')">
