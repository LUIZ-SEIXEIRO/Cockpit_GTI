, "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "", "fim": "", "pai": "", "backlog": "", "cat": "", "custo": "0.0", "desc": ""}, {"id": "1223", "projeto": "PDTIC-2027-2030", "macro": "spaguas-sa-gti", "assunto": "KPI-001 - Sistemas críticos com política de backup definida", "tipo": "KPI", "status": "💡 Novo", "prio": "Normal", "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "", "fim": "", "pai": "Projeto #1220: Indicadores", "backlog": "", "cat": "", "custo": "0.0", "desc": "Mede o percentual de sistemas críticos que possuem política formal de backup, retenção e restauração definida."}, {"id": "1224", "projeto": "PDTIC-2027-2030", "macro": "spaguas-sa-gti", "assunto": "KPI-002 - Sistemas críticos com backup automatizado", "tipo": "KPI", "status": "💡 Novo", "prio": "Normal", "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "", "fim": "", "pai": "Projeto #1220: Indicadores", "backlog": "", "cat": "", "custo": "0.0", "desc": "Mede o percentual de sistemas críticos contemplados por rotinas automatizadas de backup."}, {"id": "1225", "projeto": "PDTIC-2027-2030", "macro": "spaguas-sa-gti", "assunto": "KPI-003 - Taxa de sucesso dos testes de restauração", "tipo": "KPI", "status": "💡 Novo", "prio": "Normal", "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "", "fim": "", "pai": "Projeto #1220: Indicadores", "backlog": "", "cat": "", "custo": "0.0", "desc": "Mede o percentual de testes de restauração concluídos com sucesso em relação ao total de testes realizados."}, {"id": "1226", "projeto": "PDTIC-2027-2030", "macro": "spaguas-sa-gti", "assunto": "KPI-004 - Tempo médio de restauração por criticidade", "tipo": "KPI", "status": "💡 Novo", "prio": "Normal", "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "", "fim": "", "pai": "Projeto #1220: Indicadores", "backlog": "", "cat": "", "custo": "0.0", "desc": "Mede o tempo médio necessário para restaurar sistemas conforme sua classificação de criticidade."}, {"id": "1227", "projeto": "PDTIC-2027-2030", "macro": "spaguas-sa-gti", "assunto": "KPI-005 - Serviços essenciais cobertos por Plano de Continuidade de TIC", "tipo": "KPI", "status": "💡 Novo", "prio": "Normal", "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "", "fim": "", "pai": "Projeto #1220: Indicadores", "backlog": "", "cat": "", "custo": "0.0", "desc": "Mede o percentual de serviços essenciais contemplados por plano formal de continuidade."}, {"id": "1228", "projeto": "PDTIC-2027-2030", "macro": "spaguas-sa-gti", "assunto": "KPI-006 - Planos de continuidade testados", "tipo": "KPI", "status": "💡 Novo", "prio": "Normal", "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "", "fim": "", "pai": "Projeto #1220: Indicadores", "backlog": "", "cat": "", "custo": "0.0", "desc": "Mede o percentual de planos de continuidade submetidos a testes no período de acompanhamento."}, {"id": "1229", "projeto": "PDTIC-2027-2030", "macro": "spaguas-sa-gti", "assunto": "KPI-007 - Tempo de retomada em simulações", "tipo": "KPI", "status": "💡 Novo", "prio": "Normal", "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "", "fim": "", "pai": "Projeto #1220: Indicadores", "backlog": "", "cat": "", "custo": "0.0", "desc": "Mede o tempo necessário para retomada de serviços em exercícios simulados de continuidade."}, {"id": "1230", "projeto": "PDTIC-2027-2030", "macro": "spaguas-sa-gti", "assunto": "KPI-008 - Lacunas críticas identificadas nos testes", "tipo": "KPI", "status": "💡 Novo", "prio": "Normal", "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "", "fim": "", "pai": "Projeto #1220: Indicadores", "backlog": "", "cat": "", "custo": "0.0", "desc": "Mede a quantidade de lacunas críticas identificadas durante testes ou simulações de continuidade."}, {"id": "1231", "projeto": "SA-GTI - Gerência de TI", "macro": "spaguas-sa-gti", "assunto": "Track 1 (Operação Atual)", "tipo": "Projeto", "status": "🚀 Em progresso", "prio": "Normal", "atrib": "Luiz Antonio", "autor": "Luiz Antonio", "encarr": "Luiz Antonio", "ini": "24/06/2026", "fim": "24/08/2026", "pai": "Projeto #397: Otimização e Desmembramento de Contratos", "backlog": "A-018. Portfólio: Otimização de Contratos e Custos", "cat": "Gestão de Contratos e Aquisições", "custo": "0.0", "desc": "Frente voltada para a gestão da operação atual, englobando a sustentação técnica e a administração dos contratos vigentes da SP Águas. O foco primordial é garantir zero impacto na sustentabilidade diária da agência enquanto a modernização ocorre em paralelo.\n\n**Funcionalidade Principal:** Registro de tarefas operacionais, controle de esforço e monitoramento de custos locais dos contratos em andamento."}, {"id": "1232", "projeto": "SA-GTI - Gerência de TI", "macro": "spaguas-sa-gti", "assunto": "Track 2: Renegociação e Readequação", "tipo": "Projeto", "status": "🚀 Em progresso", "prio": "Alta", "atrib": "Luiz Antonio", "autor": "Luiz Antonio", "encarr": "Luiz Antonio", "ini": "24/06/2026", "fim": "24/06/2026", "pai": "Projeto #397: Otimização e Desmembramento de Contratos", "backlog": "A-018. Portfólio: Otimização de Contratos e Custos", "cat": "Gestão de Contratos e Aquisições", "custo": "342.0", "desc": "Sandbox exclusivo para a elaboração técnica, jurídica e estratégica das novas contratações da SP Águas. Centraliza a criação de Termos de Referência (TR), Documentos Formalizadores de Demanda (DFD), definição de catálogos de serviços (UST) e modelagem de aditamentos baseados em Ponto de Função (PF).\n\n**Funcionalidade Principal:** Coordenação de iniciativas de transformação, identificação de dependências cruzadas e mitigação de riscos integrados na mudança de modelo contratual."}, {"id": "1233", "projeto": "SA-GTI - Gerência de TI", "macro": "spaguas-sa-gti", "assunto": "Configuração Estrutural e Parametrização de Métricas", "tipo": "Tarefas", "status": "🚀 Em progresso", "prio": "Alta", "atrib": "Luiz Antonio", "autor": "Luiz Antonio", "encarr": "Diego", "ini": "24/