window.OP_PACOTES_OFICIAIS = [{"id": "42", "projeto": "SA-GTI - Gerência de TI", "macro": "spaguas-sa-gti", "assunto": "Renovação do Parque de Informática", "tipo": "Projeto", "status": "🚀 Em progresso", "prio": "Altíssima", "atrib": "SA-GTI - Gerência de TI", "autor": "Diego", "encarr": "Diego", "ini": "10/06/2025", "fim": "25/03/2027", "pai": "", "backlog": "A-017. Portfólio: Modernização de Sistemas e Infraestrutura", "cat": "Gestão de Contratos e Aquisições", "custo": "2000000.0", "desc": "Grupo de Tarefas necessárias para a Renovação do Parque de Informática da SP Águas"}, {"id": "60", "projeto": "SA-GTI - Gerência de TI", "macro": "spaguas-sa-gti", "assunto": "Plano Diretor de Tecnologia da Informação (PDTIC)", "tipo": "Projeto", "status": "🚀 Em progresso", "prio": "Altíssima", "atrib": "SA-GTI - Gerência de TI", "autor": "Diego", "encarr": "SA-GTI - Gerência de TI", "ini": "01/07/2025", "fim": "02/03/2026", "pai": "", "backlog": "A-016. Portfólio: Governança, PDTIC e Inovação", "cat": "", "custo": "0.0", "desc": ""}, {"id": "62", "projeto": "SA-GLCC - Gerência de Licitações, Contratos e Convênios", "macro": "spaguas-sa", "assunto": "Elaboração do Manual de Compras", "tipo": "Projeto", "status": "💡 Novo", "prio": "Normal", "atrib": "Paula", "autor": "Diego", "encarr": "Paula", "ini": "", "fim": "31/03/2026", "pai": "", "backlog": "", "cat": "", "custo": "0.0", "desc": ""}, {"id": "63", "projeto": "SA-GLCC - Gerência de Licitações, Contratos e Convênios", "macro": "spaguas-sa", "assunto": "Capacitação de Licitações, Contratos e Convênios", "tipo": "Projeto", "status": "💡 Novo", "prio": "Normal", "atrib": "Paula", "autor": "Diego", "encarr": "Paula", "ini": "", "fim": "", "pai": "", "backlog": "", "cat": "", "custo": "0.0", "desc": ""}, {"id": "64", "projeto": "SA-GRH - Gerência de Recursos Humanos", "macro": "spaguas-sa", "assunto": "Realizar Concurso Público", "tipo": "Projeto", "status": "🚀 Em progresso", "prio": "Alta", "atrib": "SA-GRH - Gerência de Recursos Humanos", "autor": "Diego", "encarr": "Edson", "ini": "01/08/2025", "fim": "02/09/2026", "pai": "", "backlog": "", "cat": "", "custo": "0.0", "desc": "Em razão da Lei Complementar 1413 de 23/09/2024 que dispõe sobre o regime jurídico das agências reguladoras estaduais, transforma o Departamento de Águas e Energia Elétrica - DAEE em Agência de Águas do Estado de São Paulo - SP-ÁGUAS, e dá providências correlatas.as atribuições das agências reguladoras,\n\nCitação, em especial, ao artigo 7º, § 2°, item &quot;a&quot; que prevê a realização de concursos públicos e o provimento de cargos e empregos públicos de qualquer natureza, exceto os de Diretor-Presidente, Diretor, Superintendente de Área, Ouvidor e Corregedor; Seção III - artigo 79."}, {"id": "65", "projeto": "SA-GRH - Gerência de Recursos Humanos", "macro": "spaguas-sa", "assunto": "Plano de Capacitação", "tipo": "Projeto", "status": "🚀 Em progresso", "prio": "Normal", "atrib": "SA-GRH - Gerência de Recursos Humanos", "autor": "Diego", "encarr": "Edson", "ini": "01/06/2025", "fim": "30/10/2026", "pai": "", "backlog": "", "cat": "", "custo": "0.0", "desc": "**Compete à Divisão de Administrativa e de Capacitação:**\n\nIII - propor e executar programas de treinamento e desenvolvimento, alinhando-os às necessidades operacionais e estratégicas de cada área da agência; IV - colaborar com a Escola das Águas, na execução das capacitações técnicas, voltadas ao desenvolvimento do público interno;&nbsp;\n\nV - executar a implementação de ações voltadas para a gestão de saúde ocupacional, visando o bem-estar físico e mental dos servidores;\n\nVI - propor e apoiar no desenvolvimento de planos de carreira para servidores, através da atualização e análise de perfis profissiográficos, identificando possíveis direcionamentos para novos cargos ou funções dentro da agência;\n\nVII - propor e implementar estratégias de aprendizado profissional contínuo, como a criação e manutenção de uma plataforma interna para cursos, workshops e materiais de desenvolvimento, bem como contratações e parcerias para atingir tais finalidades; e VIII - elaborar e manter atualizado os registros, relatórios e sistemas, utilizando de todos os recursos necessários para a execução dos serviços\n\n_Regimento Interno V2025_"}, {"id": "66", "projeto": "SA-GRH - Gerência de Recursos Humanos", "macro": "spaguas-sa", "assunto": "Contratação de Plano de Saúde | Convênio Médico", "tipo": "Projeto", "status": "🚀 Em progresso", "prio": "Alta", "atrib": "SA-GRH - Gerência de Recursos Humanos", "autor": "Diego", "encarr": "Adriana", "ini": "03/08/2026", "fim": "30/12/2026", "pai": "", "backlog": "", "cat": "", "custo": "0.0", "desc": "Objetivo: contratar benefício de Plano de Saúde | Convênio Médico para servidores da Agência"}, {"id": "68", "projeto": "SA-GRH - Gerência de Recursos Humanos", "macro": "spaguas-sa", "assunto": "Contratação de estagiários", "tipo": "Projeto", "status": "🚀 Em progresso", "prio": "Normal", "atrib": "Adriana", "autor": "Diego", "encarr": "Edson", "ini": "17/06/2025", "fim": "31/03/2026", "pai": "", "backlog": "", "cat": "", "custo": "0.0", "desc": ""}, {"id": "69", "projeto": "Divisão Documental", "macro": "spaguas-sa", "assunto": "Gestão Documental", "tipo": "Projeto", "status": "🚀 Em progresso", "prio": "Normal", "atrib": "Angela", "autor": "Diego", "encarr": "Angela", "ini": "02/03/2015", "fim": "17/03/2028", "pai": "", "backlog": "", "cat": "", "custo": "0.0", "desc": ""}, {"id": "70", "projeto": "Divisão Documental", "macro": "spaguas-sa", "assunto": "Implementar Despapelização", "tipo": "Tarefas", "status": "🚀 Em progresso", "prio": "Normal", "atrib": "Diego", "autor": "Diego", "encarr": "Diego", "ini": "02/03/2015", "fim": "17/03/2028", "pai": "Projeto #69: Gestão Documental", "backlog": "", "cat": "", "custo": "0.0", "desc": ""}, {"id": "71", "projeto": "Divisão de Serviços Administrativos", "macro": "spaguas-sa", "assunto": "Gestão de Frota", "tipo": "Projeto", "status": "🚀 Em progresso", "p