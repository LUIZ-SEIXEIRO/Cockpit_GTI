// =========================================================================
// CORE 01: SAFE STORAGE, ESCAPE HTML, FORMATAÇÃO E UTILITÁRIOS DE TABELA/CSV
// =========================================================================
(function() {
    try {
        var _t = window.localStorage.getItem('_sagti_test');
    } catch (e) {
        var _mem = {};
        var _mockStorage = {
            getItem: function(k) { return Object.prototype.hasOwnProperty.call(_mem, k) ? _mem[k] : null; },
            setItem: function(k, v) { _mem[k] = String(v); },
            removeItem: function(k) { delete _mem[k]; },
            clear: function() { _mem = {}; }
        };
        try {
            Object.defineProperty(window, 'localStorage', {
                value: _mockStorage,
                configurable: true,
                writable: true
            });
        } catch (e2) {}
    }

    try {
        var m = JSON.parse(localStorage.getItem('motores_varredura') || 'null');
        var v = localStorage.getItem('sagti_motores_versao');
        var m1 = (m && Array.isArray(m)) ? m.find(function(x) { return x.id === 'mot-1'; }) : null;
        if (!m || v !== 'v10.0_modular' || (m1 && m1.endpoint !== 'https://www.doe.sp.gov.br')) {
            localStorage.removeItem('motores_varredura');
            localStorage.setItem('sagti_motores_versao', 'v10.0_modular');
        }
    } catch (e) {}
})();

window.escapeHtml = function(s) {
    if (s === null || s === undefined) return '';
    return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
};

window.decodeUnicodeEscapes = function(str) {
    if (!str) return '';
    return String(str).replace(/\\u([0-9a-fA-F]{4})/g, function(_, hex) {
        return String.fromCharCode(parseInt(hex, 16));
    });
};

window.normalizarTexto = function(s) {
    if (!s) return '';
    return String(s).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
};

function formatarDataBR(dStr) {
    if (!dStr) return '';
    var p = String(dStr).split('-');
    if (p.length === 3) return p[2] + '/' + p[1] + '/' + p[0];
    return dStr;
}
window.formatarDataBR = formatarDataBR;

function gerarDownloadCSV(lista, nomeArquivo) {
    if (!lista || !lista.length) return alert('Nenhum dado para exportar.');
    var colunas = Object.keys(lista[0]);
    var q = String.fromCharCode(34);
    var csv = colunas.join(';') + '\r\n';
    lista.forEach(function(item) {
        csv += colunas.map(function(c) {
            return q + String(item[c] || '').split(q).join(q + q) + q;
        }).join(';') + '\r\n';
    });
    var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
    var link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = nomeArquivo;
    link.click();
}
window.gerarDownloadCSV = gerarDownloadCSV;

window.exportarTabelaAtivaCsvV9 = function(tbodyId, nomeArquivo) {
    var tbody = document.getElementById(tbodyId);
    if (!tbody) return;
    var table = tbody.closest('table');
    var rows = table ? table.querySelectorAll('tr') : tbody.querySelectorAll('tr');
    var q = String.fromCharCode(34);
    var csvLinhas = [];
    rows.forEach(function(r) {
        var cols = Array.prototype.slice.call(r.querySelectorAll('th, td')).map(function(c) {
            var txt = (c.innerText || '').replace(/\r?\n|\r/g, ' ').split(q).join(q + q).trim();
            return q + txt + q;
        });
        if (cols.length > 0) csvLinhas.push(cols.join(';'));
    });
    var blob = new Blob(['\uFEFF' + csvLinhas.join('\n')], { type: 'text/csv;charset=utf-8;' });
    var link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = (nomeArquivo || 'exportacao_spaguas') + '.csv';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
};

window.habilitarClickToSortTabelasV9 = function() {
    document.querySelectorAll('table thead th').forEach(function(th) {
        if (th.classList.contains('th-sortable-v9')) return;
        th.classList.add('th-sortable-v9');
        th.setAttribute('title', 'Clique para ordenar por esta coluna (▲/▼)');
        th.addEventListener('click', function() {
            var table = th.closest('table');
            var tbody = table ? table.querySelector('tbody') : null;
            if (!tbody) return;
            var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
            if (rows.length <= 1) return;
            var asc = th.getAttribute('data-sort-dir') !== 'asc';
            th.setAttribute('data-sort-dir', asc ? 'asc' : 'desc');
            var idxReal = Array.prototype.indexOf.call(th.parentNode.children, th);
            rows.sort(function(ra, rb) {
                var ca = (ra.children[idxReal] ? ra.children[idxReal].innerText : '').trim();
                var cb = (rb.children[idxReal] ? rb.children[idxReal].innerText : '').trim();
                var na = parseFloat(ca.replace(/[^0-9.-]+/g, ''));
                var nb = parseFloat(cb.replace(/[^0-9.-]+/g, ''));
                if (!isNaN(na) && !isNaN(nb) && ca.length < 15 && cb.length < 15) {
                    return asc ? (na - nb) : (nb - na);
                }
                return asc ? ca.localeCompare(cb, 'pt-BR') : cb.localeCompare(ca, 'pt-BR');
            });
            rows.forEach(function(r) { tbody.appendChild(r); });
        });
    });
};


