    try { if (window.renderizarKanbanAgil) window.renderizarKanbanAgil(); } catch (e) {}
    try { if (window.aplicarFiltrosConsulta) window.aplicarFiltrosConsulta(); } catch (e) {}
    try { if (window.renderizarMeusProcessosMesa) window.renderizarMeusProcessosMesa(); } catch (e) {}
    try { if (window.renderizarSecaoFixadosEAlertasMesa) window.renderizarSecaoFixadosEAlertasMesa(); } catch (e) {}
    try { if (window.atualizarFixadosBadge) window.atualizarFixadosBadge(); } catch (e) {}
    try { if (window.renderizarListaFixadosConfig) window.renderizarListaFixadosConfig(); } catch (e) {}
    try { if (window.carregarConfigGovernanca) window.carregarConfigGovernanca(); } catch (e) {}
    try { if (window.carregarFlagsConectores) window.carregarFlagsConectores(); } catch (e) {}
    try { if (window.renderizarMuralPostits) window.renderizarMuralPostits(); } catch (e) {}
    try { if (window.inicializarSprintTimer) window.inicializarSprintTimer(); } catch (e) {}
    try { if (window.renderizarPautaDaily) window.renderizarPautaDaily(); } catch (e) {}
    try { if (window.filtrarListaParaPautar) window.filtrarListaParaPautar(); } catch (e) {}
    try { if (window.carregarCadernos) window.carregarCadernos(); } catch (e) {}
    try { if (window.inicializarFiltrosPortfolioOP) window.inicializarFiltrosPortfolioOP(); } catch (e) {}
    try { if (window.filtrarPortfolioOpenProject) window.filtrarPortfolioOpenProject(); } catch (e) {}
    try { if (window.filtrarPilarSagti) window.filtrarPilarSagti('todos'); } catch (e) {}
    try { if (window.filtrarEixoPdtic) window.filtrarEixoPdtic(''); } catch (e) {}
    try { if (window.construirBaseUnificadaGlpi) window.construirBaseUnificadaGlpi(); } catch (e) {}
    try { if (window.filtrarTabelaGlpi) window.filtrarTabelaGlpi(); } catch (e) {}
    try { if (window.carregarPoolTresIas) window.carregarPoolTresIas(); } catch (e) {}
    try { if (window.carregarMotoresVarredura) window.carregarMotoresVarredura(); } catch (e) {}
    try { if (window.carregarHistoricoSnapshots) window.carregarHistoricoSnapshots(); } catch (e) {}
    try { if (window.inicializarMotor1DoeSpV98) window.inicializarMotor1DoeSpV98(); } catch (e) {}
    try { if (window.injetarOmniboxTopbarV9) window.injetarOmniboxTopbarV9(); } catch (e) {}
    try { if (window.habilitarClickToSortTabelasV9) window.habilitarClickToSortTabelasV9(); } catch (e) {}

    var hashTab = (window.location.hash || '').replace(/^#/, '').trim();
    if (hashTab && document.getElementById('view-' + hashTab)) {
        window.switchTab(hashTab);
    }
});


// >>> MÓDULO: src/js/core/03_roteador_abas.js <<<
// =========================================================================
// CORE 03: ROTEADOR UNIFICADO DE 15 ABAS, DRILL-DOWN 360° & OMNIBOX (CTRL+K)
// =========================================================================
window.currentTab = 'dashboards';

window.switchTab = function(tabId) {
    if (!tabId) tabId = 'dashboards';

    if (tabId === 'radar_gargalos') {
        return window.switchTab('visao_estrategica');
    }

    if (['consolidado', 'esteira_contratacao', 'rotina_operacional', 'portfolio_estrategico'].includes(tabId)) {
        var mapa = {
            'consolidado': 'consolidado',
            'esteira_contratacao': 'esteira',
            'rotina_operacional': 'rotina',
            'portfolio_estrategico': 'portfolio'
        };
        window.switchTab('dashboards');
        if (typeof window.alternarModoDashboard === 'function') {
            window.alternarModoDashboard(mapa[tabId]);
        }
        return;
    }

    if (typeof window.abaPermitidaNoPerfil === 'function' && !window.abaPermitidaNoPerfil(tabId)) {
        var permitidas = window.permissoesAtivas || ['dashboards'];
        tabId = permitidas[0] || 'dashboards';
    }

    window.currentTab = tabId;
    window.abaAtivaAtualV9 = tabId;

    document.querySelectorAll('.tab-view').forEach(function(el) {
        if (el.id === 'view-' + tabId) {
            el.classList.add('active');
            el.style.display = 'block';
        } else {
            el.classList.remove('active');
            el.style.display = 'none';
        }
    });

    document.querySelectorAll('#sidebar .nav-item').forEach(function(el) {
        if (el.getAttribute('data-tab') === tabId) {
            el.classList.add('active');
        } else {
            el.classList.remove('active');
        }
    });

    var titulos = {
        'dashboards': '📊 CENTRAL DE DASHBOARDS & INDICADORES DE TIC',
        'portfolio_openproject': '🏗️ PORTFÓLIO CORPORATIVO OPENPROJECT (500 PACOTES / 29 PROJETOS)',
        'tracks_sagti': '⚡ SA-GTI: TRACKS CONTRATUAIS (A-018) & PROJETOS (97)',
        'pdtic_eixos': '🧭 GOVERNANÇA DO PDTIC 2027–2030 (35 INICIATIVAS & 8 KPIs)',
        'gestao_glpi': '🎫 GESTÃO GLPI 10 & HELPDESK ITSM (PRODUÇÃO SP-ÁGUAS)',
        'visao_estrategica': '🎯 VISÃO ESTRATÉGICA & FARÓIS DE CRITICIDADE',
        'mesa_trabalho': '🖥️ MESA DE TRABALHO OPERACIONAL (COCKPIT SA-GTI)',
        'gestao_agil': '📋 GESTÃO ÁGIL & SPRINT PLANNING (OPENPROJECT)',
        'daily_warroom': '⏱️ WAR ROOM: DAILY SCRUM & GESTÃO DE PAUTA',
        'consulta': '📂 ACERVO PROBATÓRIO SEI (179 PROCESSOS)',
        'fixados': '⭐ PROCESSOS FIXADOS (WATCHLIST PRIORITÁRIA)',
        'auditoria': '🛡️ AUDITORIA CONTÍNUA TCE-SP & CONFORMIDADE IMR',
        'esteira_ia': '🤖 ASSISTENTE PESSOAL IA & MOTOR 4 CAMADAS (NEW API :3001)',
        'cadernos': '📚 CADERNOS TEMÁTICOS, TOOLKITS & MODELOS OFICIAIS A4',
        'configuracoes': '🔧 CENTRAL DE CONFIGURAÇÕES, 8 MOTORES, RBAC & BACKUP DRP'
    };

    var pageTitleEl = document.getElementById('page-title');
    if (pageTitleEl) pageTitleEl.innerText = titulos[tabId] || 'DASHBOARD SA-GTI';

    var contentScroll = document.querySelector('.content-scroll');
    if (contentScroll) contentScroll.scrollTop = 0;

    try {
        localStorage.setItem('sagti_ultima_aba_v9', tabId);
        if (history.replaceState) history.replaceState(null, '', '#' + tabId);
    } catch (e) {}

    try {
        if (tabId === 'dashboards' && typeof window.alternarModoDashboard === 'function') {
            window.alternarModoDashboard(window.modoDashboardAtivo || 'consolidado');
        } else if (tabId === 'portfolio_openproject') {
            if (window.inicializarFiltrosPortfolioOP) window.inicializarFiltrosPortfolioOP();
            if (window.filtrarPortfolioOpenProject) window.filtrarPortfolioOpenProject();
        } else if (tabId === 'tracks_sagti' && window.filtrarPilarSagti) {
            window.filtrarPilarSagti(window.pilarSagtiAtivo || 'todos');
        } else if (tabId === 'pdtic_eixos' && window.filtrarEixoPdtic) {
            window.filtrarEixoPdtic(window.eixoPdticAtivo || '');
        } else if (tabId === 'gestao_glpi') {
            if (window.carregarChamadosGlpiReal) window.carregarChamadosGlpiReal();
            if (window.filtrarTabelaGlpi) window.filtrarTabelaGlpi();
        } else if (tabId === 'visao_estrategica') {
            if (!window.graficosEstrategicosCriados && window.criarBarraHorizontal && window.criarBarraEmpilhada) {
                window.criarBarraHorizontal('chart-radar-resp', ['Marcos Tadeu Yamamoto', 'Diego Monteiro', 'Rafael Frossard Piteri'], [18, 15, 3]);
                window.criarBarraEmpilhada('chart-radar-stacked');
                window.graficosEstrategicosCriados = true;
            }
            if (window.renderizarTabelaEstrategica) window.renderizarTabelaEstrategica();
            setTimeout(function() { window.dispatchEvent(new Event('resize')); }, 60);
        } else if (tabId === 'mesa_trabalho') {
            if (window.renderizarMeusProcessosMesa) window.renderizarMeusProcessosMesa();
            if (window.renderizarSecaoFixadosEAlertasMesa) window.renderizarSecaoFixadosEAlertasMesa();
        } else if (tabId === 'fixados' && typeof renderizarFixados === 'function') {
            renderizarFixados();
        } else if (tabId === 'gestao_agil' && typeof renderizarKanbanAgil === 'function') {
            renderizarKanbanAgil();
        } else if (tabId === 'daily_warroom') {
            if (typeof renderizarMuralPostits === 'function') renderizarMuralPostits();
            if (typeof renderizarPautaDaily === 'function') renderizarPautaDaily();
        } else if (tabId === 'configuracoes') {
            if (typeof renderizarListaFixadosConfig === 'function') renderizarListaFixadosConfig();
            if (window.renderizarMatrizRBAC) window.renderizarMatrizRBAC();
            if (window.injetarCardBuscadorMotor1) window.injetarCardBuscadorMotor1();
            if (window.renderizarTabelaMotores) window.renderizarTabelaMotores();
        }
    } catch (e) {
        console.warn('Aviso ao renderizar aba ' + tabId + ':', e);
    }
};
function switchTab(tabId) { window.switchTab(tabId); }

window.navegarDrillDown360 = function(tipo, valor) {
    if (!valor) return;
    var valStr = String(valor).trim();
    if (tipo === 'sei' && /^\d{3}\./.test(valStr)) {
        if (typeof window.abrirDetalhesProcesso === 'function') {
            window.abrirDetalhesProcesso(valStr);
            return;
        }
    }
    if (tipo === 'op' || tipo === 'pai') {
        var idLimpo = valStr.replace(/^#/, '');
        window.switchTab('portfolio_openproject');
        setTimeout(function() {
            var inp = document.getElementById('op-filtro-busca');
            if (inp) {
                inp.value = idLimpo;
                if (typeof window.filtrarPortfolioOpenProject === 'function') window.filtrarPortfolioOpenProject();
            }
        }, 80);
        return;
    }
    if (tipo === 'glpi') {
        var tLimpo = valStr.replace(/^#/, '');
        window.switchTab('gestao_glpi');
        setTimeout(function() {
            var inp = document.getElementById('glpi-filtro-busca');
            if (inp) {
                inp.value = tLimpo;
                if (typeof window.filtrarTabelaGlpi === 'function') window.filtrarTabelaGlpi();
            }
        }, 80);
        return;
    }
};

window.injetarOmniboxTopbarV9 = function() {
    var topbar = document.getElementById('topbar');
    if (!topbar || document.getElementById('omnibox-global-v9')) return;

    var wrap = document.createElement('div');
    wrap.id = 'omnibox-global-v9';
    wrap.style = 'position:relative;display:flex;align-items:center;margin:0 12px;';
    wrap.innerHTML = '<input id="input-omnibox-v9" type="text" placeholder="🔍 Busca Global 360° (Ctrl+K): #ID, SEI, GLPI..." ' +
        'style="width:260px;padding:6px 12px;border-radius:18px;border:1px solid #cbd5e1;font-size:12px;background:#f8fafc;color:#0f172a;outline:none;" ' +
        'oninput="window.executarBuscaOmniboxV9(this.value)" onfocus="window.executarBuscaOmniboxV9(this.value)" />' +
        '<div id="dropdown-omnibox-v9" style="display:none;position:absolute;top:36px;left:0;width:440px;max-height:380px;overflow-y:auto;background:#ffffff;border:1px solid #cbd5e1;border-radius:10px;box-shadow:0 12px 28px rgba(0,0,0,0.18);z-index:99999;padding:8px;"></div>';

    var rightBox = topbar.querySelector('.topbar-actions') || topbar.lastElementChild;
    if (rightBox) topbar.insertBefore(wrap, rightBox);
    else topbar.appendChild(wrap);

    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            var inp = document.getElementById('input-omnibox-v9');
            if (inp) inp.focus();
        } else if (e.key === 'Escape') {
            var dd = document.getElementById('dropdown-omnibox-v9');
            if (dd) dd.style.display = 'none';
        }
    });

    document.addEventListener('click', function(e) {
        if (!wrap.contains(e.target)) {
            var dd = document.getElementById('dropdown-omnibox-v9');
            if (dd) dd.style.display = 'none';
        }
    });
};

window.executarBuscaOmniboxV9 = function(termo) {
    var dd = document.getElementById('dropdown-omnibox-v9');
    if (!dd) return;
    var q = (termo || '').trim();
    if (q.length < 2 || typeof window.coletarContextoTotalSistemas !== 'function') {
        dd.style.display = 'none';
        return;
    }
    var ctx = window.coletarContextoTotalSistemas(q);
    var itensHtml = [];

    (ctx.matchesOP || []).slice(0, 4).forEach(function(p) {
        itensHtml.push('<div onclick="window.navegarDrillDown360(\'op\', \'#' + p.id + '\');document.getElementById(\'dropdown-omnibox-v9\').style.display=\'none\';" style="padding:7px 10px;border-bottom:1px solid #f1f5f9;cursor:pointer;font-size:11.5px;">' +
            '<span style="background:#0f2d59;color:#fff;padding:1px 6px;border-radius:4px;font-size:10px;font-weight:700;margin-right:6px;">OP #' + window.escapeHtml(p.id) + '</span>' +
            '<strong>' + window.escapeHtml(p.assunto) + '</strong> <span style="color:#64748b;">(' + window.escapeHtml(p.projeto) + ')</span></div>');
    });
    (ctx.matchesGLPI || []).slice(0, 4).forEach(function(t) {
        itensHtml.push('<div onclick="window.navegarDrillDown360(\'glpi\', \'#' + t.id + '\');document.getElementById(\'dropdown-omnibox-v9\').style.display=\'none\';" style="padding:7px 10px;border-bottom:1px solid #f1f5f9;cursor:pointer;font-size:11.5px;">' +
            '<span style="background:#0284c7;color:#fff;padding:1px 6px;border-radius:4px;font-size:10px;font-weight:700;margin-right:6px;">GLPI #' + t.id + '</span>' +
            '<strong>' + window.escapeHtml(t.titulo) + '</strong> <span style="color:#64748b;">(' + window.escapeHtml(t.fila) + ')</span></div>');
    });
    (ctx.matchesSEI || []).slice(0, 4).forEach(function(s) {
        var idS = s.id || s.ID_Processo || '';
        itensHtml.push('<div onclick="window.navegarDrillDown360(\'sei\', \'' + window.escapeHtml(idS) + '\');document.getElementById(\'dropdown-omnibox-v9\').style.display=\'none\';" style="padding:7px 10px;border-bottom:1px solid #f1f5f9;cursor:pointer;font-size:11.5px;">' +
            '<span style="background:#047857;color:#fff;padding:1px 6px;border-radius:4px;font-size:10px;font-weight:700;margin-right:6px;">SEI ' + window.escapeHtml(idS) + '</span>' +
            '<strong>' + window.escapeHtml((s.especificacao || s.Especificacao || '').slice(0, 68)) + '</strong></div>');
    });

    if (itensHtml.length === 0) {
        itensHtml.push('<div style="padding:10px;font-size:12px;color:#64748b;">Nenhum registro exato nos 882 itens para "' + window.escapeHtml(q) + '".</div>');
    }
    dd.innerHTML = itensHtml.join('');
    dd.style.display = 'block';
};


// >>> MÓDULO: src/js/core/04_rbac_perfis.js <<<
// =========================================================================
// CORE 04: CONTROLE DE ACESSO POR PERFIL (RBAC UNIFICADO PARA AS 15 ABAS)
// =========================================================================
window.ABAS_SISTEMA = [
    { id: 'dashboards', nome: '📊 Central de Dashboards', desc: 'Consolidado 360°, Esteira, Rotina e Portfólio' },
    { id: 'portfolio_openproject', nome: '🏗️ Portfólio OpenProject (500)', desc: '29 Projetos e 500 Pacotes Oficiais' },
    { id: 'tracks_sagti', nome: '⚡ SA-GTI: Tracks & Projetos', desc: 'Track 1 & Track 2, Sistemas DGD e Infra DIF' },
    { id: 'pdtic_eixos', nome: '🧭 PDTIC 2027-2030 & KPIs', desc: '5 Eixos, 35 Iniciativas e 8 KPIs Oficiais' },
    { id: 'gestao_glpi', nome: '🎫 Gestão GLPI & Helpdesk (203)', desc: 'Espelho do Dashboard GLPI 10, Filas ITSM e Formcreator' },
    { id: 'visao_estrategica', nome: '🎯 Visão Estratégica & Faróis', desc: 'Faróis, suspensões externas e matriz de gargalos' },
    { id: 'mesa_trabalho', nome: '🖥️ Mesa de Trabalho', desc: 'Cockpit pessoal do usuário com demandas do SEI' },
    { id: 'gestao_agil', nome: '📋 Gestão Ágil & Sprints', desc: 'Quadro Kanban, backlog e sprints operacionais' },
    { id: 'daily_warroom', nome: '⏱️ War Room: Daily & Rituais', desc: 'Rituais de timebox, post-its e pauta daily' },
    { id: 'consulta', nome: '📂 Acervo Probatório SEI', desc: 'Busca multicritério em 179 processos reais' },
    { id: 'fixados', nome: '⭐ Processos Fixados', desc: 'Watchlist personalizada de processos prioritários' },
    { id: 'auditoria', nome: '🛡️ Auditoria TCE-SP & IMR', desc: 'Maturidade de governança e Súmula 269 TCU' },
    { id: 'esteira_ia', nome: '🤖 Chat IA & RACI', desc: 'Assistente Pessoal IA e Pool de 3 IAs Isoladas' },
    { id: 'cadernos', nome: '📚 Cadernos & Regimento', desc: '15 Cadernos Temáticos, 6 Modelos A4 e 8 Toolkits' },
    { id: 'configuracoes', nome: '🔧 Configurações & Motores', desc: '8 Motores de Varredura, DOE-SP, RBAC e Backup DRP' }
];

window.PERFIS_SISTEMA = [
    { id: 'Super-Admin', nome: 'Super-Admin (Luiz / GTI)', badge: '👑' },
    { id: 'Gestor', nome: 'Gestor de TIC (SA-GTI)', badge: '👔' },
    { id: 'Analista', nome: 'Analista de TIC (DIF/DGD)', badge: '💻' },
    { id: 'Demandante', nome: 'Demandante (Bacias/Áreas)', badge: '🏛️' }
];

window.MATRIZ_PERMISSOES_PADRAO = {
    'Super-Admin': [
        'dashboards', 'portfolio_openproject', 'tracks_sagti', 'pdtic_eixos', 'gestao_glpi',
        'visao_estrategica', 'mesa_trabalho', 'gestao_agil', 'daily_warroom',
        'consulta', 'fixados', 'auditoria', 'esteira_ia', 'cadernos', 'configuracoes'
    ],
    'Gestor': [
        'dashboards', 'portfolio_openproject', 'tracks_sagti', 'pdtic_eixos', 'gestao_glpi',
        'visao_estrategica', 'mesa_trabalho', 'gestao_agil', 'daily_warroom',
        'consulta', 'fixados', 'auditoria', 'esteira_ia', 'cadernos'
    ],
    'Analista': [
        'dashboards', 'portfolio_openproject', 'tracks_sagti', 'gestao_glpi',
        'mesa_trabalho', 'gestao_agil', 'daily_warroom',
        'consulta', 'fixados', 'auditoria', 'esteira_ia', 'cadernos'
    ],
    'Demandante': [
        'dashboards', 'mesa_trabalho', 'consulta', 'gestao_glpi', 'cadernos'
    ]
};

window.perfilAtivo = 'Super-Admin';
window.matrizPermissoes = JSON.parse(JSON.stringify(window.MATRIZ_PERMISSOES_PADRAO));
window.permissoesAtivas = window.MATRIZ_PERMISSOES_PADRAO['Super-Admin'].slice();

window.obterPerfilAtivoV9 = function() {
    var sel = document.getElementById('select-perfil-ativo');
    return (sel && sel.value) ? sel.value : (window.perfilAtivo || 'Super-Admin');
};

window.abaPermitidaNoPerfil = function(tabId, perfil) {
    var pf = perfil || window.obterPerfilAtivoV9();
    if (pf === 'Super-Admin') return true;
    var matriz = window.matrizPermissoes || window.MATRIZ_PERMISSOES_PADRAO;
    var permitidas = matriz[pf] || window.MATRIZ_PERMISSOES_PADRAO['Super-Admin'];
    return permitidas.indexOf(tabId) !== -1;
};

window.carregarPermissoes = function() {
    var perfilSalvo = localStorage.getItem('sagti_perfil_ativo');
    if (perfilSalvo && ['Super-Admin', 'Gestor', 'Analista', 'Demandante'].includes(perfilSalvo)) {
        window.perfilAtivo = perfilSalvo;
    } else {
        window.perfilAtivo = 'Super-Admin';
    }

    var sel = document.getElementById('select-perfil-ativo');
    if (sel) sel.value = window.perfilAtivo;

    var matrizSalva = localStorage.getItem('sagti_matriz_permissoes_v10');
    if (matrizSalva) {
        try {
            window.matrizPermissoes = JSON.parse(matrizSalva);
        } catch (e) {
            window.matrizPermissoes = JSON.parse(JSON.stringify(window.MATRIZ_PERMISSOES_PADRAO));
        }
    } else {
        window.matrizPermissoes = JSON.parse(JSON.stringify(window.MATRIZ_PERMISSOES_PADRAO));
    }

    window.aplicarPermissoesPerfil(window.perfilAtivo);
    window.renderizarMatrizRBAC();
};

window.aplicarPermissoesPerfil = function(perfil) {
    var pf = perfil || 'Super-Admin';
    window.perfilAtivo = pf;
    localStorage.setItem('sagti_perfil_ativo', pf);

    var sel = document.getElementById('select-perfil-ativo');
    if (sel && sel.value !== pf) sel.value = pf;

    var perm = (window.matrizPermissoes && window.matrizPermissoes[pf]) || window.MATRIZ_PERMISSOES_PADRAO[pf] || [];
    if (pf === 'Super-Admin') {
        perm = window.ABAS_SISTEMA.map(function(a) { return a.id; });
    }
    window.permissoesAtivas = perm;

    document.querySelectorAll('#sidebar .nav-item[data-tab]').forEach(function(el) {
        var tabId = el.getAttribute('data-tab');
        el.style.display = perm.includes(tabId) ? 'flex' : 'none';
    });

    document.querySelectorAll('#sidebar .menu-category').forEach(function(cat) {
        var next = cat.nextElementSibling;
        var hasVisible = false;
        while (next && !next.classList.contains('menu-category')) {
            if (next.classList.contains('nav-item') && next.style.display !== 'none') {
                hasVisible = true;
                break;
            }
            next = next.nextElementSibling;
        }
        cat.style.display = hasVisible ? 'block' : 'none';
    });

    var isReadOnly = (pf === 'Demandante');
    document.querySelectorAll('button').forEach(function(btn) {
        var onclk = (btn.getAttribute('onclick') || '').toLowerCase();
        var isMutacao = onclk.indexOf('salvar') !== -1 || onclk.indexOf('excluir') !== -1 ||
                        onclk.indexOf('remover') !== -1 || onclk.indexOf('restaurar') !== -1;
        if (isMutacao) {
            if (isReadOnly) {
                btn.classList.add('rbac-readonly-disabled');
                btn.setAttribute('title', 'Modo Somente Leitura (Perfil Demandante)');
            } else {
                btn.classList.remove('rbac-readonly-disabled');
            }
        }
    });

    var tabAtual = window.currentTab || 'dashboards';
    if (!perm.includes(tabAtual) && perm.length > 0) {
        window.switchTab(perm[0]);
    }
};

window.trocarPerfilAtivo = function(novoPerfil) {
    window.aplicarPermissoesPerfil(novoPerfil);
    if (typeof window.renderizarMeusProcessosMesa === 'function') {
        window.renderizarMeusProcessosMesa();
    }
};

window.renderizarMatrizRBAC = function() {
    var tbody = document.getElementById('tabela-matriz-rbac-body');
    if (!tbody) return;

    tbody.innerHTML = window.ABAS_SISTEMA.map(function(aba) {
        var cols = window.PERFIS_SISTEMA.map(function(p) {
            var checked = (window.matrizPermissoes[p.id] && window.matrizPermissoes[p.id].includes(aba.id)) ? 'checked' : '';
            return '<td style="padding: 10px 14px; text-align: center; border: 1px solid #cbd5e1; background: ' + (checked ? '#f0fdf4' : '#ffffff') + ';">' +
                '<input type="checkbox" class="chk-rbac" data-perfil="' + p.id + '" data-aba="' + aba.id + '" ' + checked + ' style="width: 16px; height: 16px; cursor: pointer; accent-color: #0544cf;">' +
                '</td>';
        }).join('');
        return '<tr style="border-bottom: 1px solid #e2e8f0;">' +
            '<td style="padding: 10px 14px; border: 1px solid #cbd5e1;">' +
                '<strong style="color: #002d5a; font-size: 13px;">' + aba.nome + '</strong>' +
                '<div style="font-size: 11px; color: #64748b; margin-top: 2px;">' + aba.desc + '</div>' +
            '</td>' + cols + '</tr>';
    }).join('');
};

window.salvarMatrizPermissoes = function() {
    var novaMatriz = { 'Super-Admin': [], 'Gestor': [], 'Analista': [], 'Demandante': [] };
    document.querySelectorAll('.chk-rbac').forEach(function(chk) {
        var perfil = chk.getAttribute('data-perfil');
        var aba = chk.getAttribute('data-aba');
        if (chk.checked && novaMatriz[perfil]) {
            novaMatriz[perfil].push(aba);
        }
    });
    if (!novaMatriz['Super-Admin'].includes('configuracoes')) {
        novaMatriz['Super-Admin'].push('configuracoes');
    }
    window.matrizPermissoes = novaMatriz;
    localStorage.setItem('sagti_matriz_permissoes_v10', JSON.stringify(novaMatriz));
    window.aplicarPermissoesPerfil(window.perfilAtivo);
    window.renderizarMatrizRBAC();
    alert('✅ Matriz de permissões RBAC salva com sucesso!');
};

window.restaurarPermissoesPadrao = function() {
    if (!confirm('Deseja restaurar as permissões de acesso aos padrões institucionais da SP-Águas?')) return;
    window.matrizPermissoes = JSON.parse(JSON.stringify(window.MATRIZ_PERMISSOES_PADRAO));
    localStorage.setItem('sagti_matriz_permissoes_v10', JSON.stringify(window.matrizPermissoes));
    window.aplicarPermissoesPerfil(window.perfilAtivo);
    window.renderizarMatrizRBAC();
    alert('🔄 Permissões restauradas com sucesso para os padrões de fábrica!');
};


// >>> MÓDULO: src/js/modulos/01_mesa_trabalho_fixados.js <<<
// =========================================================================
// MÓDULO 01: MESA DE TRABALHO, ALERTAS SLA/PORÉNS, WATCHLIST & TIMELINE
// =========================================================================

window.renderizarMeusProcessosMesa = function() {
        const tbody = document.getElementById('tbody-meus-processos');
        if (!tbody) return;

        const selPerfil = document.getElementById('select-perfil-ativo');
        const perfilAtivo = selPerfil ? selPerfil.value : 'Super-Admin';

        // Carrega watchlist de fixados do usuario logado (salva no localStorage)
        let fixados = [];
        try {
            const rawFix = localStorage.getItem('sagti_fixados');
            if (rawFix === null) {
                fixados = ['137.00010608/2025-63', '137.00000119/2026-84'];
                localStorage.setItem('sagti_fixados', JSON.stringify(fixados));
            } else {
                fixados = JSON.parse(rawFix || '[]');
            }
        } catch(e) { fixados = []; }

        const procsBase = (typeof PROCESSOS !== 'undefined' && Array.isArray(PROCESSOS)) ? PROCESSOS : [];

        // Filtro ESTRITO: Somente processos com vinculo DIRETO com o usuario logado
        let meusProcessos = [];

        if (perfilAtivo === 'Super-Admin' || perfilAtivo === 'Gestor') {
            // Luiz Seixeiro: Apenas processos com responsavel nominal a ele OU expressamente favoritados com estrela
            meusProcessos = procsBase.filter(p => {
                const idProc = p.ID_Processo || p.id || '';
                const resp = (p.Responsavel_Tecnico || p.responsavel || '').toLowerCase();
                const isFixado = fixados.includes(idProc);
                const isLuiz = resp.includes('luiz') || resp.includes('seixeiro');

                return isFixado || isLuiz;
            });
        } else if (perfilAtivo === 'Analista') {
            // Analistas: Apenas processos atribuidos nominalmente a Marcos/Diego + fixados
            meusProcessos = procsBase.filter(p => {
                const idProc = p.ID_Processo || p.id || '';
                const resp = (p.Responsavel_Tecnico || p.responsavel || '').toLowerCase();
                return resp.includes('marcos') || resp.includes('diego') || fixados.includes(idProc);
            });
        } else {
            // Demandante: Somente os que ele fixou na sua propria watchlist
            meusProcessos = procsBase.filter(p => fixados.includes(p.ID_Processo || p.id));
        }

        // Atualiza Scorecards dinâmicos EXCLUSIVAMENTE sobre os processos vinculados ao usuário
        const elCustodia = document.getElementById('mesa-kpi-custodia');
        if (elCustodia) elCustodia.innerText = String(meusProcessos.length);

        const criticos = meusProcessos.filter(p => (p.Faixa_Aging || '').includes('Crítico') || parseInt(p.Dias_Ultima_Mov || 0, 10) > 90).length;
        const elCriticos = document.getElementById('mesa-kpi-criticos');
        if (elCriticos) elCriticos.innerText = String(criticos);

        const porens = meusProcessos.filter(p => (p.Status_Kanban || p.Status_OpenProject || '').includes('CJ') || (p.Marcadores_Institucionais || '').includes('Suspensão') || (p.Farol_Criticidade || '').includes('Porem') || (p.Farol_Criticidade || '').includes('Porém')).length;
        const elPorens = document.getElementById('mesa-kpi-porens');
        if (elPorens) elPorens.innerText = String(porens);

        if (meusProcessos.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" style="text-align: center; padding: 28px; color: #64748b;">
                        <span style="font-size: 26px; display: block; margin-bottom: 6px;">📂</span>
                        <strong style="color:#0f2d59; font-size:13px;">Nenhum processo diretamente vinculado à sua mesa no momento.</strong><br>
                        <span style="font-size: 11.5px;">Para acompanhar processos aqui, clique na estrela ⭐ ao lado de qualquer processo no <strong>Acervo SEI</strong> ou na <strong>Visão Estratégica</strong>.</span>
                    </td>
                </tr>
            `;
            return;
        }

        let htmlTrs = '';
        meusProcessos.forEach(p => {
            const idProc = p.ID_Processo || p.id || '';
            const isFixado = fixados.includes(idProc);
            let pillAgingClass = 'pill-green';
            if ((p.Faixa_Aging || '').includes('Crítico')) pillAgingClass = 'pill-red';
            else if ((p.Faixa_Aging || '').includes('Atenção')) pillAgingClass = 'pill-yellow';
            else if ((p.Faixa_Aging || '').includes('Alerta')) pillAgingClass = 'pill-orange';

            const espTxt = p.Especificacao || p.especificacao || p.tipo || 'Demanda TIC';

            htmlTrs += `
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="text-align: center;">
                        <button onclick="toggleFixado('${idProc}'); window.renderizarMeusProcessosMesa();" style="background: none; border: none; cursor: pointer; font-size: 15px;" title="Fixar/Desafixar da Watchlist">
                            ${isFixado ? '⭐' : '☆'}
                        </button>
                    </td>
                    <td style="font-family: monospace; font-weight: 700;">
                        <a href="javascript:void(0)" onclick="abrirDetalhesProcesso('${idProc}')" style="color: #0056d2; text-decoration: none;" title="Abrir Dossiê 360°">${idProc}</a>
                    </td>
                    <td style="max-width: 260px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 12px; color: #1e293b;" title="${espTxt}">${espTxt}</td>
                    <td><span class="pill-tag pill-blue" style="font-size: 11px;">${p.Status_OpenProject || p.Status_Kanban || 'Em Andamento'}</span></td>
                    <td><span class="pill-tag ${pillAgingClass}" style="font-size: 11px;">${p.Faixa_Aging || 'Normal'} (${p.Dias_Ultima_Mov || 0}d)</span></td>
                    <td style="text-align: center; white-space: nowrap;">
                        <button class="btn btn-primary" onclick="abrirDetalhesProcesso('${idProc}')" style="background: #0056d2; border-color: #0056d2; padding: 4px 10px; font-size: 11px; font-weight: 700; border-radius: 4px; cursor: pointer;" title="Abrir Dossiê com Timeline">
                            🔍 Dossiê
                        </button>
                    </td>
                </tr>
            `;
        });

        tbody.innerHTML = htmlTrs;
    };

window.renderizarSecaoFixadosEAlertasMesa = function() {
        var viewMesa = document.getElementById('view-mesa_trabalho');
        if (!viewMesa) return;
        if (!window.GLPI_TICKETS_UNIFICADOS) window.construirBaseUnificadaGlpi();

        var ticketsSlaCritico = (window.GLPI_TICKETS_UNIFICADOS || []).filter(function(t) {
            return t.urgencia.indexOf('Critica') !== -1 && t.status.indexOf('Homologado') === -1;
        });
        var procsPorens = ((typeof PROCESSOS !== 'undefined' && Array.isArray(PROCESSOS)) ? PROCESSOS : []).filter(function(p) {
            var st = (p.status || p.Status_OpenProject || '').toLowerCase();
            var obs = (p.notas || p.Observacao_Texto || '').toLowerCase();
            return st.indexOf('jur') !== -1 || st.indexOf('extern') !== -1 || obs.indexOf('cj') !== -1;
        });

        var barraAlertas = document.getElementById('barra-proativa-sla-porens-v9');
        if (!barraAlertas) {
            barraAlertas = document.createElement('div');
            barraAlertas.id = 'barra-proativa-sla-porens-v9';
            viewMesa.insertBefore(barraAlertas, viewMesa.firstChild);
        }

        barraAlertas.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;background:linear-gradient(90deg,#fff1f2 0%,#fefce8 50%,#f0fdf4 100%);border:1px solid #fecdd3;border-left:5px solid #e11d48;border-radius:8px;padding:10px 16px;margin-bottom:14px;">' +
            '<div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:12px;">' +
                '<span style="font-weight:800;color:#9f1239;">&#128680; Radar Proativo de SLA &amp; Cust&oacute;dia Externa:</span>' +
                '<a href="javascript:void(0)" onclick="window.switchTab(\'gestao_glpi\')" style="color:#be123c;font-weight:700;text-decoration:underline;">&#9888;&#65039; ' + ticketsSlaCritico.length + ' Chamados Cr&iacute;ticos (SLA &lt; 2h no GLPI)</a>' +
                '<span style="color:#cbd5e1;">|</span>' +
                '<a href="javascript:void(0)" onclick="window.switchTab(\'consulta\')" style="color:#92400e;font-weight:700;text-decoration:underline;">&#1416; ' + procsPorens.length + ' Processos SEI com Suspens&atilde;o Externa (&ldquo;Por&eacute;ns&rdquo; CJ/PGE)</a>' +
                '<span style="color:#cbd5e1;">|</span>' +
                '<span style="color:#065f46;font-weight:700;">&#9989; Base Oficial Integrada: 500 OP + 13 GLPI + 179 SEI</span>' +
            '</div>' +
            '<div style="display:flex;gap:8px;">' +
                '<button class="btn btn-secondary" style="font-size:11px;padding:4px 10px;" onclick="window.dispararCicloVarreduras()">&#128268; Sondar 8 Motores</button>' +
                '<button class="btn btn-primary" style="font-size:11px;padding:4px 10px;" onclick="window.consultarProcessoAoVivoPNCP(\'137.00029841/2026-14\')">&#127760; Busca Direta PNCP/DOE</button>' +
            '</div>' +
        '</div>';
    };

// ==========================================
    // HISTÓRICO OCULTO / CONTEXT STREAM PARA A IA
    // ==========================================
    function registrarHistoricoIA(idProcesso, tipo, detalhe, autor) {
        if (!historicoProcessos[idProcesso]) historicoProcessos[idProcesso] = [];
        historicoProcessos[idProcesso].push({
            dataHora: new Date().toLocaleString(),
            tipo: tipo,
            detalhe: detalhe,
            autor: autor || 'Luiz Seixeiro'
        });
        localStorage.setItem('sagti_historico_processos', JSON.stringify(historicoProcessos));
    }

    function renderizarHistoricoModal(idProcesso) {
        const container = document.getElementById('modal-historico-ia');
        if (!container) return;
        const logs = historicoProcessos[idProcesso] || [];
        if (logs.length === 0) {
            container.innerHTML = `
                <div style="color: #94a3b8; font-style: italic;">
                    Nenhum evento registrado ainda. Quando o processo for discutido na Daily ou receber post-its, o histórico da IA aparecerá aqui.
                </div>
            `;
            return;
        }

        container.innerHTML = logs.map(ev => `
            <div style="padding: 4px 6px; background: white; border-radius: 4px; border-left: 3px solid #0056d2;">
                <span style="color: #64748b; font-size: 10.5px;">[${ev.dataHora}] (${ev.autor}):</span>
                <strong> ${ev.tipo}:</strong> ${ev.detalhe}
            </div>
        `).join('');
    }

    // ==========================================
    // GESTÃO DA WATCHLIST / FIXADOS
    // ==========================================
    function toggleFixado(idProcesso) {
        const idx = fixados.indexOf(idProcesso);
        if (idx >= 0) {
            fixados.splice(idx, 1);
        } else {
            fixados.push(idProcesso);
        }
        localStorage.setItem('sagti_fixados', JSON.stringify(fixados));
        atualizarFixadosBadge();
        renderizarTabelaConsulta();
        renderizarFixados();
        renderizarKanbanAgil();
        renderizarListaFixadosConfig();
    }

    function atualizarFixadosBadge() {
        const b = document.getElementById('badge-fixados');
        if (b) b.innerText = fixados.length;
        const b2 = document.getElementById('fixados-count-badge');
        if (b2) b2.innerText = `${fixados.length} PROCESSOS`;
    }

    function renderizarFixados() {
        const tbody = document.getElementById('tbody-fixados');
        if (!tbody) return;
        const itensFixados = PROCESSOS.filter(p => fixados.includes(p.ID_Processo));
        if (itensFixados.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding: 30px; color: #94a3b8;">Nenhum processo fixado ainda. Clique na estrela (☆) em qualquer tabela ou card para fixar.</td></tr>`;
            return;
        }
        tbody.innerHTML = itensFixados.map(p => `
            <tr>
                <td style="text-align: center; cursor: pointer;" onclick="toggleFixado('${p.ID_Processo}')">⭐</td>
                <td>
    <div style="display: flex; align-items: center; gap: 6px;">
        <a href="javascript:void(0)" onclick="abrirDetalhesProcesso('${p.ID_Processo}')" style="font-weight: 700; color: #0284c7; text-decoration: none;" title="Abrir Dossie 360° no Cockpit">${p.ID_Processo}</a>
        <button type="button" class="btn btn-secondary" onclick="navigator.clipboard.writeText('${p.ID_Processo}'); alert('Numero ${p.ID_Processo} copiado!');" style="padding: 1px 5px; font-size: 10px;" title="Copiar numero do processo">📋</button>
        <a href="https://sei.sp.gov.br" target="_blank" style="font-size: 11px; text-decoration: none;" title="Abrir portal do SEI-SP">↗️</a>
    </div>
</td>
                <td>${p.Farol_Criticidade}</td>
                <td>${p.Bucket_OpenProject}</td>
                <td>${p.Responsavel_Tecnico || 'Não atribuído'}</td>
                <td>${p.Faixa_Aging}</td>
                <td style="max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${p.Especificacao}</td>
                <td style="text-align: center;">
                    <button class="btn btn-secondary" style="padding: 3px 8px; font-size: 11px;" onclick="abrirDetalhesProcesso('${p.ID_Processo}')">Ver</button>
                </td>
            </tr>
        `).join('');
    }

    function limparFixados() {
        if (confirm('Deseja realmente limpar todos os processos fixados?')) {
            fixados = [];
            localStorage.removeItem('sagti_fixados');
            atualizarFixadosBadge();
            renderizarFixados();
            renderizarListaFixadosConfig();
            renderizarTabelaConsulta();
            renderizarKanbanAgil();
        }
    }

    function toggleFixadoModal() {
        if (!processoModalAtual) return;
        toggleFixado(processoModalAtual);
        atualizarBotaoModalFixar();
    }

    function atualizarBotaoModalFixar() {
        const btn = document.getElementById('btn-modal-fixar');
        if (!btn || !processoModalAtual) return;
        const isFixado = fixados.includes(processoModalAtual);
        if (isFixado) {
            btn.innerHTML = '⭐ Fixado na Watchlist (Remover)';
            btn.className = 'btn btn-secondary';
        } else {
            btn.innerHTML = '☆ Fixar na Watchlist';
            btn.className = 'btn btn-primary';
        }
    }

    function adicionarFixadoManual() {
        const inp = document.getElementById('input-fixar-id');
        const id = inp.value.trim();
        if (!id) return;
        const p = PROCESSOS.find(item => item.ID_Processo.toLowerCase().includes(id.toLowerCase()));
        if (!p) {
            alert(`Processo "${id}" não encontrado na base de 179 processos.`);
            return;
        }
        if (!fixados.includes(p.ID_Processo)) {
            fixados.push(p.ID_Processo);
            localStorage.setItem('sagti_fixados', JSON.stringify(fixados));
            atualizarFixadosBadge();
            renderizarFixados();
            renderizarListaFixadosConfig();
            renderizarTabelaConsulta();
            renderizarKanbanAgil();
            inp.value = '';
            alert(`Processo ${p.ID_Processo} fixado com sucesso na Watchlist!`);
        } else {
            alert(`O processo ${p.ID_Processo} já está na sua Watchlist.`);
        }
    }

    function renderizarListaFixadosConfig() {
        const container = document.getElementById('lista-fixados-config');
        if (!container) return;
        if (fixados.length === 0) {
            container.innerHTML = `<span style="font-size: 12px; color: #94a3b8;">Nenhum processo fixado no momento.</span>`;
            return;
        }
        container.innerHTML = fixados.map(id => `
            <div style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 12px; font-size: 12px; display: flex; align-items: center; gap: 8px;">
                <strong>⭐ ${id}</strong>
                <button onclick="toggleFixado('${id}'); renderizarListaFixadosConfig();" style="border: none; background: none; color: #ef4444; font-weight: bold; cursor: pointer;">✖</button>
            </div>
        `).join('');
    }

    // ==========================================
    // MODAL DE DETALHES DO PROCESSO
    // ==========================================
    // =========================================================================
    // MARCO 2: TIMELINE GRÁFICA PROCESSUAL (STEPPER VISUAL NOS 3 EIXOS)
    // =========================================================================
    
    // =========================================================================
    // ETAPA 2 (MS-2 & MS-3): ACOPLAMENTO DO PARSER, REGRA DOS PORÉNS, MARIADB,
    // OPENPROJECT E ALIMENTAÇÃO AUTOMÁTICA DA LINHA DO TEMPO PELO DOE-SP
    // =========================================================================
    window.PORENS_OVERRIDES_ETAPA2 = {
        "137.00010608/2025-63": {
            suspenso: true,
            categoria: "Consultoria Jurídica (CJ / PGE-SP)",
            orgao: "Externo (Consultoria Jurídica CJ-SPÁGUAS)",
            motivo: "Aguardando emissão de Parecer Jurídico sobre minuta de prorrogação excepcional e SD-WAN.",
            diasRetidos: 18
        },
        "137.00000119/2026-84": {
            suspenso: true,
            categoria: "Dependência Externa (Diretorias de Bacia / IRP)",
            orgao: "Externo (Diretorias de Bacia Hidrográfica)",
            motivo: "Pendente consolidação da planilha estimativa de postos de trabalho pelas Bacias.",
            diasRetidos: 14
        },
        "137.00013132/2026-01": {
            suspenso: true,
            categoria: "Deliberação Orçamentária / Financeira (FEHIDRO)",
            orgao: "Externo (Comitê Coordenador FEHIDRO)",
            motivo: "Aguardando deliberação sobre liberação de dotação complementar FEHIDRO CORHI-199.",
            diasRetidos: 16
        },
        "137.00013810/2025-47": {
            suspenso: true,
            categoria: "Órgão de Controle Externo (TCE-SP / Parecer)",
            orgao: "Externo (TCE-SP / Consultoria Jurídica)",
            motivo: "Atendimento a apontamento externo sobre licenciamento Autodesk [Limite Excedido > 60d].",
            diasRetidos: 95
        },
        "137.00011338/2026-90": {
            suspenso: true,
            categoria: "Fase Recursal / Contencioso Licitatório",
            orgao: "Externo (Fase Recursal do Certame)",
            motivo: "Prazos técnicos suspensos para julgamento de recurso administrativo.",
            diasRetidos: 5
        }
    };

    window.MAPA_DIRETO_SEI_OPENPROJECT = {
        "137.00010608/2025-63": ["329", "556", "502", "1231"],
        "137.00012783/2025-95": ["42", "549", "550"],
        "137.00004821/2026-17": ["42", "549"],
        "137.00000119/2026-84": ["431", "1015", "1016", "1232"],
        "137.00011105/2025-13": ["1007", "1009"],
        "137.00010436/2025-28": ["1007", "1008"],
        "137.00010805/2025-52": ["398", "1002", "1232"],
        "137.00010806/2025-27": ["399", "357", "1232"],
        "137.00000001/2026-56": ["402", "999", "1232"],
        "137.00010619/2025-43": ["400", "1011", "1232"],
        "137.00013840/2025-53": ["60", "501", "369"],
        "137.00013843/2025-07": ["240", "60"],
        "137.00004844/2026-21": ["442", "501"],
        "137.00009067/2026-10": ["442", "501"],
        "137.00012389/2026-38": ["1185", "1223"],
        "137.00012390/2026-62": ["552", "1188"],
        "137.00012393/2026-04": ["530", "534"],
        "137.00012397/2026-84": ["178", "379", "1204"],
        "137.00012420/2026-31": ["178", "381"],
        "137.00000340/2026-32": ["430"]
    };

    window.calcularRegraDosPorensProcesso = function(proc) {
        if (!proc) return { suspenso: false, diasBruto: 0, diasExpurgados: 0, diasLiquido: 0, custodia: "Interno (SA-GTI)", nivel: "Fluxo Regular", statusFarol: "🟢 4 - Fluxo Normal" };
        var idProc = String(proc.ID_Processo || proc.id || "").trim();
        var diasBruto = parseInt(proc.Dias_Ultima_Mov || 0, 10) || 0;
        var pubs = (window.ACERVO_PUBLICACOES_DOESP_SPAGUAS || []).filter(function(pb) { return pb.sei === idProc; });
        var txtPubs = pubs.map(function(pb) { return (pb.titulo || "") + " " + (pb.resumo || ""); }).join(" ");
        var blob = ((proc.Especificacao || "") + " " + (proc.Observacao_Texto || "") + " " + (proc.Marcadores_Institucionais || "") + " " + (proc.Status_OpenProject || "") + " " + txtPubs).toUpperCase();

        var ov = window.PORENS_OVERRIDES_ETAPA2[idProc];
        var suspenso = false;
        var categoria = "Tratativa Interna SA-GTI";
        var orgao = "🏢 Interno (SA-GTI)";
        var motivo = "Fluxo técnico interno sob responsabilidade direta da SA-GTI.";
        var diasExpurgados = 0;

        if (ov) {
            suspenso = true;
            categoria = ov.categoria;
            orgao = "⚖️ " + ov.orgao;
            motivo = ov.motivo;
            diasExpurgados = diasBruto > 0 ? Math.min(diasBruto, ov.diasRetidos) : ov.diasRetidos;
        } else if (/AGUARDANDO PGE|CONSULTORIA JUR[IÍ]DICA|PARECER CJ|COTA CJ|PARECER EXTERNO|GARGALO EXTERNO|TCE|AN[AÁ]LISE JUR[IÍ]DICA/.test(blob)) {
            suspenso = true;
            categoria = "Espera por Parecer / Órgão Externo (CJ/PGE/TCE)";
            orgao = "⚖️ Externo (CJ / PGE / TCE-SP)";
            motivo = "Autos remetidos para análise jurídica ou manifestação de órgão externo.";
            diasExpurgados = Math.max(1, Math.round(diasBruto * 0.65));
        } else if (/CONTINGENCIAMENTO|BLOQUEIO OR[CÇ]AMENT[AÁ]RIO|SEM DOTA[CÇ][AÃ]O|FEHIDRO/.test(blob)) {
            suspenso = true;
            categoria = "Contingenciamento Orçamentário / Financeiro";
            orgao = "💰 Externo (Orçamento / FEHIDRO)";
            motivo = "Aguardando liberação de dotação orçamentária ou deliberação financeira.";
            diasExpurgados = Math.max(1, Math.round(diasBruto * 0.6));
        } else if (/FASE RECURSAL|SUSPENS[AÃ]O JUDICIAL|LIMINAR|IMPUGNA[CÇ][AÃ]O/.test(blob)) {
            suspenso = true;
            categoria = "Suspensão Judicial / Liminar / Fase Recursal";
            orgao = "✋ Externo (Fase Recursal / Judiciário)";
            motivo = "Prazos suspensos por fase recursal ou decisão administrativa/judicial.";
            diasExpurgados = Math.max(1, Math.round(diasBruto * 0.75));
        }

        var diasLiquido = Math.max(0, diasBruto - diasExpurgados);
        var nivel = "Fluxo Interno Regular (Sem Impedimento Externo)";
        var statusFarol = proc.Farol_Criticidade || "🟢 4 - Fluxo Normal";

        if (suspenso) {
            var dRef = diasExpurgados > 0 ? diasExpurgados : diasBruto;
            if (dRef <= 30) {
                statusFarol = "⏸️ Suspenso Legalmente";
                nivel = "Tolerância Regular (<=30d) — Equipe SA-GTI Resguardada";
            } else if (dRef <= 60) {
                statusFarol = "🟡 Suspenso (Reiteração Necessária)";
                nivel = "Reiteração Obrigatória (31-60d) — Emitir Cota/Checkpoint no SEI";
            } else {
                statusFarol = "🟠 2 - Saneamento Prioritário";
                nivel = "Limite Jurídico Excedido (>60d) — Transborda para Liderança";
            }
        }

        return {
            suspenso: suspenso,
            categoria: categoria,
            orgao: orgao,
            motivo: motivo,
            diasBruto: diasBruto,
            diasExpurgados: diasExpurgados,
            diasLiquido: diasLiquido,
            nivel: nivel,
            statusFarol: statusFarol
        };
    };

    window.vincularProcessoAoOpenProjectCliente = function(proc) {
        if (!proc) return [];
        var idProc = String(proc.ID_Processo || proc.id || "").trim();
        var opList = Array.isArray(window.OP_PACOTES_OFICIAIS) ? window.OP_PACOTES_OFICIAIS : [];
        var idsPrio = window.MAPA_DIRETO_SEI_OPENPROJECT[idProc] || [];
        var bktCode = String(proc.Bucket_OpenProject || "").split(".")[0].trim();
        var encontrados = [];
        var vistos = {};

        opList.forEach(function(wp) {
            if (idsPrio.indexOf(String(wp.id)) !== -1 || (idProc && String(wp.desc || "").indexOf(idProc) !== -1)) {
                if (!vistos[wp.id]) {
                    encontrados.push(wp);
                    vistos[wp.id] = true;
                }
            }
        });

        if (encontrados.length === 0 && bktCode) {
            opList.forEach(function(wp) {
                if (encontrados.length < 3 && !vistos[wp.id] && String(wp.backlog || "").indexOf(bktCode) !== -1) {
                    encontrados.push(wp);
                    vistos[wp.id] = true;
                }
            });
        }

        if (encontrados.length === 0 && opList.length > 0) {
            var fbId = (String(proc.Eixo_Gestao || "").indexOf("Contrata") !== -1) ? "1232" : "1231";
            var fbWp = opList.find(function(w) { return String(w.id) === fbId; }) || opList[0];
            if (fbWp) encontrados.push(fbWp);
        }
        return encontrados.slice(0, 4);
    };

    window.acoplarResultadoDoeSpNaLinhaDoTempo = function(termoOuSei, listaPublicacoes) {
        var pubs = Array.isArray(listaPublicacoes) ? listaPublicacoes : (window.ACERVO_PUBLICACOES_DOESP_SPAGUAS || []);
        var eventosCriados = 0;

        pubs.forEach(function(pub) {
            var seiRef = String(pub.sei || "").trim();
            if (!/^\d{3}\.\d{8}\/\d{4}-\d{2}$/.test(seiRef)) return;
            var procObj = (typeof PROCESSOS !== "undefined" && Array.isArray(PROCESSOS))
                ? PROCESSOS.find(function(p) { return p.ID_Processo === seiRef; })
                : null;
            var poremInfo = window.calcularRegraDosPorensProcesso(procObj || { ID_Processo: seiRef, Dias_Ultima_Mov: 21 });
            var wps = window.vincularProcessoAoOpenProjectCliente(procObj || { ID_Processo: seiRef });
            var wpTag = wps.length > 0 ? wps.map(function(w) { return "#" + w.id; }).join(", ") : "#1232";

            if (!historicoProcessos[seiRef]) historicoProcessos[seiRef] = [];
            var chave = String(pub.id || pub.titulo || "").slice(0, 60);
            var jaExiste = historicoProcessos[seiRef].some(function(ev) {
                return String(ev.detalhe || "").indexOf(chave) !== -1 || String(ev.idPub || "") === String(pub.id || "");
            });

            if (!jaExiste) {
                historicoProcessos[seiRef].unshift({
                    idPub: pub.id || ("DOE-" + Date.now()),
                    dataHora: (pub.data || new Date().toLocaleDateString("pt-BR")) + " • DOE-SP Oficial",
                    tipo: "📰 PUBLICAÇÃO DOE-SP & ACOPLAMENTO MS-2/MS-3",
                    detalhe: (pub.titulo || "Ato Oficial DOE-SP") + " — " + (pub.resumo || "") +
                             " | Regra dos Poréns: Aging Bruto " + poremInfo.diasBruto + "d → Líquido " + poremInfo.diasLiquido + "d (" + poremInfo.statusFarol + ")" +
                             " | OpenProject: " + wpTag + " | MariaDB: Sincronizado",
                    url: pub.url || ("https://www.doe.sp.gov.br/busca?q=" + encodeURIComponent(seiRef)),
                    autor: pub.orgao || "Motor #1 DOE-SP + MS-2/MS-3"
                });
                eventosCriados++;
            }
        });

        try {
            localStorage.setItem("sagti_historico_processos", JSON.stringify(historicoProcessos));
        } catch (e) {}

        if (processoModalAtual) {
            renderizarHistoricoModal(processoModalAtual);
        }
        return eventosCriados;
    };

    window.gerarTimelineProcessualHtml = function(proc) {
        if (!proc) return '';

        const eixo = proc.Eixo_Gestao || 'Rotina Operacional';
        const status = proc.Status_OpenProject || '';
        const farol = proc.Farol_Criticidade || '4 - Fluxo Normal';
        const aging = proc.Dias_Ultima_Mov || 0;

        // Determina cor do Farol
        let farolCor = '#10b981'; // Verde padrão
        if (farol.includes('1') || farol.toLowerCase().includes('imediata')) farolCor = '#ef4444';
        else if (farol.includes('2') || farol.toLowerCase().includes('prioritário') || farol.toLowerCase().includes('prioritario')) farolCor = '#f97316';
        else if (farol.includes('3') || farol.toLowerCase().includes('ativo') || farol.toLowerCase().includes('alerta')) farolCor = '#eab308';

        // Definição das Fases por Eixo
        let fases = [];
        let indiceAtual = 0;
        let baseLegal = "";
        let proximoArtefato = "";

        if (eixo.includes('Contratação') || eixo.includes('Contratacao')) {
            fases = [
                { nome: 'Formalização', icone: '📝', desc: 'Abertura SEI & DFD' },
                { nome: 'ETP & Riscos', icone: '🧩', desc: 'Dimensionamento & TCO 36m' },
                { nome: 'Análise Jurídica', icone: '⚖️', desc: 'Parecer CJ & Regra dos Poréns' },
                { nome: 'Certame', icone: '📢', desc: 'Publicação de Edital' },
                { nome: 'Julgamento', icone: '🔨', desc: 'Lances & Habilitação' },
                { nome: 'Fase Recursal', icone: '✋', desc: 'Prazos de Recursos' },
                { nome: 'Homologação', icone: '🏆', desc: 'Adjudicação Diretoria' },
                { nome: 'Contrato', icone: '✍️', desc: 'Assinatura & Portaria Fiscais' },
                { nome: 'Encerrado', icone: '✅', desc: 'Vigência Concluída' }
            ];

            // Mapeamento do status na esteira
            const sLow = status.toLowerCase();
            if (sLow.includes('dfd') || sLow.includes('demanda')) indiceAtual = 0;
            else if (sLow.includes('etp') || sLow.includes('risco')) indiceAtual = 1;
            else if (sLow.includes('juríd') || sLow.includes('jurid') || sLow.includes('cj') || sLow.includes('aprova')) indiceAtual = 2;
            else if (sLow.includes('edital') || sLow.includes('divulga')) indiceAtual = 3;
            else if (sLow.includes('julga') || sLow.includes('habilita')) indiceAtual = 4;
            else if (sLow.includes('recur')) indiceAtual = 5;
            else if (sLow.includes('homologa') || sLow.includes('adjudica')) indiceAtual = 6;
            else if (sLow.includes('contrato')) indiceAtual = 7;
            else if (sLow.includes('encerrado') || sLow.includes('desativado')) indiceAtual = 8;
            else indiceAtual = 1; // Padrão

            baseLegal = "Lei Federal nº 14.133/2021 (Arts. 18 e 72) | Decreto Estadual nº 67.689/2023 (Pesquisa de Preços) | Decreto Estadual nº 68.220/2023 (TR & IMR)";
            proximoArtefato = indiceAtual < 2 ? "Estudo Técnico Preliminar (ETP) com cálculo de TCO de 36 meses" : (indiceAtual === 2 ? "Despacho saneador ao Parecer da Consultoria Jurídica" : "Termo Contratual e Designação de Fiscais");

        } else if (eixo.includes('Rotina')) {
            fases = [
                { nome: 'Backlog', icone: '➡️', desc: 'Faturas/Chamados Recebidos' },
                { nome: 'Fluxo Normal', icone: '🟢', desc: 'Operação sem Incidentes' },
                { nome: 'Monitoramento', icone: '🟡', desc: 'Atestes Mensais PRODESP/Links' },
                { nome: 'Sinalizados', icone: '🟠', desc: 'Gargalo de SLA / Risco Glosa' },
                { nome: 'Intervenção', icone: '🔴', desc: 'Checkpoint / Abertura PAAR' },
                { nome: 'Encerrado', icone: '✅', desc: 'Liquidado no SIAFEM' }
            ];

            const sLow = status.toLowerCase();
            if (sLow.includes('backlog')) indiceAtual = 0;
            else if (sLow.includes('normal')) indiceAtual = 1;
            else if (sLow.includes('monitoramento')) indiceAtual = 2;
            else if (sLow.includes('sinalizado') || sLow.includes('gargalo')) indiceAtual = 3;
            else if (sLow.includes('intervenção') || sLow.includes('intervencao')) indiceAtual = 4;
            else if (sLow.includes('encerrado')) indiceAtual = 5;
            else indiceAtual = 2; // Padrão

            baseLegal = "Decreto Estadual nº 68.220/2023 (Gestão e Fiscalização de Contratos) | Instruções SIAFEM/SIGRH | SLAs do GLPI 10";
            proximoArtefato = "Termo de Recebimento Provisório (TRP) com apuração mensal de IMR para liquidação no SIAFEM";

        } else {
            // Portfólio Estratégico
            fases = [
                { nome: 'Novo', icone: '💡', desc: 'Demanda de Inovação PDTIC' },
                { nome: 'Agendado', icone: '📅', desc: 'Alocado em Sprint' },
                { nome: 'A Agendar', icone: '⏳', desc: 'Aguardando Pré-requisito' },
                { nome: 'Em Progresso', icone: '🚀', desc: 'Execução Ativa no Kanban' },
                { nome: 'Em Espera', icone: '⏸️', desc: 'Pausado por Dependência' },
                { nome: 'Encerrado', icone: '✅', desc: 'Entregue em Produção' }
            ];

            const sLow = status.toLowerCase();
            if (sLow.includes('novo')) indiceAtual = 0;
            else if (sLow.includes('agendado') && !sLow.includes('a ')) indiceAtual = 1;
            else if (sLow.includes('a ser') || sLow.includes('a agendar')) indiceAtual = 2;
            else if (sLow.includes('progresso')) indiceAtual = 3;
            else if (sLow.includes('espera')) indiceAtual = 4;
            else if (sLow.includes('encerrado')) indiceAtual = 5;
            else indiceAtual = 3; // Padrão

            baseLegal = "Plano Diretor de TIC (PDTIC 2027-2030) | Metodologia de Gestão de Projetos OpenProject 14 | Súmula 269 TCU";
            proximoArtefato = "Validação do Quality Gate da Sprint e homologação da entrega no repositório institucional (GitLab)";
        }

        // Renderiza os steps do Stepper
        const stepsHtml = fases.map((f, i) => {
            const isConcluido = i < indiceAtual;
            const isAtual = i === indiceAtual;
            const isFuturo = i > indiceAtual;

            let badgeEstilo = "background: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1;";
            let labelCor = "#64748b";
            let iconeExibir = f.icone;

            if (isConcluido) {
                badgeEstilo = "background: #01a75f; color: #ffffff; border: 1px solid #01a75f;";
                labelCor = "#01a75f";
                iconeExibir = "✓";
            } else if (isAtual) {
                badgeEstilo = `background: ${farolCor}; color: #ffffff; border: 2px solid #ffffff; box-shadow: 0 0 0 3px ${farolCor}; font-weight: bold;`;
                labelCor = "#002d5a";
            }

            return `
                <div style="flex: 1; display: flex; flex-direction: column; align-items: center; position: relative; z-index: 2;">
                    <div style="width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; margin-bottom: 6px; ${badgeEstilo}">
                        ${iconeExibir}
                    </div>
                    <div style="font-size: 10.5px; font-weight: ${isAtual ? '800' : '600'}; color: ${labelCor}; text-align: center; line-height: 1.2;">
                        ${f.nome}
                    </div>
                    <div style="font-size: 9.5px; color: #94a3b8; text-align: center; margin-top: 2px;">
                        ${f.desc}
                    </div>
                </div>
            `;
        }).join('');

        return `
            <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 14px 16px; margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <strong style="color: #002d5a; font-size: 12.5px;">📈 ESTEIRA PROCESSUAL: ${eixo.toUpperCase()}</strong>
                        <span style="font-size: 10.5px; background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 12px; font-weight: 700;">Etapa ${indiceAtual + 1} de ${fases.length}</span>
                    </div>
                    <div style="font-size: 11.5px; color: #1e293b;">
                        Fase Atual: <strong style="color: ${farolCor};">${fases[indiceAtual].nome}</strong> (Aging: <strong>${aging} dias</strong>)
                    </div>
                </div>

                <!-- LINHA HORIZONTAL DA TIMELINE -->
                <div style="display: flex; align-items: flex-start; justify-content: space-between; position: relative; padding: 4px 0;">
                    <div style="position: absolute; top: 18px; left: 24px; right: 24px; height: 3px; background: #e2e8f0; z-index: 1;"></div>
                    ${stepsHtml}
                </div>

                <!-- METADADOS NORMATIVOS + ETAPA 2 (REGRA DOS PORÉNS, OPENPROJECT & MARIADB) -->
                <div style="margin-top: 14px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 12px; font-size: 11px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                    <div>
                        <strong style="color: #002d5a;">⚖️ Base Normativa Aplicável:</strong><br>
                        <span style="color: #475569;">${baseLegal}</span>
                    </div>
                    <div>
                        <strong style="color: #002d5a;">📄 Próximo Artefato Exigido:</strong><br>
                        <span style="color: #0544cf; font-weight: 600;">${proximoArtefato}</span>
                    </div>
                    <div style="border-top: 1px dashed #cbd5e1; padding-top: 8px;">
                        <strong style="color: #002d5a;">🛡️ Regra dos Poréns (MS-2 • Aging Líquido):</strong><br>
                        <span style="color: #1e293b;">
                            Bruto: <strong>${(window.calcularRegraDosPorensProcesso ? window.calcularRegraDosPorensProcesso(proc).diasBruto : aging)}d</strong> |
                            Expurgo Externo: <strong style="color:#d97706;">-${(window.calcularRegraDosPorensProcesso ? window.calcularRegraDosPorensProcesso(proc).diasExpurgados : 0)}d</strong> |
                            Aging Líquido SA-GTI: <strong style="color:#01a75f;">${(window.calcularRegraDosPorensProcesso ? window.calcularRegraDosPorensProcesso(proc).diasLiquido : aging)}d</strong><br>
                            <span style="color:#475569;font-size:10.5px;">${(window.calcularRegraDosPorensProcesso ? window.calcularRegraDosPorensProcesso(proc).nivel : '')}</span>
                        </span>
                    </div>
                    <div style="border-top: 1px dashed #cbd5e1; padding-top: 8px;">
                        <strong style="color: #002d5a;">🏗️ Vínculo OpenProject (MS-3) &amp; MariaDB:</strong><br>
                        <span style="color: #1e293b;">
                            Work Packages: <strong>${(window.vincularProcessoAoOpenProjectCliente ? window.vincularProcessoAoOpenProjectCliente(proc).map(w => '#' + w.id + ' (' + w.assunto.slice(0,28) + ')').join(', ') : '#1232')}</strong><br>
                            <span style="color:#047857;font-size:10.5px;font-weight:700;">🟢 Sincronizado em MariaDB (glpidb) &amp; Alimentado pelo DOE-SP</span>
                        </span>
                    </div>
                </div>
            </div>
        `;
    };

    function abrirDetalhesProcesso(idProcesso) {
        const p = PROCESSOS.find(item => item.ID_Processo === idProcesso);
        if (!p) return;
        processoModalAtual = idProcesso;
        if (typeof window.acoplarResultadoDoeSpNaLinhaDoTempo === 'function') {
            window.acoplarResultadoDoeSpNaLinhaDoTempo(idProcesso, window.ACERVO_PUBLICACOES_DOESP_SPAGUAS);
        }
        atualizarBotaoModalFixar();
        renderizarHistoricoModal(idProcesso);

        // Gera a timeline processual do Marco 2
        const timelineHtml = window.gerarTimelineProcessualHtml(p);

        document.getElementById('modal-titulo').innerText = `Processo SEI: ${p.ID_Processo}`;
        document.getElementById('modal-conteudo').innerHTML = `
            ${timelineHtml}
            <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 4px solid #16a34a; padding: 12px 14px; border-radius: 6px; margin-bottom: 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <div>
                    <strong style="color: #14532d; font-size: 12px;">🌐 Consulta em Tempo Real no Site Oficial (PNCP / Compras SP / SEI)</strong>
                    <div style="font-size: 11px; color: #15803d; margin-top: 2px;">
                        Verifique publicações da Lei 14.133, andamento no SEI-SP ou atas homologadas no PNCP.
                    </div>
                </div>
                <div style="display: flex; gap: 8px;">
                    <button class="btn btn-primary" onclick="window.consultarProcessoAoVivoPNCP('${p.ID_Processo}')" style="background: #01a75f; border-color: #01a75f; font-size: 11px; padding: 5px 12px; font-weight: 700; cursor: pointer;">
                        🔍 Checar no Site Oficial
                    </button>
                    <a href="https://pncp.gov.br/app/editais?q=${encodeURIComponent(p.ID_Processo)}" target="_blank" class="btn btn-secondary" style="font-size: 11px; padding: 5px 10px; text-decoration: none; color: #002d5a; font-weight: 600;">
                        Abrir PNCP ↗
                    </a>
                    <a href="https://sei.sp.gov.br/sei/controlador_externo.php?acao=usuario_externo_consultar&id_orgao_acesso_externo=0" target="_blank" class="btn btn-secondary" style="font-size: 11px; padding: 5px 10px; text-decoration: none; color: #002d5a; font-weight: 600;">
                        Abrir SEI-SP ↗
                    </a>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px;">
                <div><strong>Eixo de Gestão:</strong> ${p.Eixo_Gestao}</div>
                <div><strong>Bucket OpenProject:</strong> ${p.Bucket_OpenProject}</div>
                <div><strong>Status OpenProject:</strong> ${p.Status_OpenProject}</div>
                <div><strong>Farol Criticidade:</strong> ${p.Farol_Criticidade}</div>
                <div><strong>Faixa Aging:</strong> ${p.Faixa_Aging} (${p.Dias_Ultima_Mov} dias sem mov.)</div>
                <div><strong>Classificação de Risco:</strong> ${p.Classificacao_Risco}</div>
                <div><strong>Responsável Técnico:</strong> ${p.Responsavel_Tecnico || 'Não atribuído'}</div>
                <div><strong>Tipo de Processo:</strong> ${p.Tipo_Processo}</div>
            </div>
            <div style="margin-bottom: 12px;">
                <strong>Especificação da Demanda:</strong>
                <p style="background: #f1f5f9; padding: 10px; border-radius: 6px; margin-top: 4px;">${p.Especificacao || '-'}</p>
            </div>
            <div style="margin-bottom: 12px;">
                <strong>Observações / Contexto:</strong>
                <p style="background: #f8fafc; padding: 10px; border-radius: 6px; margin-top: 4px; border: 1px solid #e2e8f0;">${p.Observacao_Texto || 'Sem observações adicionais registradas.'}</p>
            </div>
            <div>
                <strong>📜 Linha do Tempo & Histórico Oculto da IA (Memória Contextual):</strong>
                <div id="modal-historico-ia" style="background: #f1f5f9; padding: 12px; border-radius: 6px; margin-top: 4px; border: 1px solid #cbd5e1; max-height: 160px; overflow-y: auto; font-size: 11.5px; display: flex; flex-direction: column; gap: 6px;">
                    <!-- Injetado dinamicamente -->
                </div>
            </div>
        `;
        document.getElementById('modal-processo').style.display = 'flex';
        renderizarHistoricoModal(idProcesso);
    }

    function fecharModalProcesso(e) {
        document.getElementById('modal-processo').style.display = 'none';
        processoModalAtual = null;
    }


// >>> MÓDULO: src/js/modulos/02_dashboards_diretorias.js <<<
// =========================================================================
// MÓDULO 02: CENTRAL DE DASHBOARDS, GRÁFICOS E SELETOR REATIVO DE DIRETORIAS
// =========================================================================

// ==========================================
    // GRÁFICOS APEXCHARTS DO LOOKER STUDIO
    // ==========================================
    function criarDonut(elemId, labels, series, colors) {
        const el = document.getElementById(elemId);
        if (!el) return;
        const options = {
            series: series,
            labels: labels,
            chart: { type: 'donut', height: 230 },
            colors: colors,
            legend: { position: 'bottom', fontSize: '11px', markers: { width: 8, height: 8 } },
            dataLabels: { enabled: true, formatter: val => Math.round(val) + '%' },
            plotOptions: { pie: { donut: { size: '58%' } } }
        };
        new ApexCharts(el, options).render();
    }

        
    // ==========================================
    // SIDEBAR RETRÁTIL & GESTÃO À VISTA
    // ==========================================
    window.sidebarCollapsed = false;
    window.toggleSidebar = function() {
        const sb = document.getElementById('sidebar');
        const btn = document.getElementById('btn-collapse-sidebar');
        window.sidebarCollapsed = !window.sidebarCollapsed;
        if (window.sidebarCollapsed) {
            sb.classList.add('collapsed');
            if (btn) btn.innerText = '▶';
        } else {
            sb.classList.remove('collapsed');
            if (btn) btn.innerText = '◀';
        }
        setTimeout(() => window.dispatchEvent(new Event('resize')), 250);
    };

    window.kioskAtivo = false;
    window.kioskTimer = null;
    window.kioskPausado = false;
    window.kioskIndice = 0;
    window.kioskTelas = [
        { tab: 'dashboards', modo: 'consolidado', nome: 'Central de Dashboards: Consolidado 360°' },
        { tab: 'dashboards', modo: 'esteira', nome: 'Central de Dashboards: Esteira de Contratação' },
        { tab: 'visao_estrategica', modo: null, nome: 'Visão Estratégica & Faróis de Criticidade' },
        { tab: 'gestao_agil', modo: null, nome: 'Gestão Ágil & Quadro Kanban' },
        { tab: 'daily_warroom', modo: null, nome: 'War Room: Daily & Metas' }
    ];

    window.toggleGestaoAVista = function() {
        const bar = document.getElementById('kiosk-bar');
        const btn = document.getElementById('btn-gestao-vista');
        window.kioskAtivo = !window.kioskAtivo;
        if (window.kioskAtivo) {
            bar.style.display = 'flex';
            if (btn) btn.innerText = '⏹️ Parar Gestão à Vista';
            if (!window.sidebarCollapsed) window.toggleSidebar();
            window.kioskIndice = 0;
            window.executarPassoKiosk();
        } else {
            bar.style.display = 'none';
            if (btn) btn.innerText = '📺 Gestão à Vista';
            if (window.sidebarCollapsed) window.toggleSidebar();
            clearInterval(window.kioskTimer);
        }
    };

    window.executarPassoKiosk = function() {
        clearInterval(window.kioskTimer);
        const tela = window.kioskTelas[window.kioskIndice];
        const lbl = document.getElementById('kiosk-tela-nome');
        if (lbl) lbl.innerText = tela.nome;

        window.switchTab(tela.tab);
        if (tela.modo && window.alternarModoDashboard) {
            window.alternarModoDashboard(tela.modo);
        }

        const prog = document.getElementById('kiosk-progress');
        if (prog) {
            prog.style.transition = 'none';
            prog.style.width = '0%';
            setTimeout(() => {
                prog.style.transition = 'width 20s linear';
                prog.style.width = '100%';
            }, 50);
        }

        let contagem = 20;
        window.kioskTimer = setInterval(() => {
            if (window.kioskPausado) return;
            contagem--;
            if (contagem <= 0) {
                window.kioskIndice = (window.kioskIndice + 1) % window.kioskTelas.length;
                window.executarPassoKiosk();
            }
        }, 1000);
    };

    window.pausarRetomarKiosk = function() {
        window.kioskPausado = !window.kioskPausado;
        const btn = document.getElementById('btn-kiosk-pause');
        if (btn) btn.innerText = window.kioskPausado ? '▶️ Continuar' : '⏸️ Pausar';
    };

    window.proximaTelaKiosk = function() {
        window.kioskIndice = (window.kioskIndice + 1) % window.kioskTelas.length;
        window.executarPassoKiosk();
    };

    window.dispararAtaDailyEmail = function() {
        const presentes = [];
        document.querySelectorAll('.chk-daily-part:checked').forEach(c => presentes.push(c.value));
        const dataHoje = new Date().toLocaleDateString('pt-BR');
        const assunto = encodeURIComponent(`[SP-ÁGUAS / SA-GTI] Ata da Daily Scrum — ${dataHoje}`);
        
        let corpoTexto = `Prezados,

Segue o resumo oficial da Daily Scrum da SA-GTI realizada em ${dataHoje}:

`;
        corpoTexto += `👥 PRESENTES: ${presentes.join(', ')}

`;
        corpoTexto += `📋 PAUTA OPERACIONAL: ${pautaDailyCards.length} processos analisados hoje.

`;
        corpoTexto += `🛡️ AÇÕES & ENCAMINHAMENTOS: Acompanhamento rigoroso dos prazos de ETP e atestes PRODESP.

`;
        corpoTexto += `Atenciosamente,
Subsecretaria de Tecnologia da Informação (SA-GTI)
SP-Águas — Governo do Estado de SP`;
        
        window.open(`mailto:?subject=${assunto}&body=${encodeURIComponent(corpoTexto)}`, '_blank');
        alert('✅ Resumo da Daily gerado com sucesso! Abrindo seu cliente de e-mail com a ata pré-formatada.');
    };

    
    // ==========================================
    // MOTOR GRÁFICO HÍBRIDO (APEXCHARTS + FALLBACK NATIVO)
    // ==========================================
    window.criarDonut = function(elemId, labels, series, colors) {
        const el = document.getElementById(elemId);
        if (!el) return;
        if (typeof ApexCharts !== 'undefined') {
            try {
                const options = {
                    series: series,
                    labels: labels,
                    chart: { type: 'donut', height: 230 },
                    colors: colors || ['#0056d2', '#56b4f8', '#00a859', '#f59e0b', '#f97316', '#ef4444', '#64748b'],
                    legend: { position: 'bottom', fontSize: '11px', markers: { width: 8, height: 8 } },
                    dataLabels: { enabled: true, formatter: val => Math.round(val) + '%' },
                    plotOptions: { pie: { donut: { size: '58%' } } }
                };
                new ApexCharts(el, options).render();
                return;
            } catch(e) {
                console.warn('Erro ao renderizar ApexCharts em ' + elemId + ', usando fallback nativo:', e);
            }
        }
        // Fallback visual nativo (HTML/CSS) caso ApexCharts CDN não carregue ou falhe
        const total = series.reduce((a, b) => a + b, 0) || 1;
        let out = '<div style="padding: 10px; display: flex; flex-direction: column; gap: 7px; justify-content: center; height: 100%;">';
        labels.forEach((lbl, i) => {
            const val = series[i] || 0;
            const pct = Math.round((val / total) * 100);
            const cor = (colors && colors[i]) ? colors[i] : '#0056d2';
            out += `
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 2px;">
                        <span style="color: #475569; font-weight: 600;">${lbl}</span>
                        <span style="font-weight: 700; color: #1e293b;">${val} (${pct}%)</span>
                    </div>
                    <div style="background: #e2e8f0; height: 6px; border-radius: 4px; overflow: hidden;">
                        <div style="background: ${cor}; width: ${pct}%; height: 100%; border-radius: 4px;"></div>
                    </div>
                </div>
            `;
        });
        out += '</div>';
        el.innerHTML = out;
    };
    function criarDonut(elemId, labels, series, colors) { window.criarDonut(elemId, labels, series, colors); }

    window.criarBarraHorizontal = function(elemId, categories, data) {
        const el = document.getElementById(elemId);
        if (!el) return;
        if (typeof ApexCharts !== 'undefined') {
            try {
                const options = {
                    series: [{ name: 'Processos', data: data }],
                    chart: { type: 'bar', height: 250, toolbar: { show: false } },
                    plotOptions: { bar: { horizontal: true, borderRadius: 4, barHeight: '55%' } },
                    colors: ['#0056d2'],
                    xaxis: { categories: categories, labels: { style: { fontSize: '11px' } } },
                    dataLabels: { enabled: true, style: { fontSize: '11px' } }
                };
                new ApexCharts(el, options).render();
                return;
            } catch(e) {
                console.warn('Erro ao renderizar ApexCharts em ' + elemId + ', usando fallback nativo:', e);
            }
        }
        // Fallback visual nativo
        const maxVal = Math.max(...data, 1);
        let out = '<div style="padding: 10px; display: flex; flex-direction: column; gap: 8px; justify-content: center; height: 100%;">';
        categories.forEach((cat, i) => {
            const val = data[i] || 0;
            const pct = Math.round((val / maxVal) * 100);
            out += `
                <div>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; margin-bottom: 2px;">
                        <span style="color: #475569; font-weight: 600;">${cat}</span>
                        <span style="font-weight: 700; color: #0544cf;">${val} proc.</span>
                    </div>
                    <div style="background: #e2e8f0; height: 7px; border-radius: 4px; overflow: hidden;">
                        <div style="background: #0544cf; width: ${pct}%; height: 100%; border-radius: 4px;"></div>
                    </div>
                </div>
            `;
        });
        out += '</div>';
        el.innerHTML = out;
    };
    function criarBarraHorizontal(elemId, categories, data) { window.criarBarraHorizontal(elemId, categories, data); }

    window.criarBarraEmpilhada = function(elemId) {
        const el = document.getElementById(elemId);
        if (!el) return;
        if (typeof ApexCharts !== 'undefined') {
            try {
                const options = {
                    series: [
                        { name: 'Rotina Padrão', data: [0, 41, 32, 19, 0, 0, 0] },
                        { name: '3 - Monitoramento Ativo', data: [28, 0, 0, 0, 12, 10, 0] },
                        { name: '2 - Saneamento Prioritário', data: [18, 0, 0, 0, 2, 5, 1] },
                        { name: '4 - Fluxo Normal', data: [9, 0, 0, 0, 2, 0, 0] }
                    ],
                    chart: { type: 'bar', height: 280, stacked: true, toolbar: { show: false } },
                    plotOptions: { bar: { horizontal: false, borderRadius: 3, columnWidth: '50%' } },
                    colors: ['#64748b', '#ca8a04', '#ea580c', '#16a34a'],
                    xaxis: {
                        categories: ['A-011. ETP', 'A-001. Atestes', 'A-002. Faturas', 'A-010. Suporte', 'A-017. Infra', 'A-016. PDTIC', 'A-004. Licenças'],
                        labels: { style: { fontSize: '10px' } }
                    },
                    legend: { position: 'top', fontSize: '11px' }
                };
                new ApexCharts(el, options).render();
                return;
            } catch(e) {
                console.warn('Erro ao renderizar ApexCharts em ' + elemId + ', usando fallback nativo:', e);
            }
        }
        // Fallback visual nativo
        el.innerHTML = `
            <div style="padding: 12px; font-size: 11px; color: #475569;">
                <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 8px;">
                    <span class="pill-tag pill-gray">⚪ Rotina: 92</span>
                    <span class="pill-tag pill-yellow">🟡 Monitoramento: 50</span>
                    <span class="pill-tag pill-orange">🟠 Saneamento: 26</span>
                    <span class="pill-tag pill-green">🟢 Fluxo Normal: 11</span>
                </div>
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px; line-height: 1.5;">
                    Buckets: ETP (55), Atestes (41), Faturas (32), Suporte (19), Infra (16), PDTIC (15), Licenças (1).
                </div>
            </div>
        `;
    };
    function criarBarraEmpilhada(elemId) { window.criarBarraEmpilhada(elemId); }

window.modoDashboardAtivo = 'consolidado';
    window.graficosCriados = {
        consolidado: false,
        esteira: false,
        rotina: false,
        portfolio: false
    };

    window.alternarModoDashboard = function(modo) {
        window.modoDashboardAtivo = modo;

        // Alterna classes das pills
        document.querySelectorAll('.pill-filtro-dash').forEach(btn => {
            btn.classList.remove('btn-primary');
            btn.classList.add('btn-secondary');
        });
        const activeBtn = document.getElementById('btn-dash-' + modo);
        if (activeBtn) {
            activeBtn.classList.remove('btn-secondary');
            activeBtn.classList.add('btn-primary');
        }

        // Alterna subviews
        document.querySelectorAll('.subview-dash').forEach(el => el.style.display = 'none');
        const target = document.getElementById('subview-dash-' + modo);
        if (target) target.style.display = 'block';

        // Atualiza Banner Principal e Título da Página
        const titulosModo = {
            'consolidado': {
                titulo: '📊 CENTRAL DE DASHBOARDS: VISÃO CONSOLIDADA 360°',
                desc: 'Visão executiva integrada de processos e demandas finalísticas da SA-GTI (SOE & SEI-SP)',
                badge: '🌐 Processos Integrados SOE & SEI',
                pageTitle: '📊 DASHBOARD CONSOLIDADO 360°'
            },
            'esteira': {
                titulo: '📑 CENTRAL DE DASHBOARDS: ESTEIRA DE CONTRATAÇÃO',
                desc: 'Processos vinculados à estruturação de contratações de TIC (Lei 14.133/2021) sob gestão da SA-GTI',
                badge: '📑 55 Processos em Contratação',
                pageTitle: '📑 DASHBOARD DA ESTEIRA DE CONTRATAÇÃO'
            },
            'rotina': {
                titulo: '⚙️ CENTRAL DE DASHBOARDS: ROTINA OPERACIONAL & SUSTENTAÇÃO',
                desc: 'Atestes e medições mensais (PRODESP), faturas de concessionárias e suporte interno',
                badge: '⚙️ 93 Processos Operacionais',
                pageTitle: '⚙️ DASHBOARD DE ROTINA OPERACIONAL'
            },
            'portfolio': {
                titulo: '🚀 CENTRAL DE DASHBOARDS: PORTFÓLIO ESTRATÉGICO & PDTIC',
                desc: 'Projetos de modernização de sistemas, governança de TIC e iniciativas estruturantes do PDTIC',
                badge: '🚀 31 Iniciativas Estratégicas',
                pageTitle: '🚀 DASHBOARD DE PORTFÓLIO ESTRATÉGICO'
            }
        };

        const cfg = titulosModo[modo] || titulosModo['consolidado'];
        const elTit = document.getElementById('dash-banner-titulo');
        if (elTit) elTit.innerText = cfg.titulo;
        const elDesc = document.getElementById('dash-banner-desc');
        if (elDesc) elDesc.innerText = cfg.desc;
        const elBadge = document.getElementById('dash-banner-tag');
        if (elBadge) elBadge.innerText = cfg.badge;
        const elPageTitle = document.getElementById('page-title');
        if (elPageTitle) elPageTitle.innerText = cfg.pageTitle;

        // Renderização sob demanda dos gráficos com redimensionamento
        setTimeout(() => {
            window.renderizarGraficosModo(modo);
            window.dispatchEvent(new Event('resize'));
        }, 60);
    };

        window.renderizarGraficosModo = function(modo) {
        const coresPadrao = ['#0056d2', '#56b4f8', '#00a859', '#f59e0b', '#f97316', '#ef4444', '#64748b'];

        if (modo === 'consolidado' && !window.graficosCriados.consolidado) {
            (window.criarDonut||criarDonut)('chart-cons-eixo', ['Rotina Operacional', 'Esteira de Contratação', 'Portfólio Estratégico'], [93, 55, 31], ['#334155', '#0056d2', '#4f46e5']);
            (window.criarDonut||criarDonut)('chart-cons-bucket', 
                ['A-011. ETP e Riscos', 'A-001. Atestes e Medições', 'A-002. Faturas', 'A-010. Suporte Interno', 'A-017. Modernização/Infra', 'A-016. Governança/PDTIC', 'A-004. Licenciamento'],
                [55, 41, 32, 19, 16, 15, 1], coresPadrao
            );
            (window.criarBarraHorizontal||criarBarraHorizontal)('chart-cons-resp', ['Marcos Tadeu Yamamoto', 'Diego Monteiro', 'Rafael Frossard Piteri'], [18, 15, 3]);
            (window.criarDonut||criarDonut)('chart-cons-criticidade', ['Rotina Padrão', '3 - Monitoramento Ativo', '2 - Saneamento Prioritário', '4 - Fluxo Normal'], [92, 50, 26, 11], ['#64748b', '#ca8a04', '#ea580c', '#16a34a']);
            (window.criarDonut||criarDonut)('chart-cons-risco', ['Médio', 'Baixo', 'Alto'], [87, 83, 9], ['#f59e0b', '#10b981', '#ef4444']);
            (window.criarDonut||criarDonut)('chart-cons-aging', ['Crítico', 'Atenção', 'Normal', 'Alerta'], [64, 54, 31, 30], ['#ef4444', '#f59e0b', '#10b981', '#0284c7']);
            window.graficosCriados.consolidado = true;
        } else if (modo === 'esteira' && !window.graficosCriados.esteira) {
            (window.criarDonut||criarDonut)('chart-est-bucket', ['A-011. Elaboração de ETP e Riscos'], [55], ['#0056d2']);
            (window.criarBarraHorizontal||criarBarraHorizontal)('chart-est-resp', ['Diego Monteiro', 'Marcos Yamamoto', 'Rafael Piteri'], [6, 4, 3]);
            (window.criarDonut||criarDonut)('chart-est-criticidade', ['3 - Monitoramento Ativo', '2 - Saneamento Prioritário', '4 - Fluxo Normal'], [28, 18, 9], ['#ca8a04', '#ea580c', '#16a34a']);
            (window.criarDonut||criarDonut)('chart-est-risco', ['Baixo', 'Médio', 'Alto'], [31, 23, 1], ['#10b981', '#f59e0b', '#ef4444']);
            (window.criarDonut||criarDonut)('chart-est-aging', ['Atenção', 'Crítico', 'Normal', 'Alerta'], [23, 18, 9, 5], ['#f59e0b', '#ef4444', '#10b981', '#0284c7']);
            window.graficosCriados.esteira = true;
        } else if (modo === 'rotina' && !window.graficosCriados.rotina) {
            (window.criarDonut||criarDonut)('chart-rot-bucket', ['A-001. Atestes', 'A-002. Faturas', 'A-010. Suporte', 'A-004. Licenças'], [41, 32, 19, 1], coresPadrao);
            (window.criarBarraHorizontal||criarBarraHorizontal)('chart-rot-resp', ['Diego Monteiro', 'Marcos Yamamoto'], [8, 4]);
            (window.criarDonut||criarDonut)('chart-rot-criticidade', ['Rotina Padrão'], [93], ['#64748b']);
            (window.criarDonut||criarDonut)('chart-rot-risco', ['Médio', 'Baixo', 'Alto'], [49, 36, 8], ['#f59e0b', '#10b981', '#ef4444']);
            (window.criarDonut||criarDonut)('chart-rot-aging', ['Crítico', 'Normal', 'Atenção', 'Alerta'], [39, 20, 17, 17], ['#ef4444', '#10b981', '#f59e0b', '#0284c7']);
            window.graficosCriados.rotina = true;
        } else if (modo === 'portfolio' && !window.graficosCriados.portfolio) {
            (window.criarDonut||criarDonut)('chart-port-bucket', ['A-017. Modernização/Infra', 'A-016. Governança/PDTIC'], [16, 15], ['#0284c7', '#4f46e5']);
            (window.criarBarraHorizontal||criarBarraHorizontal)('chart-port-resp', ['Marcos Yamamoto', 'Diego Monteiro'], [10, 3]);
            (window.criarDonut||criarDonut)('chart-port-criticidade', ['3 - Monitoramento Ativo', '2 - Saneamento Prioritário', '4 - Fluxo Normal'], [22, 7, 2], ['#ca8a04', '#ea580c', '#16a34a']);
            (window.criarDonut||criarDonut)('chart-port-risco', ['Baixo', 'Médio'], [16, 15], ['#10b981', '#f59e0b']);
            (window.criarDonut||criarDonut)('chart-port-aging', ['Crítico', 'Atenção', 'Alerta', 'Normal'], [12, 10, 8, 1], ['#ef4444', '#f59e0b', '#0284c7', '#10b981']);
            window.graficosCriados.portfolio = true;
        }
    };

var u = window.decodeUnicodeEscapes;
window.filtrarPorDiretoriaSpAguas = function(diretoria) {
        window.diretoriaAtivaSpAguas = diretoria;
        var d = window.dadosDiretoriasSpAguas[diretoria] || window.dadosDiretoriasSpAguas['todas'];

        // 1. Topbar: Titulo e Subtitulo
        ['page-title', 'topbar-title', 'dash-banner-titulo'].forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.innerText = u(d.bannerTitulo);
        });
        var topSpan = document.querySelector('#topbar .topbar-title span');
        if (topSpan && d.topSub) topSpan.innerText = u(d.topSub);

        // 2. Banner Principal
        var elDesc = document.getElementById('dash-banner-desc');
        if (elDesc) elDesc.innerText = u(d.bannerDesc);
        var elTag = document.getElementById('dash-banner-tag');
        if (elTag) elTag.innerText = u(d.bannerTag);
        var elBanner = document.getElementById('dash-banner-principal');
        if (elBanner && d.corBanner) elBanner.style.background = d.corBanner;

        // 3. Badge da Sidebar
        var navBadgeDash = document.querySelector('#sidebar .nav-item[data-tab="dashboards"] .nav-badge');
        if (navBadgeDash) navBadgeDash.innerText = d.acervo;

        // 4. Scorecards (5 cards) + Titulo do Hero Card
        var elHero = document.getElementById('kpi-val-acervo-total');
        if (elHero) {
            var heroCard = elHero.closest('.kpi-card');
            if (heroCard) {
                var hTitle = heroCard.querySelector('.kpi-title');
                if (hTitle && d.kpiHeroTitle) hTitle.innerText = u(d.kpiHeroTitle);
            }
        }

        var mapKpis = [
            ['kpi-val-acervo-total', d.acervo, d.subAcervo],
            ['kpi-val-intervencao', d.intervencao, d.subInterv],
            ['kpi-val-saneamento', d.saneamento, d.subSaneamento],
            ['kpi-val-monitoramento', d.monitoramento, d.subMonitoramento],
            ['kpi-val-fluxo-normal', d.fluxoNormal, d.subFluxoNormal]
        ];
        mapKpis.forEach(function(item) {
            var el = document.getElementById(item[0]);
            if (el) {
                el.innerText = u(item[1]);
                var card = el.closest('.kpi-card');
                var sp = card ? card.querySelector('span') : null;
                if (sp && item[2]) sp.innerText = u(item[2]);
            }
        });

        // 5. Cabecalho da Secao 1 (Decomposicao por Eixo) + 3 Cards e suas Descricoes!
        var sec1Card = document.querySelector('#subview-dash-consolidado .table-card');
        if (sec1Card) {
            var sec1TitSpans = sec1Card.querySelectorAll('.table-header-title span');
            if (sec1TitSpans.length >= 2 && d.sec1Titulo) sec1TitSpans[1].innerText = u(d.sec1Titulo);
            var sec1SubSpan = sec1Card.querySelector('.table-header-bar > span');
            if (sec1SubSpan && d.sec1Sub) sec1SubSpan.innerText = u(d.sec1Sub);
        }

        var eixosCfg = [
            { valId: 'kpi-val-rotina', subId: 'kpi-sub-rotina', val: d.rotina, sub: d.subRotina, desc: d.descRotina },
            { valId: 'kpi-val-esteira', subId: 'kpi-sub-esteira', val: d.esteira, sub: d.subEsteira, desc: d.descEsteira },
            { valId: 'kpi-val-portfolio', subId: 'kpi-sub-portfolio', val: d.portfolio, sub: d.subPortfolio, desc: d.descPortfolio }
        ];
        eixosCfg.forEach(function(ec) {
            var vEl = document.getElementById(ec.valId);
            var sEl = document.getElementById(ec.subId);
            if (vEl) {
                vEl.innerText = u(ec.val);
                var box = vEl.parentElement ? vEl.parentElement.parentElement : null;
                if (box) {
                    var descSpan = box.querySelector('span:last-child');
                    if (descSpan && ec.desc) descSpan.innerText = u(ec.desc);
                }
            }
            if (sEl) sEl.innerText = u(ec.sub);
        });

        // 6. As 4 Pilulas de Modo do Dashboard
        var nRot = parseInt(d.rotina) || 3;
        var nEst = parseInt(d.esteira) || 5;
        var nPort = parseInt(d.portfolio) || 2;
        var nSan = parseInt(d.saneamento) || 2;
        var nMon = parseInt(d.monitoramento) || 6;
        var nFlu = parseInt(d.fluxoNormal) || 3;

        var pillsMap = {
            'btn-dash-consolidado': u('\ud83c\udf10 Vis\u00e3o Consolidada (' + d.acervo + ')'),
            'btn-dash-esteira': u('\ud83d\udcd1 Esteira de Contrata\u00e7\u00e3o (' + nEst + ')'),
            'btn-dash-rotina': u('\u2699\ufe0f Rotina Operacional (' + nRot + ')'),
            'btn-dash-portfolio': u('\ud83d\ude80 Portf\u00f3lio Estrat\u00e9gico (' + nPort + ')')
        };
        Object.keys(pillsMap).forEach(function(pid) {
            var btn = document.getElementById(pid);
            if (btn) btn.innerText = pillsMap[pid];
        });

        // 7. Atualizar Titulos dos Graficos e Re-renderizar os 6 Graficos!
        try {
            var chBucketBox = document.getElementById('chart-cons-bucket');
            if (chBucketBox && chBucketBox.previousElementSibling && d.chartBucketTitulo) {
                chBucketBox.previousElementSibling.innerText = u(d.chartBucketTitulo);
            }
            var chRespBox = document.getElementById('chart-cons-resp');
            if (chRespBox && chRespBox.previousElementSibling && d.chartRespTitulo) {
                chRespBox.previousElementSibling.innerText = u(d.chartRespTitulo);
            }

            var cores = ['#0056d2', '#56b4f8', '#00a859', '#f59e0b', '#f97316', '#ef4444'];
            var fnD = window.criarDonut || (typeof criarDonut === 'function' ? criarDonut : null);
            var fnB = window.criarBarraHorizontal || (typeof criarBarraHorizontal === 'function' ? criarBarraHorizontal : null);

            var jaRenderizadoBoot = (!window._diretoriaJaTrocadaManual && window.diretoriaAtivaSpAguas === 'todas' && document.getElementById('chart-cons-eixo') && document.getElementById('chart-cons-eixo').children.length > 0);
            window._diretoriaJaTrocadaManual = true;
            if (!jaRenderizadoBoot) {
                var tarefasGraficos = [
                    function() { var el = document.getElementById('chart-cons-eixo'); if (el) el.innerHTML = ''; if (fnD) fnD('chart-cons-eixo', [u('Rotina Operacional'), u('Esteira de Contrata\u00e7\u00e3o'), u('Portf\u00f3lio Estrat\u00e9gico')], [nRot, nEst, nPort], ['#334155', '#0056d2', '#4f46e5']); },
                    function() { var el = document.getElementById('chart-cons-bucket'); if (el) el.innerHTML = ''; if (fnD) fnD('chart-cons-bucket', (d.chartBucketLabels || []).map(u), d.chartBucketSeries || [nEst, nRot, nPort], cores); },
                    function() { var el = document.getElementById('chart-cons-criticidade'); if (el) el.innerHTML = ''; if (fnD) fnD('chart-cons-criticidade', [u('Monitoramento Ativo'), u('Saneamento Priorit\u00e1rio'), u('Fluxo Normal')], [nMon, nSan, nFlu], ['#ca8a04', '#ea580c', '#16a34a']); },
                    function() { var el = document.getElementById('chart-cons-risco'); if (el) el.innerHTML = ''; if (fnD) fnD('chart-cons-risco', [u('M\u00e9dio'), u('Baixo'), u('Alto')], [nMon, nFlu + nRot, Math.max(1, nSan)], ['#f59e0b', '#10b981', '#ef4444']); },
                    function() { var el = document.getElementById('chart-cons-aging'); if (el) el.innerHTML = ''; if (fnD) fnD('chart-cons-aging', [u('Cr\u00edtico'), u('Aten\u00e7\u00e3o'), u('Normal'), u('Alerta')], [nSan, nMon, nFlu, Math.max(1, Math.floor(nRot/2))], ['#ef4444', '#f59e0b', '#10b981', '#0284c7']); },
                    function() { var el = document.getElementById('chart-cons-resp'); if (el) el.innerHTML = ''; if (fnB && d.chartRespLabels) fnB('chart-cons-resp', d.chartRespLabels.map(u), d.chartRespSeries); }
                ];
                tarefasGraficos.forEach(function(fnTarefa, idxG) {
                    setTimeout(fnTarefa, idxG * 18);
                });
            }
        } catch (e) {}
    };

// Sincronizar filtro de diretoria com OpenProject e GLPI
var _filtrarDirBase = window.filtrarPorDiretoriaSpAguas;
window.filtrarPorDiretoriaSpAguas = function(diretoria) {
    if (typeof _filtrarDirBase === 'function') _filtrarDirBase(diretoria);
    var selMacro = document.getElementById('op-filtro-macro');
    if (selMacro) {
        if (diretoria === 'todas') selMacro.value = '';
        else if (diretoria === 'spaguas-sf') selMacro.value = 'spaguas-sr';
        else if (diretoria === 'spaguas-sd') selMacro.value = 'spaguas-sh';
        else selMacro.value = diretoria;
        if (window.filtrarPortfolioOpenProject) window.filtrarPortfolioOpenProject();
    }
    if (window.filtrarTabelaGlpi) window.filtrarTabelaGlpi();
};


// >>> MÓDULO: src/js/modulos/03_openproject_tracks_pdtic.js <<<
// =========================================================================
// MÓDULO 03: PORTFÓLIO OPENPROJECT (500), TRACKS SA-GTI & PDTIC 2027-2030
// =========================================================================

(function() {
    // window.OP_PACOTES_OFICIAIS carregado de src/data/03_dados_openproject_500.js
    window.pilarSagtiAtivo = 'todos';
    window.eixoPdticAtivo = '';

    // Registrar as 3 novas abas na matriz RBAC para que todos os perfis as visualizem
    function registrarNovasAbasRBAC() {
        var novas = [
            { id: 'portfolio_openproject', nome: 'Portf\u00f3lio OpenProject (500)', desc: '29 Projetos e 500 Pacotes Oficiais' },
            { id: 'tracks_sagti', nome: 'SA-GTI: Tracks & Projetos', desc: 'Track 1 & Track 2, Sistemas DGD e Infra DIF' },
            { id: 'pdtic_eixos', nome: 'PDTIC 2027-2030 & KPIs', desc: '5 Eixos, 35 Iniciativas e 8 KPIs Oficiais' }
        ];
        if (window.ABAS_SISTEMA) {
            novas.forEach(function(na) {
                if (!window.ABAS_SISTEMA.some(function(a) { return a.id === na.id; })) {
                    window.ABAS_SISTEMA.push(na);
                }
            });
        }
        if (window.MATRIZ_PERMISSOES_PADRAO) {
            Object.keys(window.MATRIZ_PERMISSOES_PADRAO).forEach(function(perf) {
                novas.forEach(function(na) {
                    if (window.MATRIZ_PERMISSOES_PADRAO[perf].indexOf(na.id) === -1) {
                        window.MATRIZ_PERMISSOES_PADRAO[perf].push(na.id);
                    }
                });
            });
        }
    }

    function badgeTipo(tipo) {
        var map = {
            'Projeto': 'background:#dbeafe;color:#1e40af;',
            'Tarefas': 'background:#f1f5f9;color:#334155;',
            'Iniciativas': 'background:#ede9fe;color:#5b21b6;',
            'Marco': 'background:#fef3c7;color:#92400e;',
            'KPI': 'background:#dcfce7;color:#166534;',
            'Demandas': 'background:#e0f2fe;color:#0369a1;'
        };
        var st = map[tipo] || 'background:#f1f5f9;color:#475569;';
        return '<span style="padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;' + st + '">' + tipo + '</span>';
    }

    function badgeStatus(status) {
        var st = 'background:#f1f5f9;color:#475569;';
        if (status.indexOf('progresso') !== -1) st = 'background:#dcfce7;color:#166534;';
        else if (status.indexOf('espera') !== -1) st = 'background:#fef3c7;color:#92400e;';
        else if (status.indexOf('Novo') !== -1) st = 'background:#e0f2fe;color:#0369a1;';
        else if (status.indexOf('Encerrado') !== -1) st = 'background:#e2e8f0;color:#475569;';
        return '<span style="padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;' + st + '">' + status + '</span>';
    }

    window.inicializarFiltrosPortfolioOP = function() {
        var selProj = document.getElementById('op-filtro-projeto');
        var selResp = document.getElementById('op-filtro-resp');
        if (selProj && selProj.options.length <= 1) {
            var projs = [];
            window.OP_PACOTES_OFICIAIS.forEach(function(p) {
                if (p.projeto && projs.indexOf(p.projeto) === -1) projs.push(p.projeto);
            });
            projs.sort().forEach(function(pr) {
                var opt = document.createElement('option');
                opt.value = pr; opt.textContent = pr;
                selProj.appendChild(opt);
            });
        }
        if (selResp && selResp.options.length <= 1) {
            var resps = [];
            window.OP_PACOTES_OFICIAIS.forEach(function(p) {
                [p.atrib, p.autor, p.encarr].forEach(function(nome) {
                    if (nome && nome !== 'OpenProject' && resps.indexOf(nome) === -1) resps.push(nome);
                });
            });
            resps.sort().forEach(function(rNome) {
                var opt = document.createElement('option');
                opt.value = rNome; opt.textContent = rNome;
                selResp.appendChild(opt);
            });
        }
    };

    window.filtrarPortfolioOpenProject = function() {
        var tbody = document.getElementById('tbody-portfolio-openproject');
        if (!tbody) return;
        var fMacro = (document.getElementById('op-filtro-macro') || {}).value || '';
        var fProj = (document.getElementById('op-filtro-projeto') || {}).value || '';
        var fTipo = (document.getElementById('op-filtro-tipo') || {}).value || '';
        var fStatus = (document.getElementById('op-filtro-status') || {}).value || '';
        var fResp = (document.getElementById('op-filtro-resp') || {}).value || '';
        var fBusca = ((document.getElementById('op-filtro-busca') || {}).value || '').toLowerCase();

        var filtrados = window.OP_PACOTES_OFICIAIS.filter(function(p) {
            if (fMacro && p.macro !== fMacro) return false;
            if (fProj && p.projeto !== fProj) return false;
            if (fTipo && p.tipo.indexOf(fTipo) === -1) return false;
            if (fStatus && p.status.indexOf(fStatus) === -1) return false;
            if (fResp && p.atrib !== fResp && p.autor !== fResp && p.encarr !== fResp) return false;
            if (fBusca) {
                var blob = ('#' + p.id + ' ' + p.assunto + ' ' + p.projeto + ' ' + p.pai + ' ' + p.backlog).toLowerCase();
                if (blob.indexOf(fBusca) === -1) return false;
            }
            return true;
        });

        // Atualizar KPIs dinamicos da aba
        var elTot = document.getElementById('op-kpi-total');
        var elPrj = document.getElementById('op-kpi-projetos');
        var elPrg = document.getElementById('op-kpi-progresso');
        var elEsp = document.getElementById('op-kpi-espera');
        var elMrc = document.getElementById('op-kpi-marcos');
        if (elTot) elTot.innerText = filtrados.length;
        if (elPrj) elPrj.innerText = filtrados.filter(function(x) { return x.tipo === 'Projeto' || x.tipo === 'Iniciativas'; }).length;
        if (elPrg) elPrg.innerText = filtrados.filter(function(x) { return x.status.indexOf('progresso') !== -1; }).length;
        if (elEsp) elEsp.innerText = filtrados.filter(function(x) { return x.status.indexOf('espera') !== -1 || x.status.indexOf('gendado') !== -1; }).length;
        if (elMrc) elMrc.innerText = filtrados.filter(function(x) { return x.tipo === 'Marco' || x.tipo === 'KPI'; }).length;

        var lblCount = document.getElementById('op-contagem-filtrada');
        if (lblCount) lblCount.innerText = 'Exibindo ' + filtrados.length + ' de ' + window.OP_PACOTES_OFICIAIS.length + ' pacotes';

        tbody.innerHTML = filtrados.slice(0, 250).map(function(p) {
            var crono = (p.ini || p.fim) ? ((p.ini || '?') + ' \u2192 ' + (p.fim || '?')) : '<span style="color:#94a3b8;">Cont\u00ednuo</span>';
            var paiTxt = p.pai ? '<span style="color:#0369a1;font-weight:600;font-size:11px;">\u21b3 ' + p.pai + '</span>' : '<span style="color:#64748b;font-size:11px;">Raiz do Projeto</span>';
            return '<tr style="border-bottom:1px solid #f1f5f9;">' +
                '<td style="padding:8px 12px;font-weight:800;font-family:monospace;">' + (p.id ? ('<a href="https://projetos.spaguas.sp.gov.br/work_packages/' + p.id + '" target="_blank" rel="noopener noreferrer" style="color:#0070ba;text-decoration:underline;" title="Abrir Pacote no OpenProject Oficial">#' + p.id + '</a>') : '<span style="color:#94a3b8;">#REF</span>') + '</td>' +
                '<td style="padding:8px 12px;font-weight:600;color:#334155;">' + p.projeto + '</td>' +
                '<td style="padding:8px 12px;">' + badgeTipo(p.tipo) + '</td>' +
                '<td style="padding:8px 12px;font-weight:700;color:#0f172a;">' + p.assunto + '</td>' +
                '<td style="padding:8px 12px;">' + paiTxt + '</td>' +
                '<td style="padding:8px 12px;">' + badgeStatus(p.status) + '</td>' +
                '<td style="padding:8px 12px;color:#475569;font-size:11.5px;">\ud83d\udc64 ' + (p.atrib || p.autor || 'SP-\u00c1guas') + '</td>' +
                '<td style="padding:8px 12px;text-align:center;font-size:11px;color:#475569;white-space:nowrap;">' + crono + '</td>' +
                '</tr>';
        }).join('');
    };

        window.filtrarPilarSagti = function(pilar) {
        window.pilarSagtiAtivo = pilar || 'todos';
        var tbody = document.getElementById('tbody-tracks-sagti');
        if (!tbody) return;

        var busca = ((document.getElementById('sagti-filtro-busca') || {}).value || '').toLowerCase().trim();

        var itensGti = window.OP_PACOTES_OFICIAIS.filter(function(p) {
            if (p.projeto !== 'SA-GTI - Gerência de TI' && p.projeto !== 'Divisão de Infraestrutura') return false;
            
            var respNome = (p.encarr || p.atrib || p.autor || '');
            var isLuiz = respNome.indexOf('Luiz') !== -1 || (p.autor || '').indexOf('Luiz') !== -1;

            if (pilar === 'luiz' && !isLuiz) return false;
            if (pilar === '1231' && (p.pai || '').indexOf('1231') === -1 && String(p.id) !== '1231') return false;
            if (pilar === '1232' && (p.pai || '').indexOf('1232') === -1 && String(p.id) !== '1232') return false;
            if (pilar === 'A-018' && (p.backlog || '').indexOf('A-018') === -1) return false;
            if (pilar === 'A-017' && (p.backlog || '').indexOf('A-017') === -1 && p.projeto !== 'Divisão de Infraestrutura') return false;
            if (pilar === 'A-016' && (p.backlog || '').indexOf('A-016') === -1) return false;

            if (busca) {
                var txt = ('#' + p.id + ' ' + (p.backlog || '') + ' ' + (p.assunto || '') + ' ' + respNome + ' ' + (p.pai || '') + ' ' + (p.status || '')).toLowerCase();
                if (txt.indexOf(busca) === -1) return false;
            }
            return true;
        });

        var cnt = document.getElementById('sagti-tracks-count');
        if (cnt) cnt.innerText = 'Exibindo ' + itensGti.length + ' de 97 pacotes SA-GTI';

        tbody.innerHTML = itensGti.map(function(p) {
            var bgTag = p.backlog ? p.backlog.split('.')[0] : (p.projeto === 'Divisão de Infraestrutura' ? 'DIF-INFRA' : 'SA-GTI');
            var corBg = bgTag.indexOf('A-018') !== -1 ? 'background:#dbeafe;color:#1e40af;' : (bgTag.indexOf('A-017') !== -1 || bgTag === 'DIF-INFRA' ? 'background:#ede9fe;color:#5b21b6;' : 'background:#dcfce7;color:#166534;');
            var respNome = (p.encarr || p.atrib || p.autor || 'SA-GTI');
            var isLuiz = respNome.indexOf('Luiz') !== -1 || (p.autor || '').indexOf('Luiz') !== -1;
            
            return '<tr style="border-bottom:1px solid #f1f5f9;' + (isLuiz ? 'background:#f0fdf4;' : '') + '">' +
                '<td style="padding:8px 12px;font-weight:800;font-family:monospace;">' +
                    '<a href="https://projetos.spaguas.sp.gov.br/work_packages/' + p.id + '" target="_blank" style="color:#0056d2;text-decoration:none;" title="Abrir Pacote #' + p.id + ' no OpenProject">#' + p.id + ' &#8599;</a>' +
                '</td>' +
                '<td style="padding:8px 12px;"><span style="padding:2px 8px;border-radius:8px;font-size:11px;font-weight:700;' + corBg + '">' + (p.backlog || p.projeto) + '</span></td>' +
                '<td style="padding:8px 12px;">' + badgeTipo(p.tipo) + '</td>' +
                '<td style="padding:8px 12px;font-weight:700;color:#0f172a;">' + p.assunto + '</td>' +
                '<td style="padding:8px 12px;font-size:11px;color:#0369a1;font-weight:600;">' + (p.pai || 'Raiz SA-GTI') + '</td>' +
                '<td style="padding:8px 12px;">' + badgeStatus(p.status) + '</td>' +
                '<td style="padding:8px 12px;font-weight:600;color:#334155;">' + (isLuiz ? '👑 ' : '👤 ') + respNome + '</td>' +
                '<td style="padding:8px 12px;text-align:center;font-size:11px;color:#475569;">' + (p.fim || p.ini || 'Contínuo') + '</td>' +
                '</tr>';
        }).join('');
    };

    window.filtrarEixoPdtic = function(eixo) {
        window.eixoPdticAtivo = eixo || '';
        var gridKpis = document.getElementById('grid-kpis-pdtic-oficial');
        var tbody = document.getElementById('tbody-pdtic-iniciativas');
        
        if (gridKpis && gridKpis.innerHTML.trim() === '') {
            var kpis = window.OP_PACOTES_OFICIAIS.filter(function(p) { return p.tipo === 'KPI'; });
            gridKpis.innerHTML = kpis.map(function(k) {
                return '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-left:4px solid #4f46e5;border-radius:6px;padding:10px;">' +
                    '<div style="font-size:10.5px;font-weight:800;color:#4f46e5;">' +
                        '<a href="https://projetos.spaguas.sp.gov.br/work_packages/' + k.id + '" target="_blank" style="color:#4f46e5;text-decoration:none;" title="Abrir KPI #' + k.id + ' no OpenProject">#' + k.id + ' &#8599;</a> • INDICADOR OFICIAL' +
                    '</div>' +
                    '<div style="font-size:12px;font-weight:700;color:#0f172a;margin:4px 0;">' + k.assunto + '</div>' +
                    '<div style="font-size:11px;color:#64748b;line-height:1.35;">' + (k.desc || 'Monitoramento contínuo PDTIC') + '</div>' +
                    '</div>';
            }).join('');
        }
        if (!tbody) return;

        var busca = ((document.getElementById('pdtic-filtro-busca') || {}).value || '').toLowerCase().trim();

        var inics = window.OP_PACOTES_OFICIAIS.filter(function(p) {
            if (p.tipo !== 'Iniciativas') return false;
            if (eixo && p.projeto.indexOf(eixo) === -1) return false;
            if (busca) {
                var txt = ('#' + p.id + ' ' + (p.projeto || '') + ' ' + (p.assunto || '') + ' ' + (p.atrib || '') + ' ' + (p.prio || '')).toLowerCase();
                if (txt.indexOf(busca) === -1) return false;
            }
            return true;
        });

        var cnt = document.getElementById('pdtic-inic-count');
        if (cnt) cnt.innerText = 'Exibindo ' + inics.length + ' de 35 iniciativas oficiais';

        tbody.innerHTML = inics.map(function(i) {
            var isLuiz = (i.atrib || '').indexOf('Luiz') !== -1;
            var prioColor = i.prio === 'Imediata' || i.prio.indexOf('Alt') !== -1 ? 'background:#fee2e2;color:#991b1b;' : 'background:#e0f2fe;color:#0369a1;';
            return '<tr style="border-bottom:1px solid #f1f5f9;' + (isLuiz ? 'background:#f0fdf4;' : '') + '">' +
                '<td style="padding:8px 12px;font-weight:800;font-family:monospace;">' +
                    '<a href="https://projetos.spaguas.sp.gov.br/work_packages/' + i.id + '" target="_blank" style="color:#4338ca;text-decoration:none;" title="Abrir Iniciativa #' + i.id + ' no OpenProject">#' + i.id + ' &#8599;</a>' +
                '</td>' +
                '<td style="padding:8px 12px;font-weight:700;color:#4338ca;">' + i.projeto + '</td>' +
                '<td style="padding:8px 12px;font-weight:700;color:#0f172a;">' + i.assunto + '</td>' +
                '<td style="padding:8px 12px;"><span style="padding:2px 8px;border-radius:8px;font-size:11px;font-weight:700;' + prioColor + '">' + i.prio + '</span></td>' +
                '<td style="padding:8px 12px;font-size:11.5px;color:#334155;">' + (isLuiz ? '👑 <strong>Luiz Antonio</strong> (SA-GTI)' : ('👤 ' + (i.atrib || i.autor || 'SA-GTI'))) + '</td>' +
                '<td style="padding:8px 12px;text-align:center;font-size:11px;color:#475569;">' + ((i.ini || '2027') + ' → ' + (i.fim || '2030')) + '</td>' +
                '</tr>';
        }).join('');
    };

    })();


// >>> MÓDULO: src/js/modulos/04_gestao_glpi.js <<<
// =========================================================================
// MÓDULO 04: ESPELHO DO DASHBOARD GLPI 10, FILAS ITSM & HANDOVER N2
// =========================================================================

    // BASE OFICIAL: EXATAMENTE OS 13 CHAMADOS NAO SOLUCIONADOS (6 ATRASADOS)
    window.CHAMADOS_GLPI_REAIS = [
