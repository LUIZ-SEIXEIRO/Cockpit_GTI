// >>> MÓDULO: src/data/01_logo_spaguas.js <<<
// =========================================================================
// DADOS 01: LOGOTIPO INSTITUCIONAL SP-ÁGUAS (FONTE ÚNICA DESDUPLICADA)
// =========================================================================
window.SPAGUAS_LOGO_B64 = "data:image/png;base64,";
window.hidratarLogosSpAguas = function() {
    if (!window.SPAGUAS_LOGO_B64) return;
    var fav = document.getElementById("favicon-spaguas");
    if (fav && fav.getAttribute("href") !== window.SPAGUAS_LOGO_B64) fav.setAttribute("href", window.SPAGUAS_LOGO_B64);
    document.querySelectorAll('img[data-spaguas-logo="1"]').forEach(function(img) {
        if (img.getAttribute("src") !== window.SPAGUAS_LOGO_B64) img.setAttribute("src", window.SPAGUAS_LOGO_B64);
    });
};
document.addEventListener("DOMContentLoaded", window.hidratarLogosSpAguas);


