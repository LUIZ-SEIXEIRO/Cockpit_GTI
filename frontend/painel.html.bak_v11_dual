window.silenciarTodosPopupsAssistente = function() {
    ['assistente-flutuante-widget', 'assistente-flutuante-toast', 'btn-assistente-flutuante',
     'modal-assistente-contextual', 'ai-drawer', 'ai-drawer-overlay', 'mascote-widget', 'sidebar-supervisor-footer'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) {
            el.style.setProperty('display', 'none', 'important');
            el.style.setProperty('visibility', 'hidden', 'important');
            el.style.setProperty('pointer-events', 'none', 'important');
        }
    });
    if (window.toastTimer) clearTimeout(window.toastTimer);
};

window.addEventListener('DOMContentLoaded', function() {
    try { if (window.hidratarLogosSpAguas) window.hidratarLogosSpAguas(); } catch (e) {}
    try { window.silenciarTodosPopupsAssistente(); } catch (e) {}
    try { if (window.carregarPermissoes) window.carregarPermissoes(); } catch (e) {}
    try { if (window.inicializarGraficos) window.inicializarGraficos(); } catch (e) {}
