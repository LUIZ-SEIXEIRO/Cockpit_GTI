<!-- MODAL CRUD DE CADERNOS TEMÁTICOS -->
<div id="modal-caderno-crud" class="modal-overlay" style="display: none;">
    <div class="modal-card" style="width: 750px;">
        <div class="modal-header">
            <h3 id="modal-caderno-titulo" style="font-size: 14px;">➕ Novo Caderno Temático</h3>
            <button onclick="window.fecharModalCaderno()" style="background:none; border:none; color:white; font-size:18px; cursor:pointer;">✕</button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="caderno-edit-id">
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div>
                    <label style="font-weight: 700; font-size: 11px; color: #475569; display: block; margin-bottom: 4px;">Título do Caderno:</label>
                    <input type="text" id="caderno-input-titulo" placeholder="Ex: Manual de Pesquisa de Preços da SA-GTI" style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px;">
                </div>
                <div>
                    <label style="font-weight: 700; font-size: 11px; color: #475569; display: block; margin-bottom: 4px;">Categoria / Ícone:</label>
                    <select id="caderno-input-icone" style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px;">
                        <option value="📘">📘 Governança & PDTIC</option>
                        <option value="⚖️">⚖️ Legislação & Contratações</option>
                        <option value="🏛️">🏛️ Órgãos de Controle (TCE/TCU)</option>
                        <option value="🛡️">🛡️ Segurança da Informação</option>
                        <option value="🌐">🌐 Infraestrutura & Nuvem</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 12px;">
                <label style="font-weight: 700; font-size: 11px; color: #475569; display: block; margin-bottom: 4px;">Descrição Sintética:</label>
                <input type="text" id="caderno-input-desc" placeholder="Resumo em uma linha para o índice..." style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px;">
            </div>

            <div>
                <label style="font-weight: 700; font-size: 11px; color: #475569; display: block; margin-bottom: 4px;">Conteúdo Integral do Caderno (HTML ou Texto Rico):</label>
                <textarea id="caderno-input-conteudo" rows="12" style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px; font-family: monospace; line-height: 1.5;"></textarea>
                <span style="font-size: 10.5px; color: #64748b;">Suporta tags HTML como &lt;h3&gt;, &lt;p&gt;, &lt;ul&gt;, &lt;li&gt;, &lt;strong&gt;, &lt;table&gt;.</span>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" onclick="window.fecharModalCaderno()">Cancelar</button>
            <button class="btn btn-primary" onclick="window.salvarCaderno()">💾 Salvar Caderno</button>
        </div>
    </div>
</div>








    


