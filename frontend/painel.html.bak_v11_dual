                        .header-meta { font-size: 12px; color: #64748b; margin-bottom: 24px; }
                        table { width: 100%; border-collapse: collapse; margin-top: 14px; font-size: 12px; }
                        th, td { border: 1px solid #cbd5e1; padding: 8px; text-align: left; }
