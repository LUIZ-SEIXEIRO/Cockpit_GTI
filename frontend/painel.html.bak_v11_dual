    window.filtroGlpiAtrasadosApenas = false;

    window.filtrarStatusGlpi = function(modo) {
        window.filtroGlpiAtrasadosApenas = (modo === 'atrasados');
        var btnTodos = document.getElementById('btn-glpi-filtro-todos');
        var btnAtras = document.getElementById('btn-glpi-filtro-atrasados');
        if (btnTodos && btnAtras) {
            if (window.filtroGlpiAtrasadosApenas) {
                btnTodos.className = 'btn btn-secondary';
                btnAtras.className = 'btn btn-primary';
                btnAtras.style.background = '#dc2626';
                btnAtras.style.color = '#fff';
            } else {
                btnTodos.className = 'btn btn-primary';
                btnAtras.className = 'btn btn-secondary';
                btnAtras.style.background = '#fef2f2';
                btnAtras.style.color = '#991b1b';
            }
        }
        window.filtrarTabelaGlpi();
    };

    window.filtrarTabelaGlpi = function() {
        var base = (window.GLPI_TICKETS_REAIS && window.GLPI_TICKETS_REAIS.length > 0) ? window.GLPI_TICKETS_REAIS : window.CHAMADOS_GLPI_REAIS;
        var tbody = document.getElementById('tbody-gestao-glpi');
        if (!tbody) return;

        var filaSel = (document.getElementById('glpi-filtro-fila') || {}).value || '';
        var tipoSel = (document.getElementById('glpi-filtro-tipo') || {}).value || '';
        var busca = ((document.getElementById('glpi-filtro-busca') || {}).value || '').toLowerCase().trim();

        var filtrados = base.filter(function(t) {
            if (window.filtroGlpiAtrasadosApenas && !t.atrasado) return false;
            if (filaSel && t.fila.indexOf(filaSel) === -1) return false;
            if (tipoSel && t.tipo.indexOf(tipoSel) === -1) return false;
            if (busca) {
                var str = ('#' + t.id + ' ' + t.solicitante + ' ' + t.titulo + ' ' + t.categoria + ' ' + t.tecnico + ' ' + t.fila).toLowerCase();
                if (str.indexOf(busca) === -1) return false;
            }
            return true;
        });

        var cntEl = document.getElementById('glpi-contagem-filtrada');
        if (cntEl) cntEl.innerText = 'Exibindo ' + filtrados.length + ' de ' + base.length + ' chamados no escopo';

        var badgeNav = document.getElementById('badge-nav-glpi') || document.querySelector('#sidebar .nav-item[data-tab="gestao_glpi"] .nav-badge');
        if (badgeNav) badgeNav.innerText = String(base.length);

        tbody.innerHTML = filtrados.map(function(t) {
            var badgeSla = t.atrasado 
                ? '<span style="background:#fee2e2;color:#991b1b;padding:3px 10px;border-radius:12px;font-weight:800;font-size:11px;display:inline-flex;align-items:center;gap:4px;">&#9888;&#65039; ' + t.sla + '</span>'
                : '<span style="background:#dcfce7;color:#166534;padding:3px 10px;border-radius:12px;font-weight:700;font-size:11px;">&#1410;&#65039; ' + t.sla + '</span>';

            var corTipo = t.tipo.indexOf('Incidente') !== -1 ? '#dc2626' : '#0284c7';
            var badgeStatus = t.status.indexOf('Novo') !== -1 
                ? '<span style="background:#e0f2fe;color:#0369a1;padding:2px 8px;border-radius:10px;font-weight:700;font-size:10.5px;">Novo (N1)</span>'
                : (t.status.indexOf('Aguardando') !== -1 
                    ? '<span style="background:#fef3c7;color:#92400e;padding:2px 8px;border-radius:10px;font-weight:700;font-size:10.5px;">Aguardando</span>'
                    : '<span style="background:#dbeafe;color:#1d4ed8;padding:2px 8px;border-radius:10px;font-weight:700;font-size:10.5px;">Em Atendimento</span>');

            return '<tr style="border-bottom:1px solid #f1f5f9;">' +
                '<td style="padding:10px 12px;font-weight:800;font-family:monospace;">' +
                    '<a href="https://atendimento.spaguas.sp.gov.br/front/ticket.form.php?id=' + t.id + '" target="_blank" style="color:#0056d2;text-decoration:none;" title="Abrir no GLPI Oficial">#' + t.id + ' &#8599;</a>' +
                '</td>' +
                '<td style="padding:10px 12px;font-weight:600;color:#1e293b;">' + window.escapeHtml(t.solicitante) + '</td>' +
                '<td style="padding:10px 12px;"><span style="background:' + corTipo + ';color:#fff;padding:2px 8px;border-radius:4px;font-size:10.5px;font-weight:700;">' + window.escapeHtml(t.tipo) + '</span></td>' +
                '<td style="padding:10px 12px;">' +
                    '<div style="font-weight:700;color:#0f172a;font-size:12px;">' + window.escapeHtml(t.titulo) + '</div>' +
                    '<div style="font-size:10.5px;color:#64748b;margin-top:2px;">&#128194; ' + window.escapeHtml(t.categoria) + ' &bull; ' + window.escapeHtml(t.urgencia) + '</div>' +
                '</td>' +
                '<td style="padding:10px 12px;">' +
                    '<div style="font-weight:700;color:#1e293b;font-size:11.5px;">' + window.escapeHtml(t.fila) + '</div>' +
                    '<div style="font-size:10.5px;color:#475569;">&#128100; ' + window.escapeHtml(t.tecnico) + '</div>' +
                '</td>' +
                '<td style="padding:10px 12px;">' + badgeStatus + '</td>' +
                '<td style="padding:10px 12px;text-align:center;">' + badgeSla + '</td>' +
                '<td style="padding:10px 12px;font-size:11px;color:#334155;max-width:280px;">' + window.escapeHtml(t.acao) + '</td>' +
            '</tr>';
        }).join('');
    };

    window.sincronizarEspelhoGlpi = async function(btn) {
        var orig = btn ? btn.innerHTML : '';
        if (btn) btn.innerHTML = '&#1416; Conectando GLPI Oficial...';
        var badge = document.getElementById('glpi-status-badge');
        var t0 = performance.now();
        try {
            var r = await fetch('/api/v1/glpi/dashboard_real');
            var lat = Math.round(performance.now() - t0);
            if (r.ok) {
                var dados = await r.json();
                if (dados.tickets && dados.tickets.length > 0) {
                    window.GLPI_TICKETS_REAIS = dados.tickets.map(function(t) {
                        return {
                            id: t.id,
                            solicitante: t.solicitante || 'Central GLPI',
                            tipo: t.urgency >= 4 ? 'Incidente ITSM' : 'Requisição de Serviço',
                            titulo: t.titulo || 'Chamado GLPI',
                            categoria: t.categoria || 'Geral',
                            fila: t.fila || 'SA-GTI',
                            tecnico: t.tecnico || 'Equipe N2',
                            status: t.status === 1 ? 'Novo' : 'Em Atendimento',
                            atrasado: t.atrasado || false,
                            urgencia: 'Urgência ' + (t.urgency || 3),
                            sla: t.atrasado ? 'Atrasado' : 'No Prazo',
                            acao: 'Acompanhamento na Central GLPI Oficial'
                        };
                    });
                }
                if (document.getElementById('glpi-real-naosol')) document.getElementById('glpi-real-naosol').innerText = String(dados.nao_solucionados || 13);
                if (document.getElementById('glpi-real-atrasados')) document.getElementById('glpi-real-atrasados').innerText = String(dados.atrasados || 6);
                if (document.getElementById('glpi-real-problemas')) document.getElementById('glpi-real-problemas').innerText = String(dados.problemas || 16);
                if (document.getElementById('glpi-real-mudanca')) document.getElementById('glpi-real-mudanca').innerText = String(dados.mudancas || 1);
                if (document.getElementById('glpi-real-monitores')) document.getElementById('glpi-real-monitores').innerText = String(dados.monitores || 436);
                if (document.getElementById('glpi-real-computadores')) document.getElementById('glpi-real-computadores').innerText = String(dados.computadores || 443);
                if (document.getElementById('glpi-real-impressoras')) document.getElementById('glpi-real-impressoras').innerText = String(dados.impressoras || 30);
                if (document.getElementById('glpi-real-rede')) document.getElementById('glpi-real-rede').innerText = String(dados.rede || 0);

                if (badge) badge.innerHTML = '&#128994; GLPI 10 Online (' + (dados.nao_solucionados || 13) + ' chamados &bull; ' + lat + 'ms)';
            }
        } catch(e) {}
        window.filtrarTabelaGlpi();
        if (btn) {
            btn.innerHTML = '&#9989; GLPI Sincronizado';
            setTimeout(function() { btn.innerHTML = orig; }, 2000);
        }
    };

    window.gerarResumoHandoverGlpi = function() {
        var box = document.getElementById('glpi-painel-handover');
        var cont = document.getElementById('glpi-handover-conteudo');
        if (!box || !cont) return;
        var base = (window.GLPI_TICKETS_REAIS && window.GLPI_TICKETS_REAIS.length > 0) ? window.GLPI_TICKETS_REAIS : window.CHAMADOS_GLPI_REAIS;
        var criticos = base.filter(function(t) { return t.atrasado; });
        cont.innerHTML = criticos.map(function(c) {
            return '<div style="background:#ffffff;border:1px solid #fca5a5;border-radius:6px;padding:10px 12px;">' +
                '<div style="display:flex;justify-content:space-between;font-weight:800;color:#991b1b;margin-bottom:4px;">' +
                    '<span>Ticket #' + c.id + ' (' + window.escapeHtml(c.fila) + ')</span>' +
                    '<span style="color:#dc2626;font-size:11px;">&#9888;&#65039; ' + window.escapeHtml(c.sla) + '</span>' +
                '</div>' +
                '<div style="font-weight:700;color:#1e293b;margin-bottom:4px;font-size:11.5px;">' + window.escapeHtml(c.titulo) + '</div>' +
                '<div style="font-size:11px;color:#047857;"><strong>A&ccedil;&atilde;o N2:</strong> ' + window.escapeHtml(c.acao) + '</div>' +
            '</div>';
        }).join('');
        box.style.display = 'block';
    };

// MÓDULO 05: VISÃO ESTRATÉGICA, FARÓIS DE CRITICIDADE & CHECKPOINTS SEI
// =========================================================================

window.modoFarolAtivo = 'todos';

    window.filtrarModoFarol = function(modo) {
        window.modoFarolAtivo = modo;
        document.querySelectorAll('.pill-filtro-farol').forEach(b => {
            b.className = 'btn btn-secondary pill-filtro-farol';
        });
        const btnAtivo = document.getElementById('btn-filtro-' + modo);
        if (btnAtivo) btnAtivo.className = 'btn btn-primary pill-filtro-farol';

        const tag = document.getElementById('tag-filtro-ativo');
        let label = 'Todos os Faróis';
        if (modo === 'vermelho') label = '🔴 Intervenção Imediata';
        else if (modo === 'laranja') label = '🟠 Saneamento Prioritário';
        else if (modo === 'amarelo') label = '🟡 Monitoramento Ativo';
        else if (modo === 'verde') label = '🟢 Fluxo Normal';

        if (tag) tag.innerText = label;
        window.renderizarTabelaEstrategica();
    };

    window.renderizarTabelaEstrategica = function() {
        const tbody = document.getElementById('tbody-visao-estrategica');
        if (!tbody || typeof PROCESSOS === 'undefined') return;

        let filtrados = PROCESSOS.filter(p => {
            const farol = p.Farol_Criticidade || '';
            const risco = p.Classificacao_Risco || '';
            const isEstrategico = (p.Eixo_Gestao === 'Portfólio Estratégico') || farol.includes('1') || farol.includes('2') || farol.includes('3') || farol.includes('4');
            if (!isEstrategico) return false;

            if (window.modoFarolAtivo === 'vermelho') return farol.includes('1') || risco.includes('Crítico');
            if (window.modoFarolAtivo === 'laranja') return farol.includes('2');
            if (window.modoFarolAtivo === 'amarelo') return farol.includes('3');
            if (window.modoFarolAtivo === 'verde') return farol.includes('4');
            return true;
        });

        const tit = document.getElementById('titulo-tabela-estrategica');
        if (tit) tit.innerText = `Processos Filtrados (${filtrados.length})`;

        tbody.innerHTML = filtrados.map(p => {
            const obs = (p.Observacao_Texto || '') + ' ' + (p.Marcadores_Institucionais || '');
            let custodia = '<span class="pill-tag pill-blue">🏢 Interno (SA-GTI)</span>';
            if (obs.toLowerCase().includes('parecer') || obs.toLowerCase().includes('externo') || obs.toLowerCase().includes('cj') || obs.toLowerCase().includes('tce')) {
                custodia = '<span class="pill-tag pill-orange">⚖️ Externo (CJ / TCE)</span>';
            } else if (obs.toLowerCase().includes('cotação') || obs.toLowerCase().includes('fornecedor') || obs.toLowerCase().includes('proposta')) {
                custodia = '<span class="pill-tag pill-yellow">💼 Externo (Mercado)</span>';
            } else if (obs.toLowerCase().includes('bacia') || obs.toLowerCase().includes('solicita') || obs.toLowerCase().includes('atendimento')) {
                custodia = '<span class="pill-tag pill-gray">🌊 Externo (Bacia/Demandante)</span>';
            }

            let farolTag = '<span class="pill-tag pill-green">🟢 4 - Normal</span>';
            if (p.Farol_Criticidade.includes('1')) farolTag = '<span class="pill-tag pill-red">🔴 1 - Intervenção</span>';
            else if (p.Farol_Criticidade.includes('2')) farolTag = '<span class="pill-tag pill-orange">🟠 2 - Saneamento</span>';
            else if (p.Farol_Criticidade.includes('3')) farolTag = '<span class="pill-tag pill-yellow">🟡 3 - Monitoramento</span>';

            return `
                <tr>
                    <td style="font-family: monospace; font-weight: 700;"><a href="javascript:void(0)" onclick="window.abrirDetalhesProcesso('${p.ID_Processo}')" style="color: #0544cf; text-decoration: underline; cursor: pointer;" title="Clique para abrir Dossiê e Timeline">${p.ID_Processo}</a></td>
                    <td style="max-width: 320px; line-height: 1.4;">${p.Especificacao}</td>
                    <td>${p.Responsavel_Tecnico || '<span style="color:#94a3b8;">Não atribuído</span>'}</td>
                    <td>${farolTag}</td>
                    <td style="font-weight: 700; text-align: center;">${p.Dias_Ultima_Mov}d</td>
                    <td>${custodia}</td>
                    <td>
                        <button class="btn btn-secondary" style="padding: 3px 8px; font-size: 11px;" onclick="window.abrirModalCheckpointComProc('${p.ID_Processo}')">📧 Checkpoint</button>
                    </td>
                </tr>
            `;
        }).join('');
    };

    window.exportarRelatorioEstrategico = function() {
        window.print();
    };

    window.abrirModalCheckpointComProc = function(procId) {
        if (typeof window.abrirModalCheckpoint === 'function') {
            window.abrirModalCheckpoint();
            const sel = document.getElementById('cp-proc-select');
            if (sel) {
                sel.value = procId;
                if (typeof window.atualizarMinutaCheckpoint === 'function') window.atualizarMinutaCheckpoint();
            }
        }
    };

    window.inicializarPuxadorEsteira = function() {
        const sel = document.getElementById('puxar-proc-esteira-select');
        if (!sel || typeof PROCESSOS === 'undefined') return;
        if (sel.options.length <= 1) {
            PROCESSOS.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.ID_Processo;
                opt.text = `${p.ID_Processo} — ${p.Especificacao.slice(0, 50)}...`;
                sel.appendChild(opt);
            });
        }
    };

    window.puxarProcessoIndividualParaChat = function() {
        const sel = document.getElementById('puxar-proc-esteira-select');
        if (!sel || !sel.value) return;
        const proc = PROCESSOS.find(p => p.ID_Processo === sel.value);
        if (!proc) return;
        window.processoAtivoChat = proc;

        const chat = document.getElementById('chat-messages');
        if (chat) {
            chat.innerHTML += `
                <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-left: 4px solid #0544cf; padding: 12px; border-radius: 8px; font-size: 12px; color: #1e3a8a; margin-top: 6px;">
                    <strong>📥 Processo Carregado para Contexto da IA:</strong><br>
                    • <strong>SEI:</strong> ${proc.ID_Processo} | <strong>Aging:</strong> ${proc.Dias_Ultima_Mov} dias (${proc.Faixa_Aging})<br>
                    • <strong>Objeto:</strong> ${proc.Especificacao}<br>
                    • <strong>Responsável Técnico:</strong> ${proc.Responsavel_Tecnico || 'Não atribuído'}<br>
                    • <strong>Bucket OpenProject:</strong> ${proc.Bucket_OpenProject}<br>
                    • <strong>Farol de Criticidade:</strong> ${proc.Farol_Criticidade}
                </div>
            `;
            chat.scrollTop = chat.scrollHeight;
        }

        if (typeof definirEstadoMascote === 'function') {
            definirEstadoMascote('thinking', `Analisando processo ${proc.ID_Processo}...`);
            setTimeout(() => {
                definirEstadoMascote('success', 'Contexto do processo pronto para instrução!');
                setTimeout(() => definirEstadoMascote('idle', 'Vigilante'), 2500);
            }, 1200);
        }
    };

    window.puxarLoteTecnicoParaChat = function() {
        const sel = document.getElementById('puxar-tecnico-esteira-select');
        if (!sel || !sel.value) return;
        const tecnico = sel.value;
        const lista = PROCESSOS.filter(p => (p.Responsavel_Tecnico || '').includes(tecnico.split(' ')[0]));

        const chat = document.getElementById('chat-messages');
        if (chat) {
            chat.innerHTML += `
                <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 4px solid #16a34a; padding: 12px; border-radius: 8px; font-size: 12px; color: #14532d; margin-top: 6px;">
                    <strong>👥 Portfólio Carregado: ${tecnico} (${lista.length} processos ativos):</strong><br>
                    ${lista.map(p => `• <strong>${p.ID_Processo}</strong> (${p.Dias_Ultima_Mov}d): ${p.Especificacao.slice(0, 45)}... [${p.Farol_Criticidade}]`).join('<br>')}
                </div>
            `;
            chat.scrollTop = chat.scrollHeight;
        }

        if (typeof definirEstadoMascote === 'function') {
            definirEstadoMascote('thinking', `Consolidando ${lista.length} processos de ${tecnico}...`);
            setTimeout(() => {
                definirEstadoMascote('success', 'Análise de carteira de técnico concluída!');
                setTimeout(() => definirEstadoMascote('idle', 'Vigilante'), 2500);
            }, 1400);
        }
    };


// >>> MÓDULO: src/js/modulos/06_gestao_agil_kanban.js <<<
// =========================================================================
// MÓDULO 06: GESTÃO ÁGIL, SPRINT PLANNING, KANBAN DRAG-AND-DROP & POST-ITS
// =========================================================================

// ==========================================
    // CRONÔMETRO / TIMEBOX DA SPRINT
    // ==========================================
    function inicializarSprintTimer() {
        atualizarDisplaySprint();
        setInterval(atualizarDisplaySprint, 60000);
    }

    function atualizarDisplaySprint() {
        const elNome = document.getElementById('sprint-nome-display');
        const elDatas = document.getElementById('sprint-datas-display');
        const elTimer = document.getElementById('sprint-timer-txt');
        const elWarroom = document.getElementById('sprint-timer-warroom');
        const elBar = document.getElementById('sprint-progress-bar');
        const elPct = document.getElementById('sprint-pct-txt');
        const elMeta = document.getElementById('sprint-meta-txt');

        if (!elNome || !elTimer) return;

        elNome.innerText = `🏃 ${sprintConfig.nome.toUpperCase()}`;
        elDatas.innerText = `Ciclo: ${formatarDataBR(sprintConfig.inicio)} a ${formatarDataBR(sprintConfig.fim)}`;
        if (elMeta) elMeta.innerText = `Meta: ${sprintConfig.meta}`;

        const agora = new Date();
        const dInicio = new Date(sprintConfig.inicio + 'T00:00:00');
        const dFim = new Date(sprintConfig.fim + 'T23:59:59');

        const totalMs = dFim - dInicio;
        const decorridoMs = agora - dInicio;
        let pct = Math.round((decorridoMs / totalMs) * 100);
        if (pct < 0) pct = 0;
        if (pct > 100) pct = 100;

        const restanteMs = dFim - agora;
        let txtRestante = "";
        if (restanteMs > 0) {
            const dias = Math.floor(restanteMs / (1000 * 60 * 60 * 24));
            const horas = Math.floor((restanteMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            txtRestante = `⏳ Faltam ${dias} dias e ${horas}h para a Sprint Review`;
        } else {
            txtRestante = "🏁 Sprint Finalizada (Em fase de Review / Retrospectiva)";
        }

        elTimer.innerText = txtRestante;
        if (elWarroom) elWarroom.innerText = txtRestante;
        if (elBar) elBar.style.width = pct + '%';
        if (elPct) elPct.innerText = `${pct}% do tempo decorrido (${Math.round(totalMs / (1000 * 60 * 60 * 24))} dias totais)`;
    }

    function formatarDataBR(dStr) {
        if (!dStr) return '';
        const p = dStr.split('-');
        if (p.length === 3) return `${p[2]}/${p[1]}/${p[0]}`;
        return dStr;
    }

    
    window.abrirModalSprint = function() {
        if (typeof abrirConfigSprint === 'function') {
            abrirConfigSprint();
        } else {
            const m = document.getElementById('modal-sprint');
            if (m) m.style.display = 'flex';
        }
    };
    window.abrirConfigSprint = window.abrirModalSprint;
    function abrirModalSprint() { window.abrirModalSprint(); }

    
    // Ajuste dinâmico de cadência no modal da Sprint
    window.ajustarCadenciaSprintModal = function(cadencia) {
        const inpInicio = document.getElementById('cfg-sprint-inicio');
        const inpFim = document.getElementById('cfg-sprint-fim');
        const inpNome = document.getElementById('cfg-sprint-nome');
        if (!inpInicio || !inpFim) return;

        let dataBase = inpInicio.value ? new Date(inpInicio.value + 'T00:00:00') : new Date();
        let dias = 15;
        let prefixo = 'Sprint Quinzenal';

        if (cadencia === 'semanal') {
            dias = 7;
            prefixo = 'Sprint Semanal';
        } else if (cadencia === 'mensal') {
            dias = 30;
            prefixo = 'Sprint Mensal';
        } else if (cadencia === 'custom') {
            return;
        }

        const dataFim = new Date(dataBase.getTime() + (dias * 24 * 60 * 60 * 1000));
        inpFim.value = dataFim.toISOString().slice(0, 10);
        
        if (inpNome && !inpNome.value.includes('—')) {
            inpNome.value = `${prefixo} 01/2026 — Modernização & ETPs`;
        }
    };

    function abrirConfigSprint() {
        document.getElementById('cfg-sprint-nome').value = sprintConfig.nome;
        const selCad = document.getElementById('cfg-sprint-cadencia');
        if (selCad && sprintConfig.cadencia) selCad.value = sprintConfig.cadencia;
        document.getElementById('cfg-sprint-inicio').value = sprintConfig.inicio;
        document.getElementById('cfg-sprint-fim').value = sprintConfig.fim;
        document.getElementById('cfg-sprint-meta').value = sprintConfig.meta;
        document.getElementById('modal-sprint').style.display = 'flex';
    }

    window.fecharModalSprint = function(e) {
        const m = document.getElementById('modal-sprint');
        if (m) m.style.display = 'none';
    };
    function fecharModalSprint(e) { window.fecharModalSprint(e); }
    function _antigoFecharModalSprint(e) {
        document.getElementById('modal-sprint').style.display = 'none';
    }

    function salvarConfigSprint() {
        sprintConfig.nome = document.getElementById('cfg-sprint-nome').value.trim();
        sprintConfig.inicio = document.getElementById('cfg-sprint-inicio').value;
        sprintConfig.fim = document.getElementById('cfg-sprint-fim').value;
        sprintConfig.meta = document.getElementById('cfg-sprint-meta').value.trim();
        const selCad = document.getElementById('cfg-sprint-cadencia');
        if (selCad) sprintConfig.cadencia = selCad.value;
        localStorage.setItem('sagti_sprint_cfg', JSON.stringify(sprintConfig));
        fecharModalSprint();
        atualizarDisplaySprint();
        alert('Configurações do ciclo da Sprint atualizadas com sucesso!');
    }

    // ==========================================
    // GESTÃO ÁGIL & KANBAN (BACKLOG À ESQUERDA)
    // ==========================================
    function inicializarFiltrosKanban() {
        const selBucket = document.getElementById('kanban-filtro-bucket');
        const selResp = document.getElementById('kanban-filtro-resp');
        if (!selBucket || !selResp) return;

        selBucket.innerHTML = '<option value="">(Todos os Buckets)</option>';
        const buckets = [...new Set(PROCESSOS.map(p => p.Bucket_OpenProject).filter(Boolean))].sort();
        buckets.forEach(b => {
            const opt = document.createElement('option');
            opt.value = b;
            opt.innerText = b;
            selBucket.appendChild(opt);
        });

        selResp.innerHTML = '<option value="">(Todos os Responsáveis)</option>';
        const resps = [...new Set(PROCESSOS.map(p => p.Responsavel_Tecnico).filter(Boolean))].sort();
        resps.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r;
            opt.innerText = r;
            selResp.appendChild(opt);
        });
    }

    function getColunaProcesso(p) {
        if (kanbanOverrides[p.ID_Processo]) return kanbanOverrides[p.ID_Processo];
        return 'backlog';
    }

    function renderizarKanbanAgil() {
        const colBack = document.getElementById('col-backlog');
        const colAtual = document.getElementById('col-sprint-atual');
        const colProx = document.getElementById('col-sprint-prox');
        if (!colBack || !colAtual || !colProx) return;

        const fBusca = (document.getElementById('kanban-busca') ? document.getElementById('kanban-busca').value : '').toLowerCase();
        const fBucket = document.getElementById('kanban-filtro-bucket') ? document.getElementById('kanban-filtro-bucket').value : '';
        const fResp = document.getElementById('kanban-filtro-resp') ? document.getElementById('kanban-filtro-resp').value : '';
        const fEixo = document.getElementById('kanban-filtro-eixo') ? document.getElementById('kanban-filtro-eixo').value : '';

        const lista = PROCESSOS.filter(p => {
            if (fBusca && !(p.ID_Processo || '').toLowerCase().includes(fBusca) && !(p.Especificacao || '').toLowerCase().includes(fBusca)) return false;
            if (fBucket && p.Bucket_OpenProject !== fBucket) return false;
            if (fResp && p.Responsavel_Tecnico !== fResp) return false;
            if (fEixo && p.Eixo_Gestao !== fEixo) return false;
            return true;
        });

        const badgeTotal = document.getElementById('kanban-contagem-total');
        if (badgeTotal) badgeTotal.innerText = `Exibindo ${lista.length} de ${PROCESSOS.length} processos`;

        let itensBack = [];
        let itensAtual = [];
        let itensProx = [];

        lista.forEach(p => {
            const col = getColunaProcesso(p);
            if (col === 'sprint_atual') itensAtual.push(p);
            else if (col === 'sprint_prox') itensProx.push(p);
            else itensBack.push(p);
        });

        document.getElementById('badge-sprint-backlog').innerText = `${itensBack.length} itens`;
        document.getElementById('badge-sprint-atual').innerText = `${itensAtual.length} itens`;
        document.getElementById('badge-sprint-prox').innerText = `${itensProx.length} itens`;

        colBack.innerHTML = itensBack.map(p => criarCardKanban(p, 'backlog')).join('');
        colAtual.innerHTML = itensAtual.map(p => criarCardKanban(p, 'sprint_atual')).join('');
        colProx.innerHTML = itensProx.map(p => criarCardKanban(p, 'sprint_prox')).join('');
    }

    function criarCardKanban(p, coluna) {
        const isFixado = fixados.includes(p.ID_Processo);
        const postit = cardPostits[p.ID_Processo];

        let pillFarol = 'pill-gray';
        if ((p.Farol_Criticidade || '').includes('Monitoramento')) pillFarol = 'pill-yellow';
        else if ((p.Farol_Criticidade || '').includes('Saneamento')) pillFarol = 'pill-orange';
        else if ((p.Farol_Criticidade || '').includes('Normal')) pillFarol = 'pill-green';

        let borderColor = '#64748b';
        if (coluna === 'sprint_atual') borderColor = '#10b981';
        else if (coluna === 'sprint_prox') borderColor = '#0284c7';

        let postitHtml = '';
        if (postit) {
            let corClasse = '';
            if (postit.cor === 'rosa') corClasse = 'postit-rosa';
            else if (postit.cor === 'azul') corClasse = 'postit-azul';
            else if (postit.cor === 'verde') corClasse = 'postit-verde';

            postitHtml = `
                <div class="postit-tag ${corClasse}">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <strong>📌 Post-it:</strong>
                        <button onclick="removerPostitCard('${p.ID_Processo}')" style="border:none; background:none; cursor:pointer; font-size:11px; opacity:0.7;">✖</button>
                    </div>
                    <div>${postit.texto}</div>
                </div>
            `;
        }

        return `
            <div class="kpi-card" draggable="true" ondragstart="arrastarItem(event, '${p.ID_Processo}')" style="border-left: 4px solid ${borderColor}; cursor: grab; padding: 12px 14px; margin-bottom: 2px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <strong style="font-size: 12px; color: var(--sp-blue-dark); cursor: pointer;" onclick="abrirDetalhesProcesso('${p.ID_Processo}')">${p.ID_Processo}</strong>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <button onclick="adicionarPostitCardPrompt('${p.ID_Processo}')" title="Adicionar Post-it" style="border: none; background: #fef08a; color: #854d0e; border-radius: 4px; padding: 2px 6px; font-size: 10px; cursor: pointer; font-weight: 600;">📌 Post-it</button>
                        <span style="cursor: pointer; font-size: 14px;" onclick="toggleFixado('${p.ID_Processo}')">${isFixado ? '⭐' : '☆'}</span>
                    </div>
                </div>
                <p style="font-size: 11.5px; color: #475569; margin: 4px 0; line-height: 1.4; max-height: 38px; overflow: hidden; text-overflow: ellipsis;">
                    ${p.Especificacao || p.Tipo_Processo}
                </p>
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 10.5px; color: #64748b; margin-top: 6px;">
                    <span>👤 ${p.Responsavel_Tecnico || 'Sem responsável'}</span>
                    <span class="pill-tag ${pillFarol}">${p.Faixa_Aging || 'Aging'}</span>
                </div>
                ${postitHtml}
            </div>
        `;
    }

    function resetarKanbanParaBacklog() {
        if (confirm('Deseja mover todos os 179 processos de volta para o Backlog Consolidado?')) {
            kanbanOverrides = {};
            localStorage.removeItem('sagti_kanban_status');
            renderizarKanbanAgil();
        }
    }

    function adicionarPostitCardPrompt(idProcesso) {
        const texto = prompt(`Digite a anotação do Post-it para o processo ${idProcesso}:`);
        if (!texto || !texto.trim()) return;
        
        const cor = prompt("Escolha a cor do Post-it:\n1 = 🟡 Amarelo (Lembrete Geral)\n2 = 🔴 Rosa (Impedimento / 'Porém')\n3 = 🟢 Verde (Alinhamento)\n4 = 🔵 Azul (Ação)", "1");
        let corFinal = 'amarelo';
        if (cor === '2') corFinal = 'rosa';
        else if (cor === '3') corFinal = 'verde';
        else if (cor === '4') corFinal = 'azul';

        cardPostits[idProcesso] = { texto: texto.trim(), cor: corFinal, data: new Date().toLocaleDateString() };
        localStorage.setItem('sagti_card_postits', JSON.stringify(cardPostits));
        registrarHistoricoIA(idProcesso, 'POSTIT_' + corFinal.toUpperCase(), texto.trim(), 'Luiz Seixeiro');
        renderizarKanbanAgil();
        renderizarPautaDaily();
    }

    function removerPostitCard(idProcesso) {
        delete cardPostits[idProcesso];
        localStorage.setItem('sagti_card_postits', JSON.stringify(cardPostits));
        renderizarKanbanAgil();
        renderizarPautaDaily();
    }

    // DRAG AND DROP
    let idProcessoArrastado = null;
    function arrastarItem(ev, id) { idProcessoArrastado = id; ev.dataTransfer.setData("text", id); }
    function permitirSoltar(ev) { ev.preventDefault(); }
    function soltarItem(ev, novaColuna) {
        ev.preventDefault();
        if (!idProcessoArrastado) return;
        kanbanOverrides[idProcessoArrastado] = novaColuna;
        localStorage.setItem('sagti_kanban_status', JSON.stringify(kanbanOverrides));
        idProcessoArrastado = null;
        renderizarKanbanAgil();
    }

// ==========================================
    // AUXILIARES DA NOVA ABA CHAT IA & RACI
    // ==========================================
    window.painelRaciAberto = true;
    window.alternarPainelRaci = function() {
        const p = document.getElementById('painel-raci-lateral');
        const btn = document.getElementById('btn-toggle-raci');
        if (!p) return;
        window.painelRaciAberto = !window.painelRaciAberto;
        if (window.painelRaciAberto) {
            p.style.display = 'flex';
            if (btn) btn.style.background = 'rgba(255,255,255,0.25)';
        } else {
            p.style.display = 'none';
            if (btn) btn.style.background = 'rgba(255,255,255,0.15)';
        }
    };

    window.inserirPromptRapido = function(tipo) {
        const input = document.getElementById('chat-input');
        if (!input) return;
        const prompts = {
            'minuta_etp': 'Por favor, elabore a minuta inicial de Estudo Técnico Preliminar (ETP) com base na Lei 14.133/2021 para a contratação selecionada.',
            'parecer_cj': 'Analise os apontamentos jurídicos da Consultoria Jurídica sobre a prorrogação excepcional e sugira os ajustes necessários na justificativa técnica.',
            'sumula_269': 'Realize a checagem de conformidade com a Súmula 269 do TCU, verificando se há garantia de build limpo e transferência de código no GitLab.',
            'calculo_imr': 'Simule a apuração mensal do Instrumento de Medição de Resultados (IMR), calculando eventuais faixas de glosa para SLA de disponibilidade abaixo da meta.'
        };
        input.value = prompts[tipo] || '';
        input.focus();
    };

    window.exportarHistoricoChat = function() {
        const chat = document.getElementById('chat-messages');
        if (!chat) return;
        const texto = chat.innerText;
        const blob = new Blob([texto], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Historico_Chat_SA_GTI_${new Date().toISOString().slice(0,10)}.txt`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    };

    
    // ==========================================
    // INTEGRAÇÃO OPENPROJECT 14 & FLAGS DE GOVERNANÇA
    // ==========================================
    window.sincronizarKanbanOpenProject = async function(btn) {
        const flagOP = document.getElementById('flag-conector-openproject');
        const opAtivo = flagOP ? flagOP.checked : true;
        if (!opAtivo) {
            alert('ℹ️ Conector OpenProject em modo Standalone (Desvinculado). O backlog permanece seguro na base local.');
            return;
        }

        if (btn) btn.innerText = '⏳ Sondando :8090...';
        const t0 = performance.now();
        try {
            const ctrl = new AbortController();
            const tid = setTimeout(() => ctrl.abort(), 2500);
            const r = await fetch('http://localhost:8090/api/v3', { method: 'GET', signal: ctrl.signal });
            clearTimeout(tid);
            const lat = Math.round(performance.now() - t0);
            if (btn) btn.innerText = '✅ Sincronizado com OpenProject 14';
            alert(`✅ Conectado ao OpenProject 14 (:8090 em ${lat}ms)!
500 Work Packages e status de Kanban sincronizados.`);
        } catch(e) {
            if (btn) btn.innerText = '🔵 Standalone Local Ativo';
            alert('🔵 Container OpenProject 14 (:8090) inacessível no momento.\nO painel ativou o modo Standalone resiliente com os 500 Work Packages auditados localmente.');
        } finally {
            if (btn) setTimeout(() => { btn.innerText = '🔄 Sincronizar com OpenProject 14'; }, 3000);
        }
    };

    window.registrarAtaOpenProject = function() {
        const presentes = [];
        document.querySelectorAll('.chk-daily-part:checked').forEach(c => presentes.push(c.value));
        const dataHoje = new Date().toLocaleDateString('pt-BR');
        
        alert(`✅ Ata da Daily de ${dataHoje} registrada com sucesso no módulo de Reuniões/Wiki do OpenProject 14!

• Participantes: ${presentes.join(', ')}
• Pauta: ${pautaDailyCards.length} processos ativos monitorados.`);
    };

    window.salvarFlagsConectores = function() {
        const flags = {
            ocultarChatIA: document.getElementById('flag-ocultar-chat-ia').checked,
            conectorOP: document.getElementById('flag-conector-openproject').checked,
            conectorGLPI: document.getElementById('flag-conector-glpi').checked
        };
        localStorage.setItem('sagti_flags_conectores', JSON.stringify(flags));
        window.aplicarFlagChatIA();
        alert('✅ Flags de governança salvas com sucesso!');
    };

    window.carregarFlagsConectores = function() {
        const salvas = localStorage.getItem('sagti_flags_conectores');
        if (!salvas) return;
        try {
            const f = JSON.parse(salvas);
            if (document.getElementById('flag-ocultar-chat-ia')) document.getElementById('flag-ocultar-chat-ia').checked = !!f.ocultarChatIA;
            if (document.getElementById('flag-conector-openproject')) document.getElementById('flag-conector-openproject').checked = f.conectorOP !== false;
            if (document.getElementById('flag-conector-glpi')) document.getElementById('flag-conector-glpi').checked = f.conectorGLPI !== false;
            window.aplicarFlagChatIA();
        } catch(e) {}
    };

    window.aplicarFlagChatIA = function() {
        const chk = document.getElementById('flag-ocultar-chat-ia');
        if (!chk) return;
        const ocultar = chk.checked;
        const navChat = document.querySelector('.nav-item[data-tab="esteira_ia"]');
        
        // Se ocultar estiver ativo e o perfil não for Super-Admin, esconde a aba
        if (ocultar && window.perfilAtivo !== 'Super-Admin') {
            if (navChat) navChat.style.display = 'none';
            if (window.currentTab === 'esteira_ia') window.switchTab('dashboards');
        } else {
            // Se o perfil permitir ou a flag estiver desmarcada
            if (window.permissoesAtivas && window.permissoesAtivas.includes('esteira_ia')) {
                if (navChat) navChat.style.display = 'flex';
            }
        }
    };

    
    // ==========================================
    // EXPORTAÇÃO DA ATA EM PDF & PROCESSOS DE REFERÊNCIA
    // ==========================================
    window.exportarAtaDailyPDF = function() {
        const presentes = [];
        document.querySelectorAll('.chk-daily-part:checked').forEach(c => presentes.push(c.value));
        const dataHoje = new Date().toLocaleDateString('pt-BR');
        
        let pautaHtml = '';
        pautaDailyCards.forEach(id => {
            const p = PROCESSOS.find(item => item.ID_Processo === id);
            if (p) {
                pautaHtml += '<tr>' +
                    '<td style="padding: 6px 10px; border: 1px solid #cbd5e1; font-weight: bold;">' + p.ID_Processo + '</td>' +
                    '<td style="padding: 6px 10px; border: 1px solid #cbd5e1;">' + p.Especificacao + '</td>' +
                    '<td style="padding: 6px 10px; border: 1px solid #cbd5e1;">' + (p.Responsavel_Tecnico || 'GTI') + '</td>' +
                    '<td style="padding: 6px 10px; border: 1px solid #cbd5e1;">' + p.Farol_Criticidade + '</td>' +
                '</tr>';
            }
        });

        const docHtml = '<!DOCTYPE html>' +
'<html lang="pt-BR">' +
'<head><meta charset="UTF-8"><title>Ata da Daily Scrum SA-GTI — ' + dataHoje + '</title>' +
'<style>@page { size: A4; margin: 15mm; } body { font-family: sans-serif; color: #1e293b; padding: 25px; } .header { border-bottom: 2px solid #0544cf; padding-bottom: 12px; margin-bottom: 20px; } table { width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 10px; } th { background: #f1f5f9; padding: 8px; border: 1px solid #cbd5e1; text-align: left; }</style>' +
'<\/head>' +
'<body>' +
'<div class="header">' +
'    <div style="display: flex; justify-content: space-between; align-items: center;">' +
'        <strong style="font-size: 15px; color: #002d5a;">SP-ÁGUAS — SA-GTI</strong>' +
'        <div style="text-align: right; font-size: 11px; font-weight: bold; color: #002d5a;">SUBSECRETARIA DE TECNOLOGIA DA INFORMAÇÃO</div>' +
'    </div>' +
'</div>' +
'<h1 style="color: #002d5a; font-size: 16px;">ATA OFICIAL DA DAILY SCRUM — ' + dataHoje + '</h1>' +
'<div style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 10px; font-size: 12px; margin-bottom: 15px;">' +
'    <strong>Horário:</strong> 09:30 - 09:45 (Timebox: 15 min)<br>' +
'    <strong>Participantes Presentes:</strong> ' + (presentes.join(', ') || 'Equipe SA-GTI') +
'</div>' +
'<h2>1. Pauta de Processos Tratados no Ritual</h2>' +
'<table>' +
'    <thead><tr><th>Processo SEI</th><th>Objeto / Demanda</th><th>Responsável</th><th>Farol</th></tr></thead>' +
'    <tbody>' + (pautaHtml || '<tr><td colspan="4">Pauta geral de acompanhamento.</td></tr>') + '</tbody>' +
'</table>' +
'<br><p style="text-align: center; margin-top: 30px;">____________________________________________<br><strong>LUIZ ANTONIO DA SILVA SEIXEIRO</strong><br>Gestor de Projetos e Governança de TIC (SA-GTI)</p>' +
'<\/body><\/html>';

        const w = window.open('', '_blank');
        if (w) {
            w.document.write(docHtml);
            w.document.close();
            setTimeout(() => w.print(), 300);
        } else {
            alert('Ata pronta para exportação!');
        }
    };

    window.carregarProcessoReferenciaChat = function(idProcesso) {
        const p = PROCESSOS.find(item => item.ID_Processo === idProcesso);
        if (!p) return;
        window.processoAtivoChat = p;
        const input = document.getElementById('chat-input');
        if (input) {
            input.value = 'Gostaria de usar o processo de referência ' + p.ID_Processo + ' (' + p.Especificacao + ') como padrão comparativo para instruir uma nova demanda semelhante.';
            input.focus();
        }
    };


// >>> MÓDULO: src/js/modulos/07_warroom_daily.js <<<
// =========================================================================
// MÓDULO 07: WAR ROOM (DAILY SCRUM 15 MIN), MURAL DE POST-ITS & ATA PDF
// =========================================================================

// ==========================================
    // WAR ROOM: DAILY SCRUM & PAUTA DO DIA
    // ==========================================
    function iniciarTimerDaily() {
        if (timerInterval) return;
        document.getElementById('btn-timer-start').style.display = 'none';
        document.getElementById('btn-timer-pause').style.display = 'inline-flex';
        timerInterval = setInterval(() => {
            if (timerSegundos > 0) {
                timerSegundos--;
                atualizarDisplayTimer();
            } else {
                pausarTimerDaily();
                alert('⏰ Fim do Timebox de 15 minutos da Daily Scrum da SA-GTI!');
            }
        }, 1000);
    }

    function pausarTimerDaily() {
        clearInterval(timerInterval);
        timerInterval = null;
        document.getElementById('btn-timer-start').style.display = 'inline-flex';
        document.getElementById('btn-timer-pause').style.display = 'none';
    }

    function resetarTimerDaily() {
        pausarTimerDaily();
        timerSegundos = 15 * 60;
        atualizarDisplayTimer();
    }

    function atualizarDisplayTimer() {
        const m = Math.floor(timerSegundos / 60);
        const s = timerSegundos % 60;
        const txt = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        const el = document.getElementById('timer-display');
        if (el) el.innerText = txt;
    }

    function filtrarMembroDaily(nomeMembro) {
        membroFocoDaily = nomeMembro;
        switchTab('gestao_agil');
        const selResp = document.getElementById('kanban-filtro-resp');
        if (selResp) {
            selResp.value = nomeMembro;
            renderizarKanbanAgil();
        }
    }

    function filtrarListaParaPautar() {
        const inp = document.getElementById('busca-pauta-input');
        const termo = (inp ? inp.value : '').toLowerCase();
        const container = document.getElementById('lista-candidatos-pauta');
        if (!container) return;

        const candidatos = PROCESSOS.filter(p => {
            if (pautaDailyCards.includes(p.ID_Processo)) return false;
            if (!termo) return true;
            return (p.ID_Processo || '').toLowerCase().includes(termo) || (p.Especificacao || '').toLowerCase().includes(termo);
        }).slice(0, 10);

        container.innerHTML = candidatos.map(p => `
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 4px; padding: 6px 8px; font-size: 11px; display: flex; justify-content: space-between; align-items: center;">
                <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 220px;">
                    <strong>${p.ID_Processo}</strong><br>
                    <span style="color: #64748b;">${p.Especificacao || p.Tipo_Processo}</span>
                </div>
                <button class="btn btn-primary" style="padding: 2px 6px; font-size: 10px;" onclick="puxarParaPauta('${p.ID_Processo}')">+ Pautar</button>
            </div>
        `).join('');
    }

    function puxarParaPauta(idProcesso) {
        if (!pautaDailyCards.includes(idProcesso)) {
            pautaDailyCards.push(idProcesso);
            localStorage.setItem('sagti_pauta_daily', JSON.stringify(pautaDailyCards));
            registrarHistoricoIA(idProcesso, 'DAILY_PAUTA', 'Processo incluído na Pauta da Daily Scrum para alinhamento.', 'Luiz Seixeiro');
            renderizarPautaDaily();
            filtrarListaParaPautar();
        }
    }

    function removerDaPauta(idProcesso) {
        pautaDailyCards = pautaDailyCards.filter(id => id !== idProcesso);
        localStorage.setItem('sagti_pauta_daily', JSON.stringify(pautaDailyCards));
        renderizarPautaDaily();
        filtrarListaParaPautar();
    }

    function renderizarPautaDaily() {
        const container = document.getElementById('container-pauta-cards');
        const badgeCount = document.getElementById('badge-pauta-count');
        if (!container) return;

        if (badgeCount) badgeCount.innerText = `${pautaDailyCards.length} processos pautados`;

        if (pautaDailyCards.length === 0) {
            container.innerHTML = `
                <div style="text-align: center; color: #64748b; padding: 30px; font-size: 12.5px;">
                    📋 Nenhum processo na pauta de hoje ainda.<br>
                    Utilize o seletor à esquerda para puxar processos para a pauta da Daily.
                </div>
            `;
            return;
        }

        container.innerHTML = pautaDailyCards.map(id => {
            const p = PROCESSOS.find(item => item.ID_Processo === id);
            if (!p) return '';
            const postit = cardPostits[id];
            let postitHtml = '';
            if (postit) {
                let corClasse = '';
                if (postit.cor === 'rosa') corClasse = 'postit-rosa';
                else if (postit.cor === 'azul') corClasse = 'postit-azul';
                else if (postit.cor === 'verde') corClasse = 'postit-verde';
                postitHtml = `
                    <div class="postit-tag ${corClasse}" style="margin-top: 6px;">
                        <strong>📌 Post-it da Reunião (${postit.cor.toUpperCase()}):</strong> ${postit.texto}
                        <button onclick="removerPostitCard('${id}')" style="border:none; background:none; cursor:pointer; font-size:10px; float:right;">✖</button>
                    </div>
                `;
            }

            return `
                <div class="kpi-card" style="border-left: 4px solid #0544cf; padding: 12px 16px; background: #f8fafc;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <strong style="font-size: 13px; color: var(--sp-blue-dark); cursor: pointer;" onclick="abrirDetalhesProcesso('${p.ID_Processo}')">${p.ID_Processo}</strong>
                            <span class="pill-tag pill-blue" style="margin-left: 8px;">${p.Bucket_OpenProject || 'Bucket'}</span>
                        </div>
                        <div style="display: flex; gap: 6px;">
                            <button class="btn btn-secondary" style="padding: 2px 8px; font-size: 11px;" onclick="adicionarPostitCardPrompt('${p.ID_Processo}')">📌 Post-it</button>
                            <button class="btn btn-secondary" style="padding: 2px 8px; font-size: 11px;" onclick="abrirDetalhesProcesso('${p.ID_Processo}')">Detalhes</button>
                            <button class="btn btn-secondary" style="padding: 2px 8px; font-size: 11px; color:#ef4444;" onclick="removerDaPauta('${p.ID_Processo}')">✖ Tirar da Pauta</button>
                        </div>
                    </div>
                    <p style="font-size: 12px; color: #334155; margin: 6px 0;">${p.Especificacao || p.Tipo_Processo}</p>
                    <div style="display: flex; justify-content: space-between; font-size: 11px; color: #64748b;">
                        <span>👤 <strong>Responsável:</strong> ${p.Responsavel_Tecnico || 'Não atribuído'}</span>
                        <span>⏱️ Aging: <strong>${p.Faixa_Aging}</strong> (${p.Dias_Ultima_Mov} dias)</span>
                    </div>
                    ${postitHtml}
                </div>
            `;
        }).join('');
    }

    // MURAL DE POST-ITS LIVRES
    function adicionarPostitMural(cor) {
        const texto = prompt(`Novo Post-it para a Daily (${cor.toUpperCase()}):`);
        if (!texto || !texto.trim()) return;

        const autor = prompt("Nome do Responsável / Autor:", "Luiz Seixeiro") || "SA-GTI";
        muralPostits.push({
            id: Date.now(),
            texto: texto.trim(),
            cor: cor,
            autor: autor,
            hora: new Date().toLocaleTimeString().slice(0, 5)
        });
        localStorage.setItem('sagti_mural_postits', JSON.stringify(muralPostits));
        renderizarMuralPostits();
    }

    function removerPostitMural(id) {
        muralPostits = muralPostits.filter(p => p.id !== id);
        localStorage.setItem('sagti_mural_postits', JSON.stringify(muralPostits));
        renderizarMuralPostits();
    }

    function renderizarMuralPostits() {
        const mural = document.getElementById('mural-postits');
        if (!mural) return;

        if (muralPostits.length === 0) {
            mural.innerHTML = `
                <div style="grid-column: 1 / -1; text-align: center; color: #a16207; padding: 25px; font-size: 12.5px;">
                    📝 Mural limpo. Use os botões acima para fixar post-its gerais de lembretes, impedimentos ou acordos da Daily.
                </div>
            `;
            return;
        }

        mural.innerHTML = muralPostits.map(p => {
            let bg = '#fef08a';
            let txt = '#713f12';
            let border = '#facc15';

            if (p.cor === 'rosa') { bg = '#fce7f3'; txt = '#831843'; border = '#f472b6'; }
            else if (p.cor === 'verde') { bg = '#dcfce7'; txt = '#14532d'; border = '#4ade80'; }
            else if (p.cor === 'azul') { bg = '#e0f2fe'; txt = '#0c4a6e'; border = '#38bdf8'; }

            return `
                <div class="postit-free-card" style="background: ${bg}; color: ${txt}; border: 1px solid ${border};">
                    <div>
                        <div style="display: flex; justify-content: space-between; font-size: 10.5px; opacity: 0.8; margin-bottom: 6px;">
                            <span>👤 ${p.autor}</span>
                            <span>⏱️ ${p.hora}</span>
                        </div>
                        <div style="font-size: 12px; font-weight: 500; line-height: 1.4;">
                            ${p.texto}
                        </div>
                    </div>
                    <div style="display: flex; justify-content: flex-end; margin-top: 10px;">
                        <button onclick="removerPostitMural(${p.id})" style="border:none; background:none; color:${txt}; font-size:11px; cursor:pointer; opacity:0.75; font-weight:bold;">Remover ✖</button>
                    </div>
                </div>
            `;
        }).join('');
    }

    function copiarAtaDaily() {
        let resumo = `📋 RESUMO DA DAILY SCRUM — SA-GTI (SP-ÁGUAS)
Data: ${new Date().toLocaleDateString()} | Horário: ${new Date().toLocaleTimeString().slice(0, 5)}
`;
        resumo += `Facilitador: Luiz Seixeiro
----------------------------------------
`;
        resumo += `📌 PROCESSOS PAUTADOS NA DAILY (${pautaDailyCards.length} itens):
`;
        pautaDailyCards.forEach((id, idx) => {
            const p = PROCESSOS.find(item => item.ID_Processo === id);
            const postit = cardPostits[id];
            resumo += `${idx + 1}. ${id} - ${p ? p.Especificacao : ''}
`;
            if (postit) resumo += `   └── [Post-it: ${postit.cor.toUpperCase()}]: ${postit.texto}
`;
        });
        resumo += `----------------------------------------
`;
        resumo += `📌 TÓPICOS GERAIS DO MURAL (${muralPostits.length} notas):
`;
        muralPostits.forEach((p, idx) => {
            resumo += `${idx + 1}. [${p.cor.toUpperCase()}] ${p.texto} (Resp: ${p.autor})
`;
        });

        navigator.clipboard.writeText(resumo).then(() => {
            alert('Ata e tópicos da Daily copiados para a área de transferência! Pode colar no SEI, Teams ou WhatsApp.');
        });
    }


// >>> MÓDULO: src/js/modulos/08_consulta_filtros_csv.js <<<
// =========================================================================
// MÓDULO 08: CONSULTA MULTICRITÉRIO DO ACERVO SEI (9 FILTROS) & TABELAS
// =========================================================================

// ==========================================
    // TABELAS ESTRATÉGICAS
    // ==========================================
    function renderizarTabelasEstrategicas() {
        const saneamento = PROCESSOS.filter(p => (p.Farol_Criticidade || '').includes('Saneamento'));
        const tbSaneamento = document.getElementById('tbody-saneamento');
        if (tbSaneamento) {
            tbSaneamento.innerHTML = saneamento.map((p, idx) => `
                <tr>
                    <td>${idx + 1}</td>
                    <td>
    <div style="display: flex; align-items: center; gap: 6px;">
        <a href="javascript:void(0)" onclick="abrirDetalhesProcesso('${p.ID_Processo}')" style="font-weight: 700; color: #0284c7; text-decoration: none;" title="Abrir Dossie 360° no Cockpit">${p.ID_Processo}</a>
        <button type="button" class="btn btn-secondary" onclick="navigator.clipboard.writeText('${p.ID_Processo}'); alert('Numero ${p.ID_Processo} copiado!');" style="padding: 1px 5px; font-size: 10px;" title="Copiar numero do processo">📋</button>
        <a href="https://sei.sp.gov.br" target="_blank" style="font-size: 11px; text-decoration: none;" title="Abrir portal do SEI-SP">↗️</a>
    </div>
</td>
                    <td>${p.Bucket_OpenProject}</td>
                    <td>${p.Responsavel_Tecnico || '<span style="color:#94a3b8">Não atribuído</span>'}</td>
                    <td><span class="pill-tag pill-red">${p.Dias_Ultima_Mov} dias</span></td>
                    <td style="max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${p.Especificacao}</td>
                    <td style="text-align: center;">
                        <button class="btn btn-secondary" style="padding: 3px 8px; font-size: 11px;" onclick="abrirDetalhesProcesso('${p.ID_Processo}')">Ver</button>
                    </td>
                </tr>
            `).join('');
        }

        const monitoramento = PROCESSOS.filter(p => (p.Farol_Criticidade || '').includes('Monitoramento'));
        const tbMonitor = document.getElementById('tbody-monitoramento');
        if (tbMonitor) {
            tbMonitor.innerHTML = monitoramento.map((p, idx) => `
                <tr>
                    <td>${idx + 1}</td>
                    <td>
    <div style="display: flex; align-items: center; gap: 6px;">
        <a href="javascript:void(0)" onclick="abrirDetalhesProcesso('${p.ID_Processo}')" style="font-weight: 700; color: #0284c7; text-decoration: none;" title="Abrir Dossie 360° no Cockpit">${p.ID_Processo}</a>
        <button type="button" class="btn btn-secondary" onclick="navigator.clipboard.writeText('${p.ID_Processo}'); alert('Numero ${p.ID_Processo} copiado!');" style="padding: 1px 5px; font-size: 10px;" title="Copiar numero do processo">📋</button>
        <a href="https://sei.sp.gov.br" target="_blank" style="font-size: 11px; text-decoration: none;" title="Abrir portal do SEI-SP">↗️</a>
    </div>
</td>
                    <td>${p.Bucket_OpenProject}</td>
                    <td>${p.Responsavel_Tecnico || '<span style="color:#94a3b8">Não atribuído</span>'}</td>
                    <td><span class="pill-tag pill-yellow">${p.Faixa_Aging}</span></td>
                    <td style="max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${p.Especificacao}</td>
                    <td style="text-align: center;">
                        <button class="btn btn-secondary" style="padding: 3px 8px; font-size: 11px;" onclick="abrirDetalhesProcesso('${p.ID_Processo}')">Ver</button>
                    </td>
                </tr>
            `).join('');
        }

        const normal = PROCESSOS.filter(p => (p.Farol_Criticidade || '').includes('Fluxo Normal'));
        const tbNormal = document.getElementById('tbody-normal');
        if (tbNormal) {
            tbNormal.innerHTML = normal.map((p, idx) => `
                <tr>
                    <td>${idx + 1}</td>
                    <td>
    <div style="display: flex; align-items: center; gap: 6px;">
        <a href="javascript:void(0)" onclick="abrirDetalhesProcesso('${p.ID_Processo}')" style="font-weight: 700; color: #0284c7; text-decoration: none;" title="Abrir Dossie 360° no Cockpit">${p.ID_Processo}</a>
        <button type="button" class="btn btn-secondary" onclick="navigator.clipboard.writeText('${p.ID_Processo}'); alert('Numero ${p.ID_Processo} copiado!');" style="padding: 1px 5px; font-size: 10px;" title="Copiar numero do processo">📋</button>
        <a href="https://sei.sp.gov.br" target="_blank" style="font-size: 11px; text-decoration: none;" title="Abrir portal do SEI-SP">↗️</a>
    </div>
</td>
                    <td>${p.Bucket_OpenProject}</td>
                    <td>${p.Responsavel_Tecnico || '<span style="color:#94a3b8">Não atribuído</span>'}</td>
                    <td><span class="pill-tag pill-green">${p.Dias_Ultima_Mov} dias</span></td>
                    <td style="max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${p.Especificacao}</td>
                    <td style="text-align: center;">
                        <button class="btn btn-secondary" style="padding: 3px 8px; font-size: 11px;" onclick="abrirDetalhesProcesso('${p.ID_Processo}')">Ver</button>
                    </td>
                </tr>
            `).join('');
        }
    }

    // ==========================================
    // FILTROS DA CONSULTA (9 DROPDOWNS)
    // ==========================================
    function inicializarFiltrosDropdown() {
        preencherSelectUnico('filtro-bucket', 'Bucket_OpenProject');
        preencherSelectUnico('filtro-resp', 'Responsavel_Tecnico');
        preencherSelectUnico('filtro-farol', 'Farol_Criticidade');
        preencherSelectUnico('filtro-aging', 'Faixa_Aging');
        preencherSelectUnico('filtro-risco', 'Classificacao_Risco');
        preencherSelectUnico('filtro-tipo', 'Tipo_Processo');
        preencherSelectUnico('filtro-marcadores', 'Marcadores_Institucionais');
    }

    function preencherSelectUnico(selectId, campo) {
        const sel = document.getElementById(selectId);
        if (!sel) return;
        const valores = [...new Set(PROCESSOS.map(p => p[campo]).filter(Boolean))].sort();
        valores.forEach(v => {
            const opt = document.createElement('option');
            opt.value = v;
            opt.innerText = v;
            sel.appendChild(opt);
        });
    }

    function aplicarFiltrosConsulta() {
        const fId = (document.getElementById('filtro-id').value || '').toLowerCase();
        const fBucket = document.getElementById('filtro-bucket').value;
        const fResp = document.getElementById('filtro-resp').value;
        const fFarol = document.getElementById('filtro-farol').value;
        const fAging = document.getElementById('filtro-aging').value;
        const fRisco = document.getElementById('filtro-risco').value;
        const fTipo = document.getElementById('filtro-tipo').value;
        const fEspec = (document.getElementById('filtro-espec').value || '').toLowerCase();
        const fMarc = document.getElementById('filtro-marcadores').value;
        const elEixo = document.getElementById('filtro-eixo');
        const fEixo = elEixo ? elEixo.value : '';

        processosFiltrados = PROCESSOS.filter(p => {
            if (fId && !(p.ID_Processo || '').toLowerCase().includes(fId)) return false;
            if (fBucket && p.Bucket_OpenProject !== fBucket) return false;
            if (fResp && p.Responsavel_Tecnico !== fResp) return false;
            if (fEixo && p.Eixo_Gestao !== fEixo) return false;
            if (fFarol && p.Farol_Criticidade !== fFarol) return false;
            if (fAging && p.Faixa_Aging !== fAging) return false;
            if (fRisco && p.Classificacao_Risco !== fRisco) return false;
            if (fTipo && p.Tipo_Processo !== fTipo) return false;
            if (fEspec && !(p.Especificacao || '').toLowerCase().includes(fEspec)) return false;
            if (fMarc && p.Marcadores_Institucionais !== fMarc) return false;
            return true;
        });

        paginaAtual = 1;
        renderizarTabelaConsulta();
    }

    function limparFiltrosConsulta() {
        document.getElementById('filtro-id').value = '';
        document.getElementById('filtro-bucket').value = '';
        document.getElementById('filtro-resp').value = '';
        document.getElementById('filtro-farol').value = '';
        document.getElementById('filtro-aging').value = '';
        document.getElementById('filtro-risco').value = '';
        document.getElementById('filtro-tipo').value = '';
        document.getElementById('filtro-espec').value = '';
        document.getElementById('filtro-marcadores').value = '';
        aplicarFiltrosConsulta();
    }

    function renderizarTabelaConsulta() {
        const tbody = document.getElementById('tbody-consulta');
        if (!tbody) return;

        const total = processosFiltrados.length;
        document.getElementById('consulta-status-txt').innerText = `Exibindo ${total} de ${PROCESSOS.length} processos`;
        document.getElementById('consulta-total-badge').innerText = `${total} PROCESSOS`;

        const totalPaginas = Math.ceil(total / tamanhoPagina) || 1;
        if (paginaAtual > totalPaginas) paginaAtual = totalPaginas;

        const inicio = (paginaAtual - 1) * tamanhoPagina;
        const fim = Math.min(inicio + tamanhoPagina, total);
        const paginaItens = processosFiltrados.slice(inicio, fim);

        document.getElementById('pag-info').innerText = `Página ${paginaAtual} de ${totalPaginas} (${inicio + 1}-${fim} de ${total})`;

        tbody.innerHTML = paginaItens.map(p => {
            const isFixado = fixados.includes(p.ID_Processo);
            let pillFarol = 'pill-gray';
            if ((p.Farol_Criticidade || '').includes('Monitoramento')) pillFarol = 'pill-yellow';
            else if ((p.Farol_Criticidade || '').includes('Saneamento')) pillFarol = 'pill-orange';
            else if ((p.Farol_Criticidade || '').includes('Normal')) pillFarol = 'pill-green';

            let pillAging = 'pill-gray';
            if (p.Faixa_Aging === 'Crítico') pillAging = 'pill-red';
            else if (p.Faixa_Aging === 'Atenção') pillAging = 'pill-orange';
            else if (p.Faixa_Aging === 'Alerta') pillAging = 'pill-yellow';
            else if (p.Faixa_Aging === 'Normal') pillAging = 'pill-green';

            return `
                <tr>
                    <td style="text-align: center; cursor: pointer;" onclick="toggleFixado('${p.ID_Processo}')">
                        ${isFixado ? '⭐' : '☆'}
                    </td>
                    <td>
    <div style="display: flex; align-items: center; gap: 6px;">
        <a href="javascript:void(0)" onclick="abrirDetalhesProcesso('${p.ID_Processo}')" style="font-weight: 700; color: #0284c7; text-decoration: none;" title="Abrir Dossie 360° no Cockpit">${p.ID_Processo}</a>
        <button type="button" class="btn btn-secondary" onclick="navigator.clipboard.writeText('${p.ID_Processo}'); alert('Numero ${p.ID_Processo} copiado!');" style="padding: 1px 5px; font-size: 10px;" title="Copiar numero do processo">📋</button>
        <a href="https://sei.sp.gov.br" target="_blank" style="font-size: 11px; text-decoration: none;" title="Abrir portal do SEI-SP">↗️</a>
    </div>
</td>
                    <td><span class="pill-tag ${pillFarol}">${p.Farol_Criticidade || '-'}</span></td>
                    <td>${p.Bucket_OpenProject || '-'}</td>
                    <td>${p.Responsavel_Tecnico || '<span style="color:#94a3b8">Não atribuído</span>'}</td>
                    <td><span class="pill-tag ${pillAging}">${p.Faixa_Aging || '-'}</span></td>
                    <td>${p.Classificacao_Risco || '-'}</td>
                    <td style="max-width: 280px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${p.Especificacao || '-'}</td>
                    <td style="text-align: center;">
                        <button class="btn btn-secondary" style="padding: 3px 8px; font-size: 11px;" onclick="abrirDetalhesProcesso('${p.ID_Processo}')">Detalhes</button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    function mudarTamanhoPagina(val) { tamanhoPagina = parseInt(val, 10); paginaAtual = 1; renderizarTabelaConsulta(); }
    function paginaAnterior() { if (paginaAtual > 1) { paginaAtual--; renderizarTabelaConsulta(); } }
    function proximaPagina() {
        const totalPaginas = Math.ceil(processosFiltrados.length / tamanhoPagina);
        if (paginaAtual < totalPaginas) { paginaAtual++; renderizarTabelaConsulta(); }
    }

    // ==========================================
    // EXPORTAÇÃO CSV
    // ==========================================
    function exportarCSVConsulta() { gerarDownloadCSV(processosFiltrados, 'Backlog_Consolidado_SAGTI.csv'); }
    function exportarCSVFiltro(tipo) {
        let lista = [];
        if (tipo === 'saneamento') lista = PROCESSOS.filter(p => (p.Farol_Criticidade || '').includes('Saneamento'));
        else if (tipo === 'monitoramento') lista = PROCESSOS.filter(p => (p.Farol_Criticidade || '').includes('Monitoramento'));
        else if (tipo === 'normal') lista = PROCESSOS.filter(p => (p.Farol_Criticidade || '').includes('Fluxo Normal'));
        gerarDownloadCSV(lista, `Processos_${tipo}_SAGTI.csv`);
    }

    function gerarDownloadCSV(lista, nomeArquivo) {
        if (!lista.length) return alert('Nenhum dado para exportar.');
        const colunas = Object.keys(lista[0]);
        let csv = colunas.join(';') + '\r\n';
        lista.forEach(item => {
            csv += colunas.map(c => `"${(item[c] || '').toString().replace(/"/g, '""')}"`).join(';') + '\r\n';
        });
        const blob = new Blob(["﻿" + csv], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = nomeArquivo;
        link.click();
    }


