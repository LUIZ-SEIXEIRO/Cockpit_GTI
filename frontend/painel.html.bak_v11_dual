    window.abrirModalNovoCaderno = function() {
        document.getElementById('caderno-edit-id').value = '';
        document.getElementById('caderno-input-titulo').value = '';
        document.getElementById('caderno-input-desc').value = '';
        document.getElementById('caderno-input-conteudo').value = '';
        document.getElementById('modal-caderno-titulo').innerText = '➕ Novo Caderno Temático';
        const m = document.getElementById('modal-caderno-crud');
        if (m) m.style.display = 'flex';
    };

    window.editarCadernoAtual = function() {
        const c = window.cadernos.find(item => item.id === window.cadernoSelecionadoId);
        if (!c) return;

        document.getElementById('caderno-edit-id').value = c.id;
        document.getElementById('caderno-input-titulo').value = c.titulo;
        document.getElementById('caderno-input-icone').value = c.icone || '📘';
        document.getElementById('caderno-input-desc').value = c.desc || '';
        document.getElementById('caderno-input-conteudo').value = c.conteudo;
        document.getElementById('modal-caderno-titulo').innerText = '✏️ Editar Caderno Temático';
        const m = document.getElementById('modal-caderno-crud');
        if (m) m.style.display = 'flex';
    };

    window.fecharModalCaderno = function() {
        const m = document.getElementById('modal-caderno-crud');
        if (m) m.style.display = 'none';
    };

    window.salvarCaderno = function() {
        const idExistente = document.getElementById('caderno-edit-id').value;
        const titulo = document.getElementById('caderno-input-titulo').value.trim();
        const icone = document.getElementById('caderno-input-icone').value;
        const desc = document.getElementById('caderno-input-desc').value.trim();
        const conteudo = document.getElementById('caderno-input-conteudo').value.trim();

        if (!titulo || !conteudo) {
            alert('Por favor, preencha o título e o conteúdo do caderno.');
            return;
        }

        if (idExistente) {
            const idx = window.cadernos.findIndex(item => item.id === idExistente);
            if (idx !== -1) {
                window.cadernos[idx] = { ...window.cadernos[idx], titulo, icone, desc, conteudo };
            }
        } else {
            const novoId = 'cad_' + Date.now();
            window.cadernos.push({
                id: novoId,
                titulo,
                icone,
                categoria: "Diretriz Local SA-GTI",
                desc,
                conteudo
            });
            window.cadernoSelecionadoId = novoId;
        }

        localStorage.setItem('sagti_cadernos_v4', JSON.stringify(window.cadernos));
        window.fecharModalCaderno();
        window.carregarCadernos();

        if (typeof definirEstadoMascote === 'function') {
            definirEstadoMascote('success', 'Caderno temático salvo na base de conhecimento!');
            setTimeout(() => definirEstadoMascote('idle', 'Vigilante'), 2500);
        }
    };

    window.excluirCadernoAtual = function() {
        if (!confirm('Deseja realmente excluir este caderno temático da base de conhecimento da SA-GTI?')) return;
        window.cadernos = window.cadernos.filter(item => item.id !== window.cadernoSelecionadoId);
        localStorage.setItem('sagti_cadernos_v4', JSON.stringify(window.cadernos));
        window.cadernoSelecionadoId = window.cadernos.length > 0 ? window.cadernos[0].id : null;
        window.carregarCadernos();
    };

    window.imprimirRelatorioAuditoria = function() {
        window.print();
    };

window.baixarCadernoAtivo = function() {
        const c = (window.cadernos && window.cadernos.find(item => item.id === window.cadernoSelecionadoId)) || (window.cadernos && window.cadernos[0]);
        if (!c) return;
        const blob = new Blob([c.conteudo], { type: 'text/markdown;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${c.id}_${c.titulo.replace(/[^a-zA-Z0-9_-]/g, '_')}.md`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    };

    window.baixarTodosCadernosConsolidados = function() {
        if (!window.cadernos || window.cadernos.length === 0) return;
        let dossie = `# DOSSIÊ CANÔNICO DE GOVERNANÇA, NORMAS E PROCESSOS DE TIC\n`;
        dossie += `**Órgão:** Agência de Águas do Estado de São Paulo — SP-Águas\n`;
        dossie += `**Unidade Gestora:** Subsecretaria de Tecnologia da Informação (SA-GTI)\n`;
        dossie += `**Data de Consolidação:** ${new Date().toLocaleDateString('pt-BR')}\n\n---\n\n`;
        
        window.cadernos.forEach((c, idx) => {
            dossie += `\n\n<!-- ========================================================== -->\n`;
            dossie += `## [PARTE ${idx+1}] ${c.titulo}\n\n`;
            dossie += `${c.conteudo}\n\n---\n`;
        });
        
        const blob = new Blob([dossie], { type: 'text/markdown;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Dossie_Oficial_15_Cadernos_SPAGUAS_SA-GTI.md`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    };

    window.toggleRevelarTokenOpenProject = function() {
        const inp = document.getElementById('cfg-endpoint-op-token');
        if (inp) inp.type = (inp.type === 'password') ? 'text' : 'password';
    };

    window.salvarTokenOpenProject = function() {
        const inp = document.getElementById('cfg-endpoint-op-token');
        if (inp) {
            localStorage.setItem('sagti_openproject_token', inp.value);
            if (typeof mostrarNotificacao === 'function') {
                mostrarNotificacao('Token Salvo', 'API Token do OpenProject salvo com blindagem departamental (sa-gti)!', 'success');
            } else {
                alert('Token do OpenProject salvo com sucesso!');
            }
        }
    };

window.visualizarToolkit = function(id) {
        const tk = window.TOOLKITS_DADOS[id];
        if (!tk) {
            alert('Toolkit não localizado: ' + id);
            return;
        }
        window.toolkitAtivoId = id;
        const modal = document.getElementById('modal-modelo-branco');
        const titulo = document.getElementById('modal-modelo-titulo');
        const corpo = document.getElementById('modal-modelo-corpo');
        const btnBaixar = document.getElementById('btn-modal-baixar-modelo');

        if (modal && titulo && corpo) {
            titulo.innerHTML = `<span>🛠️ ${tk.titulo}</span>`;
            corpo.innerHTML = tk.conteudoHtml;
            if (btnBaixar) {
                btnBaixar.innerHTML = "⬇️ Baixar Toolkit Oficial";
                btnBaixar.onclick = function() { window.baixarToolkit(id); };
            }
            modal.style.display = 'flex';
        }
    };

    window.baixarToolkit = function(id) {
        const tk = window.TOOLKITS_DADOS[id];
        if (!tk) {
            alert('Toolkit não localizado: ' + id);
            return;
        }
        if (tk.tipo === 'csv') {
            const blob = new Blob(["\uFEFF" + tk.conteudoCsv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = tk.arquivo;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        } else {
            // Documento: dispara o diálogo para salvar como PDF no formato padrão A4
            const printWindow = window.open('', '_blank', 'width=900,height=800');
            if (printWindow) {
                printWindow.document.open();
                printWindow.document.write(`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>${tk.titulo}</title><style>@page{size:A4 portrait;margin:15mm;} body{font-family:Arial,sans-serif;margin:0;padding:20px;}</style><\/head><body>${tk.conteudoHtml}<\/body><\/html>`);
                printWindow.document.close();
                printWindow.focus();
                setTimeout(() => { printWindow.print(); }, 500);
            } else {
                alert('Por favor, permita popups neste site para abrir o diálogo de impressão em PDF (A4).');
            }
        }
    };


// >>> MÓDULO: src/js/modulos/10_pool_3_ias_isoladas.js <<<
// =========================================================================
// MÓDULO 10: POOL ADMINISTRATIVO DAS 3 IAs ISOLADAS (NEW API :3001 & OLLAMA)
// =========================================================================

const promptsOriginais = window.inserirPromptRapido;
    window.inserirPromptRapido = function(tipo) {
        const input = document.getElementById('chat-input');
        if (!input) return;
        const promptsDict = {
            'fluxo_pregao': 'Demonstre detalhadamente as etapas canônicas dos dois fluxos oficiais do Governo de SP (Pregão Eletrônico Ordinário e Pregão SRP) com base no portal compras.sp.gov.br e destaque a linha divisória de publicação no PNCP e a aplicação da Regra dos Poréns.',
            'minuta_dfd': 'Por favor, elabore a minuta de Documento de Formalização de Demanda (DFD) com justificativa técnica, alinhamento ao PDTIC 2027-2030 e estimativa preliminar para este processo.',
            'minuta_etp': 'Por favor, elabore a minuta inicial de Estudo Técnico Preliminar (ETP) com base na Lei 14.133/2021 para a contratação selecionada.',
            'aging_porens': 'Analise a permanência deste processo no SEI, segregando a custódia interna da SA-GTI das suspensões externas (Poréns da Consultoria Jurídica e Fornecedores) para cálculo do Aging Líquido.',
            'sumula_269': 'Realize a checagem de conformidade com a Súmula 269 do TCU, verificando se há garantia de build limpo, transferência de código e proibição de pagamento por homem-hora sem produto.',
            'roteiro_daily': 'Estruture a pauta de 15 minutos para a Daily Scrum da SA-GTI, elencando os impedimentos críticos, entregas do dia e alinhamento dos responsáveis.',
            'tripla_validacao': 'Elabore a minuta de Parecer Técnico Conclusivo no padrão regimental em 3 níveis (GTI, DIF, DGD) com matriz de Tripla Validação regimental da SP-Águas.'
        };

        if (promptsDict[tipo]) {
            input.value = promptsDict[tipo];
            input.focus();
            if (window.atualizarModelosCorrelatos) window.atualizarModelosCorrelatos(input.value);
        } else if (typeof promptsOriginais === 'function') {
            promptsOriginais(tipo);
        }
    };

window.STORAGE_KEY_POOL_3_IAS = 'sagti_pool_tres_ias_v94';
    window.agenteForcadoChat = 'auto';

    window.obterPoolPadraoTresIas = function() {
        var keyPadrao = window.CHAVE_PADRAO_VALIDA_NEWAPI || 'sk-CmqHIGhOuIW1lnPO0MTnLbzeoFERorWpvELyAhgvgp0ynRpn';
        var urlPadrao = localStorage.getItem('newapi_base_url') || 'http://localhost:3001/v1';
        return {
            autoFailover: true,
            modoValidacaoLeve: true,
            ias: {
                principal: {
                    id: 'principal',
                    nome: 'IA 1 — Principal (Redação & Análise)',
                    endpoint: urlPadrao,
                    apiKey: keyPadrao,
                    agent: 'qwen2.5-coder:1.5b',
                    maxTokens: 300,
                    timeoutMs: 8000,
                    ultimoStatus: 'CONFIGURADA',
                    ultimoDetalhe: 'Isolada com SLM leve (qwen2.5-coder:1.5b)'
                },
                orquestracao: {
                    id: 'orquestracao',
                    nome: 'IA 2 — Orquestração (RAG & Fact-Checker)',
                    endpoint: urlPadrao,
                    apiKey: keyPadrao,
                    agent: 'llama3.2:1b',
                    maxTokens: 200,
                    timeoutMs: 6000,
                    ultimoStatus: 'CONFIGURADA',
                    ultimoDetalhe: 'Isolada com trava Anti-OOM (llama3.2:1b | num_ctx: 2048)'
                },
                microservicos: {
                    id: 'microservicos',
                    nome: 'IA 3 — Microsserviços (Triagem & Automação)',
                    endpoint: urlPadrao,
                    apiKey: keyPadrao,
                    agent: 'qwen2.5:0.5b',
                    maxTokens: 160,
                    timeoutMs: 4500,
                    ultimoStatus: 'ATIVA',
                    ultimoDetalhe: 'Ativa e operando como âncora leve de validação'
                }
            }
        };
    };

    window.carregarPoolTresIas = function() {
        var padrao = window.obterPoolPadraoTresIas();
        try {
            var salvo = JSON.parse(localStorage.getItem(window.STORAGE_KEY_POOL_3_IAS) || 'null');
            if (salvo && salvo.ias && salvo.ias.principal && salvo.ias.orquestracao && salvo.ias.microservicos) {
                window.POOL_TRES_IAS = salvo;
            } else {
                window.POOL_TRES_IAS = padrao;
                localStorage.setItem(window.STORAGE_KEY_POOL_3_IAS, JSON.stringify(padrao));
            }
        } catch (e) {
            window.POOL_TRES_IAS = padrao;
        }
        window.sincronizarInputsPoolTresIas();
        return window.POOL_TRES_IAS;
    };

    window.mascararKeyCurta = function(k) {
        var s = String(k || '').trim();
        if (s.length <= 12) return s || 'sem-chave';
        return s.slice(0, 7) + '...' + s.slice(-4);
    };

    window.sincronizarInputsPoolTresIas = function() {
        var pool = window.POOL_TRES_IAS || window.obterPoolPadraoTresIas();
        var mapIds = [
            { slot: 'principal', pre: 'cfg-ia1', chatMod: 'chat-lbl-mod-principal', chatSt: 'chat-st-principal' },
            { slot: 'orquestracao', pre: 'cfg-ia2', chatMod: 'chat-lbl-mod-orquestracao', chatSt: 'chat-st-orquestracao' },
            { slot: 'microservicos', pre: 'cfg-ia3', chatMod: 'chat-lbl-mod-microservicos', chatSt: 'chat-st-microservicos' }
        ];
        var chkFail = document.getElementById('cfg-pool-autofailover');
        if (chkFail) chkFail.checked = pool.autoFailover !== false;

        mapIds.forEach(function(m) {
            var cfg = (pool.ias && pool.ias[m.slot]) ? pool.ias[m.slot] : {};
            var elEp = document.getElementById(m.pre + '-endpoint');
            var elKey = document.getElementById(m.pre + '-apikey');
            var elAg = document.getElementById(m.pre + '-agent');
            var elPre = document.getElementById(m.pre + '-preset');
            var elMax = document.getElementById(m.pre + '-maxtokens');
            var elTmo = document.getElementById(m.pre + '-timeout');

            if (elEp && cfg.endpoint) elEp.value = cfg.endpoint;
            if (elKey && cfg.apiKey) elKey.value = cfg.apiKey;
            if (elAg && cfg.agent) elAg.value = cfg.agent;
            if (elPre && cfg.agent) {
                var opts = Array.prototype.slice.call(elPre.options).map(function(o) { return o.value; });
                elPre.value = opts.indexOf(cfg.agent) !== -1 ? cfg.agent : '';
            }
            if (elMax && cfg.maxTokens) elMax.value = cfg.maxTokens;
            if (elTmo && cfg.timeoutMs) elTmo.value = cfg.timeoutMs;

            var elChatMod = document.getElementById(m.chatMod);
            if (elChatMod) elChatMod.innerText = cfg.agent || 'local';
            var elChatSt = document.getElementById(m.chatSt);
            if (elChatSt) elChatSt.title = 'API Key: ' + window.mascararKeyCurta(cfg.apiKey) + ' | Endpoint: ' + (cfg.endpoint || '');
        });

        var lblKeyResumo = document.getElementById('lbl-key-ativa-newapi');
        if (lblKeyResumo && pool.ias) {
            lblKeyResumo.innerText = 'K1:' + window.mascararKeyCurta(pool.ias.principal.apiKey) +
                ' | K2:' + window.mascararKeyCurta(pool.ias.orquestracao.apiKey) +
                ' | K3:' + window.mascararKeyCurta(pool.ias.microservicos.apiKey);
        }
    };

    window.toggleVisibilidadeInput = function(inputId) {
        var inp = document.getElementById(inputId);
        if (!inp) return;
        inp.type = (inp.type === 'password') ? 'text' : 'password';
    };

    window.abrirConfiguracaoTresIas = function() {
        if (typeof window.switchTab === 'function') window.switchTab('configuracoes');
        if (typeof window.alternarSubConfig === 'function') window.alternarSubConfig('agentes');
        var card = document.getElementById('card-admin-pool-3-ias');
        if (card && card.scrollIntoView) card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    window.selecionarAgenteForcadoChat = function(valor) {
        window.agenteForcadoChat = valor || 'auto';
        var b = document.getElementById('badge-modo-pool-chat');
        if (b) {
            var nomes = { 'auto': 'Auto + Failover', 'microservicos': 'Forçado: IA 3', 'orquestracao': 'Forçado: IA 2', 'principal': 'Forçado: IA 1' };
            b.innerText = nomes[window.agenteForcadoChat] || '3 Keys Isoladas';
        }
    };

    window.salvarPoolTresIas = async function(silencioso) {
        var pool = window.POOL_TRES_IAS || window.obterPoolPadraoTresIas();
        var chkFail = document.getElementById('cfg-pool-autofailover');
        pool.autoFailover = chkFail ? Boolean(chkFail.checked) : true;

        var mapIds = [
            { slot: 'principal', pre: 'cfg-ia1' },
            { slot: 'orquestracao', pre: 'cfg-ia2' },
            { slot: 'microservicos', pre: 'cfg-ia3' }
        ];

        mapIds.forEach(function(m) {
            var cfg = pool.ias[m.slot] || {};
            var elEp = document.getElementById(m.pre + '-endpoint');
            var elKey = document.getElementById(m.pre + '-apikey');
            var elAg = document.getElementById(m.pre + '-agent');
            var elMax = document.getElementById(m.pre + '-maxtokens');
            var elTmo = document.getElementById(m.pre + '-timeout');

            if (elEp) cfg.endpoint = elEp.value.trim() || 'http://localhost:3001/v1';
            if (elKey) cfg.apiKey = elKey.value.trim() || window.CHAVE_PADRAO_VALIDA_NEWAPI;
            if (elAg) cfg.agent = elAg.value.trim() || 'qwen2.5:0.5b';
            if (elMax) cfg.maxTokens = parseInt(elMax.value, 10) || 200;
            if (elTmo) cfg.timeoutMs = parseInt(elTmo.value, 10) || 6000;
            pool.ias[m.slot] = cfg;
        });

        window.POOL_TRES_IAS = pool;
        try {
            localStorage.setItem(window.STORAGE_KEY_POOL_3_IAS, JSON.stringify(pool));
            // Manter compatibilidade com a chave geral caso usada por rotinas antigas
            localStorage.setItem('newapi_token', pool.ias.microservicos.apiKey || pool.ias.principal.apiKey);
            localStorage.setItem('newapi_model', pool.ias.microservicos.agent || pool.ias.principal.agent);
        } catch (e) {}

        window.sincronizarInputsPoolTresIas();

        // Sincronizar também com o Backend FastAPI (:8000/api/v1/ia/pool) se estiver online
        try {
            var ctrl = new AbortController();
            var tid = setTimeout(function() { ctrl.abort(); }, 1500);
            await fetch('http://localhost:8000/api/v1/ia/pool', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(pool),
                signal: ctrl.signal
            });
            clearTimeout(tid);
        } catch (e) {}

        if (!silencioso) {
            var diag3 = document.getElementById('diag-ia-microservicos');
            if (diag3) {
                diag3.innerHTML = '&#9989; <strong>Configura&ccedil;&atilde;o das 3 IAs salva com sucesso!</strong> As chamadas usar&atilde;o as chaves e modelos individuais.';
            }
        }
        return pool;
    };

    window.aplicarPresetValidacaoLocalLeve = function() {
        var pool = window.POOL_TRES_IAS || window.obterPoolPadraoTresIas();
        pool.modoValidacaoLeve = true;
        pool.autoFailover = true;
        pool.ias.principal.agent = 'qwen2.5-coder:1.5b';
        pool.ias.principal.maxTokens = 260;
        pool.ias.orquestracao.agent = 'llama3.2:1b';
        pool.ias.orquestracao.maxTokens = 180;
        pool.ias.microservicos.agent = 'qwen2.5:0.5b';
        pool.ias.microservicos.maxTokens = 140;
        window.POOL_TRES_IAS = pool;
        window.sincronizarInputsPoolTresIas();
        window.salvarPoolTresIas(true);

        ['principal', 'orquestracao', 'microservicos'].forEach(function(slot) {
            var elDiag = document.getElementById('diag-ia-' + slot);
            if (elDiag) {
                elDiag.innerHTML = '&#129718; <strong>Preset Local Leve aplicado:</strong> Agente <code>' + window.escapeHtml(pool.ias[slot].agent) + '</code> configurado (Baixa RAM / Zero Cr&eacute;dito).';
            }
        });
    };

    window.aplicarPresetUnificarNaMicroservicos = function() {
        var pool = window.POOL_TRES_IAS || window.obterPoolPadraoTresIas();
        var elKey3 = document.getElementById('cfg-ia3-apikey');
        var elAg3 = document.getElementById('cfg-ia3-agent');
        var elEp3 = document.getElementById('cfg-ia3-endpoint');

        var keyAtiva = (elKey3 && elKey3.value.trim()) ? elKey3.value.trim() : pool.ias.microservicos.apiKey;
        var agAtivo = (elAg3 && elAg3.value.trim()) ? elAg3.value.trim() : pool.ias.microservicos.agent;
        var epAtivo = (elEp3 && elEp3.value.trim()) ? elEp3.value.trim() : pool.ias.microservicos.endpoint;

        ['principal', 'orquestracao', 'microservicos'].forEach(function(slot) {
            pool.ias[slot].apiKey = keyAtiva;
            pool.ias[slot].agent = agAtivo;
            pool.ias[slot].endpoint = epAtivo;
        });
        window.POOL_TRES_IAS = pool;
        window.sincronizarInputsPoolTresIas();
        window.salvarPoolTresIas(true);

        ['principal', 'orquestracao', 'microservicos'].forEach(function(slot) {
            var elDiag = document.getElementById('diag-ia-' + slot);
            if (elDiag) {
                elDiag.innerHTML = '&#9889; <strong>Sincronizado com a IA 3 (Microsservi&ccedil;os):</strong> Usando Agente <code>' + window.escapeHtml(agAtivo) + '</code> para valida&ccedil;&atilde;o imediata.';
            }
        });
    };

    window.testarIaIsoladaIndividual = async function(slot, btn) {
        await window.salvarPoolTresIas(true);
        var pool = window.POOL_TRES_IAS || window.obterPoolPadraoTresIas();
        var cfg = pool.ias[slot];
        if (!cfg) return null;

        var origTxt = btn ? btn.innerHTML : '';
        if (btn) btn.innerHTML = '&#1416; Testando ' + cfg.agent + '...';
        var badge = document.getElementById('badge-status-ia-' + slot);
        var diag = document.getElementById('diag-ia-' + slot);
        var chatSt = document.getElementById('chat-st-' + slot);

        var t0 = performance.now();
        var urlChat = (cfg.endpoint || 'http://localhost:3001/v1').replace(/\/$/, '') + '/chat/completions';

        try {
            var ctrl = new AbortController();
            var tid = setTimeout(function() { ctrl.abort(); }, cfg.timeoutMs || 6000);
            var r = await fetch(urlChat, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + cfg.apiKey
                },
                body: JSON.stringify({
                    model: cfg.agent,
                    temperature: 0.0,
                    top_p: 0.1,
                    seed: 42,
                    max_tokens: 16,
                    options: { num_ctx: 2048 },
                    messages: [
                        { role: 'system', content: 'Responda apenas OK.' },
                        { role: 'user', content: 'Ping de validacao SA-GTI' }
                    ]
                }),
                signal: ctrl.signal
            });
            clearTimeout(tid);
            var lat = Math.round(performance.now() - t0);

            if (r.ok) {
                var j = await r.json();
                var respTxt = (j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content) || 'OK';
                if (badge) {
                    badge.style.background = '#dcfce7';
                    badge.style.color = '#166534';
                    badge.innerHTML = '&#128994; ONLINE (' + lat + 'ms)';
                }
                if (chatSt) {
                    chatSt.style.background = '#dcfce7';
                    chatSt.style.color = '#166534';
                    chatSt.innerText = 'Online (' + lat + 'ms)';
                }
                if (diag) {
                    diag.innerHTML = '&#9989; <strong>Conex&atilde;o Isolada Homologada (' + lat + 'ms):</strong> Agente <code>' + window.escapeHtml(cfg.agent) + '</code> respondeu com Key <code>' + window.escapeHtml(window.mascararKeyCurta(cfg.apiKey)) + '</code>.';
                }
                if (btn) {
                    btn.innerHTML = '&#9989; Online (' + lat + 'ms)';
                    setTimeout(function() { btn.innerHTML = origTxt; }, 2200);
                }
                return { ok: true, slot: slot, latencia: lat, agent: cfg.agent, resposta: respTxt };
            } else {
                var errBody = '';
                try { errBody = await r.text(); } catch (e) {}
                var errLow = errBody.toLowerCase();
                var motivoDiag = 'HTTP ' + r.status;
                if (r.status === 402 || r.status === 429 || errLow.indexOf('quota') !== -1 || errLow.indexOf('credit') !== -1 || errLow.indexOf('balance') !== -1 || errLow.indexOf('insufficient') !== -1) {
                    motivoDiag = 'Falta de Cr&eacute;dito / Quota Excedida (HTTP ' + r.status + ')';
                } else if (r.status === 500 || r.status === 502 || r.status === 503 || errLow.indexOf('memory') !== -1 || errLow.indexOf('oom') !== -1 || errLow.indexOf('alloc') !== -1) {
                    motivoDiag = 'Queda por Falta de Mem&oacute;ria RAM/VRAM (HTTP ' + r.status + ')';
                } else if (r.status === 401 || r.status === 403) {
                    motivoDiag = 'API Key Inv&aacute;lida ou Sem Permiss&atilde;o para o Agente (HTTP ' + r.status + ')';
                }

                if (badge) {
                    badge.style.background = '#fee2e2';
                    badge.style.color = '#991b1b';
                    badge.innerHTML = '&#128308; ERRO HTTP ' + r.status;
                }
                if (chatSt) {
                    chatSt.style.background = '#fee2e2';
                    chatSt.style.color = '#991b1b';
                    chatSt.innerText = 'HTTP ' + r.status;
                }
                if (diag) {
                    diag.innerHTML = '&#9888;&#65039; <strong>Diagn&oacute;stico Isolado:</strong> ' + motivoDiag + ' no agente <code>' + window.escapeHtml(cfg.agent) + '</code>. Failover autom&aacute;tico ativo!';
                }
                if (btn) {
                    btn.innerHTML = '&#9888;&#65039; HTTP ' + r.status;
                    setTimeout(function() { btn.innerHTML = origTxt; }, 2200);
                }
                return { ok: false, slot: slot, status: r.status, motivo: motivoDiag };
            }
        } catch (err) {
            var latErr = Math.round(performance.now() - t0);
            if (badge) {
                badge.style.background = '#dbeafe';
                badge.style.color = '#1e40af';
                badge.innerHTML = '&#128309; MODO LOCAL / FAILOVER';
            }
            if (chatSt) {
                chatSt.style.background = '#dbeafe';
                chatSt.style.color = '#1e40af';
                chatSt.innerText = 'Local / C1-C4';
            }
            if (diag) {
                diag.innerHTML = '&#128309; <strong>Motor 4 Camadas &amp; Configura&ccedil;&atilde;o New API (:3001) Ativos (' + latErr + 'ms):</strong> Configura&ccedil;&atilde;o de <code>' + window.escapeHtml(cfg.agent) + '</code> e Key <code>' + window.escapeHtml(window.mascararKeyCurta(cfg.apiKey)) + '</code> salva e pronta para a New API!';
            }
            if (btn) {
                btn.innerHTML = '&#128309; Salvo (Local)';
                setTimeout(function() { btn.innerHTML = origTxt; }, 2200);
            }
            return { ok: false, slot: slot, status: 0, motivo: 'Motor 4 Camadas Ativo' };
        }
    };

    window.testarPoolTresIasIsoladas = async function(btn) {
        var orig = btn ? btn.innerHTML : '';
        if (btn) btn.innerHTML = '&#1416; Testando 3 IAs...';
        var r1 = await window.testarIaIsoladaIndividual('principal', null);
        var r2 = await window.testarIaIsoladaIndividual('orquestracao', null);
        var r3 = await window.testarIaIsoladaIndividual('microservicos', null);

        var onlineCnt = [r1, r2, r3].filter(function(r) { return r && r.ok; }).length;
        var topoBadge = document.getElementById('badge-status-newapi-topo');
        if (topoBadge) {
            if (onlineCnt > 0) {
                topoBadge.innerHTML = '&#128994; Pool 3 IAs Ativo (' + onlineCnt + '/3 Online na New API :3001) &bull; Failover &amp; Lock [temp:0.0]';
            } else {
                topoBadge.innerHTML = '&#128309; Pool 3 IAs Configurado (Chaves Isoladas Salvas) &bull; Motor 4 Camadas Ativo';
            }
        }
        if (btn) {
            btn.innerHTML = onlineCnt > 0 ? ('&#9989; ' + onlineCnt + '/3 Online') : '&#128309; 3 Keys Prontas';
            setTimeout(function() { btn.innerHTML = orig; }, 2400);
        }
        return [r1, r2, r3];
    };

    // Seleciona qual das 3 IAs deve atender com base no tipo de consulta (ou no seletor forçado)
    window.escolherSlotIaParaConsulta = function(pergunta) {
        if (window.agenteForcadoChat && window.agenteForcadoChat !== 'auto') {
            return window.agenteForcadoChat;
        }
        var q = String(pergunta || '').toLowerCase();
        // 1. Redação e consultoria técnica sobre artefatos (DFD, ETP, TR, parecer, IMR, TCO, Súmula 269) -> IA 1 (Principal)
        if (/\b(?:minuta|dfd|etp|tr|imr|tco|parecer|redigir|elaborar|cl[aá]usula|glosa)\b|termo de refer|s[uú]mula 269/i.test(q)) {
            return 'principal';
        }
        // 2. Saudações rápidas, comandos Kanban, post-it e triagem curta -> IA 3 (Microsserviços)
        if (window.ehSaudacaoOuConversaCurta && window.ehSaudacaoOuConversaCurta(q)) {
            return 'microservicos';
        }
        if (q.length < 32 || /(?:criar|mover|post-it|postit|lembrete|fila|ticket\s*#?\d+)/i.test(q)) {
            return 'microservicos';
        }
        // 3. Cruzamento de bases (OpenProject, GLPI, SEI, PDTIC, KPIs, auditoria) -> IA 2 (Orquestração)
        return 'orquestracao';
    };

    // Sobrescrever chamarNewApiClosedWorld para executar chamadas isoladas por IA com Auto-Failover para a IA 3 (Microsserviços)
    window.chamarNewApiClosedWorld = async function(pergunta, ctx) {
        if (ctx && ctx.preFiltro && ctx.preFiltro.bloqueioInexistente) {
            return {
                texto: null,
                statusGuardrail: '🛑 Bloqueado na Camada 1 (Pré-Filtro: Entidade Inexistente)'
            };
        }

        var pool = window.POOL_TRES_IAS || window.carregarPoolTresIas();
        var slotPrimario = window.escolherSlotIaParaConsulta(pergunta);

        // Ordem de tentativa: Slot Primário -> se falhar e autoFailover estiver ativo, tenta Microsserviços (IA 3) -> Orquestração (IA 2) -> Principal (IA 1)
        var ordemTentativa = [slotPrimario];
        if (pool.autoFailover !== false) {
            ['microservicos', 'orquestracao', 'principal'].forEach(function(s) {
                if (ordemTentativa.indexOf(s) === -1) ordemTentativa.push(s);
            });
        }

        var promptInfo = window.construirPromptClosedWorld(pergunta, ctx);

        for (var i = 0; i < ordemTentativa.length; i++) {
            var slotAtual = ordemTentativa[i];
            var cfg = pool.ias[slotAtual];
            if (!cfg || !cfg.apiKey || !cfg.agent) continue;

            var urlChat = (cfg.endpoint || 'http://localhost:3001/v1').replace(/\/$/, '') + '/chat/completions';
            try {
                var ctrl = new AbortController();
                var tid = setTimeout(function() { ctrl.abort(); }, cfg.timeoutMs || 6000);
                var r = await fetch(urlChat, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + cfg.apiKey
                    },
                    body: JSON.stringify({
                        model: cfg.agent,
                        temperature: 0.0,
                        top_p: 0.1,
                        seed: 42,
                        max_tokens: cfg.maxTokens || 200,
                        options: { num_ctx: 2048 },
                        messages: [
                            { role: 'system', content: promptInfo.systemPrompt },
                            { role: 'user', content: pergunta }
                        ]
                    }),
                    signal: ctrl.signal
                });
                clearTimeout(tid);

                if (r.ok) {
                    var j = await r.json();
                    var txtLlm = (j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content) || '';
                    if (txtLlm) {
                        var check = window.validarFidelidadeRespostaLLM(txtLlm);
                        window.modeloDetectadoNewApi = cfg.agent + ' [' + cfg.nome.split('—')[0].trim() + ']';
                        if (check.valido) {
                            var tagFailover = (i > 0) ? (' | 🔄 Failover de ' + slotPrimario.toUpperCase() + ' -> ' + slotAtual.toUpperCase()) : '';
                            return {
                                texto: txtLlm,
                                tokensPrompt: promptInfo.tokensEstimados,
                                slotUsado: slotAtual,
                                agenteUsado: cfg.agent,
                                statusGuardrail: '✅ ' + cfg.nome.split('(')[0].trim() + ' (' + cfg.agent + tagFailover + ' | ' + promptInfo.tokensEstimados + ' tok | Lock temp:0.0)'
                            };
                        } else {
                            return {
                                texto: null,
                                tokensPrompt: promptInfo.tokensEstimados,
                                statusGuardrail: '🛡️ Camada 4 (Fact-Checker) Bloqueou Desvio de ' + cfg.agent + ' (' + check.motivo + ')'
                            };
                        }
                    }
                }
            } catch (e) {
                // Passa automaticamente para a próxima IA do pool (ex.: IA 3 Microsserviços)
            }
        }
        return null;
    };

    // Inicializar o Pool das 3 IAs assim que o script carregar
    setTimeout(function() {
        window.carregarPoolTresIas();
    }, 60);


