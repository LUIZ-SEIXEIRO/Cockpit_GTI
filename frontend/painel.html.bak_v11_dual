            <label style="font-weight: 700; font-size: 11px; color: #475569; display: block; margin-bottom: 4px;">Selecione o Processo Suspenso:</label>
            <select id="cp-proc-select" onchange="atualizarMinutaCheckpoint()" style="width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12px; margin-bottom: 14px;">
                <option value="137.00010608/2025-63">137.00010608/2025-63 — Links de Internet (Aguardando Parecer CJ)</option>
                <option value="137.00000119/2026-84">137.00000119/2026-84 — SAM Estoque e Patrimônio (Cotação de Bacia Pendente)</option>
