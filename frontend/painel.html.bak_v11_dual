    function abrirSeletorArquivosEsteira() {
        const fileInput = document.getElementById('file-input-esteira');
        if (fileInput) {
            fileInput.value = ""; // Limpa para permitir selecionar o mesmo arquivo se quiser
            fileInput.click();    // Abre o Windows Explorer nativo
        }
    }

    function arquivoSelecionadoEsteira(event) {
        const files = event.target.files;
        if (!files || files.length === 0) return;

        for (let i = 0; i < files.length; i++) {
            const f = files[i];
            // Evita duplicar o mesmo nome
            if (!arquivosAnexados.some(a => a.name === f.name)) {
                arquivosAnexados.push(f);
            }
        }

        renderizarAnexosChips();

        if (typeof definirEstadoMascote === 'function') {
            definirEstadoMascote('thinking', `Carregando ${files.length} arquivo(s)...`);
            setTimeout(() => {
                definirEstadoMascote('success', 'Artefatos carregados para benchmarking!');
                setTimeout(() => definirEstadoMascote('idle', 'Vigilante'), 2500);
            }, 1200);
        }
    }

    function renderizarAnexosChips() {
        const container = document.getElementById('anexos-preview-container');
        const list = document.getElementById('anexos-chips-list');
        if (!container || !list) return;

        if (arquivosAnexados.length === 0) {
            container.style.display = 'none';
            list.innerHTML = '';
            return;
        }

        container.style.display = 'flex';
        list.innerHTML = arquivosAnexados.map((f, idx) => {
            const sizeKb = (f.size / 1024).toFixed(1);
            return `
                <div style="display: inline-flex; align-items: center; gap: 6px; background: #ffffff; border: 1px solid #cbd5e1; padding: 3px 8px; border-radius: 12px; font-size: 11px; color: #0f172a; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
                    <span>📄 <strong>${f.name}</strong> <span style="color:#64748b; font-size:10px;">(${sizeKb} KB)</span></span>
                    <button type="button" onclick="removerArquivoAnexo(${idx})" style="background: none; border: none; color: #ef4444; font-weight: bold; cursor: pointer; padding: 0 2px; font-size: 13px; line-height: 1;" title="Excluir arquivo">✕</button>
                </div>
            `;
        }).join('');
    }

    function removerArquivoAnexo(idx) {
        if (idx >= 0 && idx < arquivosAnexados.length) {
            const removido = arquivosAnexados.splice(idx, 1)[0];
            renderizarAnexosChips();
            if (typeof definirEstadoMascote === 'function') {
                definirEstadoMascote('warning', `Arquivo removido: ${removido.name}`);
                setTimeout(() => definirEstadoMascote('idle', 'Vigilante'), 2000);
            }
        }
    }

    function reiniciarChatEsteira() { window.historicoMensagensChat = [];
        if (!confirm("Deseja realmente reiniciar a interação e limpar todo o histórico do chat?")) return;

        const chat = document.getElementById('chat-messages');
        const input = document.getElementById('chat-input');
        if (input) input.value = '';

        arquivosAnexados = [];
        renderizarAnexosChips();

        if (chat) {
            chat.innerHTML = `
                <div style="display: flex; gap: 12px; max-width: 88%; align-self: flex-start;">
                    <div style="width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, #002d5a 0%, #0544cf 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 15px; flex-shrink: 0;">🤖</div>
                    <div style="background: #ffffff; padding: 14px 18px; border-radius: 4px 14px 14px 14px; border: 1px solid #e2e8f0; font-size: 13px; color: #1e293b; box-shadow: 0 2px 6px rgba(0,0,0,0.04); line-height: 1.65;">
