# 2026-10-28 15:42:06.302476
+Aplique o codigo: crie a funcao testar_conexao_mariadb() no database_mariadb.py usando as credenciais do .env, e atualize o endpoint /api/v1/healthcheck no main.py retornando status online, status do mariadb e versao 1.0.0import os
+from dotenv import load_dotenv
+import mysql.connector
+
+# Carrega variáveis do arquivo .env
+load_dotenv()
+
+DB_USER = os.getenv('DB_USER', 'glpi')
+DB_PASSWORD = os.getenv('DB_PASSWORD', 'glpi')
+DB_NAME = os.getenv('DB_NAME', 'glpidb')
+DB_HOST = os.getenv('DB_HOST', 'localhost')
+DB_PORT = int(os.getenv('DB_PORT', 3306))
+
+def testar_conexao_mariadb() -> bool:
+    """Testa a conexão com o MariaDB e retorna True se bem-sucedido."""
+    try:
+        cnx = mysql.connector.connect(
+            user=DB_USER,
+            password=DB_PASSWORD,
+            host=DB_HOST,
+            port=DB_PORT,
+            database=DB_NAME,
+            connection_timeout=3
+        )
+        if cnx.is_connected():
+            cnx.close()
+            return True
+        return False
+    except Exception as err:
+        print(f"Erro na conexão com MariaDB: {err}")
+        return False

# 2026-10-28 15:42:24.516592
+import os
+from datetime import datetime
+from flask import Flask, jsonify
+from database_mariadb import testar_conexao_mariadb
+
+app = Flask(__name__)
+
+@app.route('/api/v1/healthcheck', methods=['GET'])
+def healthcheck():
+    db_conectado = testar_conexao_mariadb()
+    return jsonify({
+        "status": "online",
+        "mariadb": "connected" if db_conectado else "disconnected",
+        "timestamp": datetime.now().isoformat(),
+        "versao": "1.0.0"
+    })
+
+if __name__ == '__main__':
+    print("Iniciando Cockpit GTI em http://localhost:5000")
+    app.run(host="0.0.0.0", port=5000, debug=True)

