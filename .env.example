# Copie para .env (ignorado pelo git) e defina valores locais. Nunca versione o .env.
# Em bancos MariaDB ja inicializados, estas credenciais NAO mudam os usuarios existentes.
DB_ROOT_PASSWORD=
DB_NAME=
DB_USER=
DB_PASSWORD=

# GLPI oficial (producao): SOMENTE LEITURA. O Compose passa apenas estas 3 variaveis ao backend.
# Guarde valores reais somente no .env local; pessoas com acesso ao Docker podem inspecionar env vars.
GLPI_PROD_BASE_URL=
GLPI_PROD_APP_TOKEN=
GLPI_PROD_USER_TOKEN=

# GLPI local: destino das gravacoes do Cockpit (instancia sera adicionada em sprint posterior).
# Credenciais devem ser diferentes das de producao.
GLPI_LOCAL_BASE_URL=http://glpi-local/apirest.php
GLPI_LOCAL_APP_TOKEN=
GLPI_LOCAL_USER_TOKEN=
