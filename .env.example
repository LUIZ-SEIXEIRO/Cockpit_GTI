# ==========================================
# COCKPIT GTI 360° - VARIAVEIS DE AMBIENTE
# ==========================================
API_TOKEN=gerar_token_forte_aqui
COCKPIT_SESSION_SECRET=gere_uma_chave_de_sessao_independente_e_aleatoria
# Use true atrás de HTTPS; false somente no Docker local via HTTP.
COCKPIT_SESSION_COOKIE_SECURE=false
VERIFY_SSL=true

# OpenProject
OPENPROJECT_URL=https://openproject.spaguas.sp.gov.br
OPENPROJECT_API_KEY=sua_chave_openproject_aqui

# GLPI
GLPI_URL=https://glpi.spaguas.sp.gov.br
GLPI_APP_TOKEN=seu_app_token_aqui
GLPI_USER_TOKEN=seu_user_token_aqui

# New API / Ollama
NEW_API_KEY=sua_chave_new_api_aqui
NEW_API_URL=http://new-api:3000/v1
OLLAMA_URL=http://ollama:11434

# Credenciais da API Oficial SEI-SP (Portal de APIs Prodesp / IDP.SP)
# Preencha no arquivo .env local (nunca commite valores reais)
SEI_API_TOKEN_URL=https://idp.sp.gov.br/auth/realms/idpsp/protocol/openid-connect/token
SEI_API_BASE_URL=https://sei-processos.api.rota.sp.gov.br
SEI_API_CLIENT_ID=
SEI_API_CLIENT_SECRET=
SEI_API_SIGLA_SISTEMA=
SEI_API_IDENTIFICACAO_SERVICO=
SEI_ID_UNIDADE=110050725

