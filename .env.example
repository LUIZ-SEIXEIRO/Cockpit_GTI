# Copie para .env (ignorado pelo git) e defina valores locais. Nunca versione o .env.
# Em bancos MariaDB ja inicializados, estas credenciais NAO mudam os usuarios existentes.
DB_ROOT_PASSWORD=
DB_NAME=
DB_USER=
DB_PASSWORD=

# GLPI oficial (producao): SOMENTE LEITURA. Use tokens de um usuario GLPI com perfil somente leitura.
GLPI_PROD_BASE_URL=
GLPI_PROD_APP_TOKEN=
GLPI_PROD_USER_TOKEN=

# Banco do GLPI local (servico glpi-db, isolado do banco do Cockpit). Defina valores proprios e distintos de DB_*.
# Aplicados apenas na primeira inicializacao do volume glpi_local_db.
GLPI_LOCAL_DB_ROOT_PASSWORD=
GLPI_LOCAL_DB_NAME=
GLPI_LOCAL_DB_USER=
GLPI_LOCAL_DB_PASSWORD=

# GLPI local: destino das gravacoes do Cockpit (servico glpi-local, http://localhost:8088).
# As APIs REST/tokens locais so existem apos a configuracao inicial; nenhuma gravacao esta habilitada na Sprint 2.
# Credenciais devem ser diferentes das de producao.
GLPI_LOCAL_BASE_URL=http://glpi-local/apirest.php
GLPI_LOCAL_APP_TOKEN=
GLPI_LOCAL_USER_TOKEN=
